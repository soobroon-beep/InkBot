        <div><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:7px"><div class="lbl" style="margin-bottom:0">Hashtags (30)</div><button class="copybtn" id="copy-hash">Copiar</button></div><div class="hout" id="hash-out"></div></div>
