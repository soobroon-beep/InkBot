      <div class="d-lbl">Foto del símbolo</div>
      <div class="d-photo-upz">
        <input type="file" id="d-photo-input" accept="image/*">
        <img id="d-photo-prev" style="display:none;max-height:70px;max-width:100%;object-fit:contain;margin:0 auto 4px">
        <p id="d-photo-txt">↑ Sube imagen del tatuaje</p>
      </div>
    </div>

    <!-- HANDLE -->
    <div class="d-sb">
      <div class="d-lbl">Handle de Instagram</div>
      <input type="text" class="d-inp-d" id="d-handle" value="V.SOBRONTT ❘ INKBOT">
    </div>

    <!-- GENERAR -->
    <div class="d-sb" style="display:flex;flex-direction:column;gap:7px;padding-bottom:40px">
      <button class="d-btn-gen-d" id="d-btn-gen">⚡ GENERAR CARD</button>
      <div class="d-st-d" id="d-st"></div>
      <button class="d-btn-regen-d" id="d-btn-regen">↺ Regenerar</button>
    </div>
  </div>

  <!-- MAIN: preview -->
  <div class="d-main">
    <div class="d-sf" id="d-sf">
      <canvas class="d-cbg" id="d-cv"></canvas>
      <svg class="d-svg-dec" id="d-svg" viewBox="0 0 270 480" xmlns="http://www.w3.org/2000/svg"></svg>
      <div class="d-ov">
        <div class="d-photo-area" id="d-photo-drop">
          <input type="file" id="d-card-photo-input" accept="image/*">
          <img class="d-photo-img" id="d-card-photo-img">
          <div class="d-photo-placeholder" id="d-photo-placeholder">
            <div class="d-kanji" id="d-kanji-ph">彫</div>
            <div class="d-uplabel">Toca para subir foto</div>
          </div>
          <div class="d-photo-hover-lbl">📷 Cambiar foto</div>
        </div>
        <div class="d-content">
          <div class="d-tag-row"><div class="d-dot-gold"></div><div class="d-eyebrow" id="d-eyebrow" style="color:rgba(200,134,10,.3)">DICCIONARIO VISUAL</div></div>
          <div class="d-divline"></div>
          <div class="d-symbol-name" id="d-name" style="color:rgba(240,235,227,.2)">Genera tu primera<br><span class="d-acc">card</span></div>
          <div class="d-symbol-jp" id="d-namejp" style="display:none"></div>
          <div class="d-glass"><div class="d-body-txt" id="d-body" style="color:rgba(240,235,227,.2)">Elige un símbolo y presiona Generar.</div></div>
          <div class="d-divline2"></div>
          <div class="d-footer-row">
            <div class="d-handle-txt" id="d-handle-display">@V.SOBRONTT</div>
            <div class="d-badge-jp">彫物辞典</div>
          </div>
        </div>
      </div>
      <div class="d-loader" id="d-loader">
        <div class="d-spin"></div>
        <p style="font-family:'Space Mono',monospace;font-size:9px;letter-spacing:3px;color:#555;text-transform:uppercase">Generando...</p>
      </div>
    </div>
    <div class="d-dl-area" id="d-dl-area">
      <div class="d-fb-bar">
        <span class="d-fb-label">¿Te gustó?</span>
        <button class="d-btn-like" id="d-btn-like">👍 Me gustó</button>
        <button class="d-btn-dislike" id="d-btn-dislike">👎 Repetida</button>
      </div>
      <div class="d-fb-msg" id="d-fb-msg"></div>
      <div style="display:flex;gap:6px">
        <button class="d-btn-dl" id="d-btn-dl-png">↓ PNG</button>
        <button class="d-btn-dl-gold" id="d-btn-dl-gold">↓ HD PNG</button>
      </div>
      <div style="display:flex;gap:6px">
        <button class="d-btn-dl" id="d-btn-dl-mp4" style="flex:1;border-color:#E8720C;color:#E8720C">▶ VIDEO 15s</button>
      </div>
    </div>
  </div>
</div>

