<!DOCTYPE html>

<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>INKBOT PRO</title>
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="INKBOT">
<meta name="theme-color" content="#CC0000">
<link rel="apple-touch-icon" sizes="192x192" href="icon-192.png">
<link rel="apple-touch-icon" sizes="512x512" href="icon-512.png">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link rel="manifest" href="manifest.webmanifest">
<script>
// Registro del Service Worker real (requiere servir por HTTPS o localhost)
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('sw.js', { scope: './' })
      .catch(function (err) { console.warn('SW no registrado:', err); });
  });
}
</script>

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Serif+JP:wght@900&family=Space+Mono&family=DM+Sans:wght@300;400;500&family=Cinzel:wght@400;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--red:#CC0000;--gold:#E8720C;--bg:#060606;--surf:#0d0d0d;--surf2:#131313;--b1:#1c1c1c;--b2:#252525;--txt:#f0ebe3;--mut:#505050;--mut2:#777}
body{background:var(--bg);color:var(--txt);font-family:'DM Sans',sans-serif;height:100vh;display:flex;flex-direction:column;overflow:hidden}
.topbar{height:50px;background:var(--surf);border-bottom:1px solid var(--b1);display:flex;align-items:center;padding:0 16px;gap:10px;flex-shrink:0}
.logo-box{width:28px;height:28px;background:var(--red);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:14px;color:#fff}
.logo-txt{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:4px}
.logo-sub{font-size:8px;color:var(--gold);font-family:'Space Mono',monospace;letter-spacing:2px}
.tabs{display:flex;margin-left:16px;overflow-x:auto}
.tab{height:50px;padding:0 12px;background:transparent;border:none;border-bottom:2px solid transparent;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--mut);cursor:pointer;white-space:nowrap;transition:all .2s}
.tab:hover{color:var(--mut2)}.tab.active{color:var(--txt);border-bottom-color:var(--red)}
.api-area{margin-left:auto;display:flex;gap:8px;align-items:center;flex-shrink:0}
.api-sel{background:var(--surf2);border:1px solid var(--b2);color:var(--txt);padding:6px 8px;font-family:'Space Mono',monospace;font-size:10px;outline:none;cursor:pointer}
.api-inp{background:var(--surf2);border:1px solid var(--b2);color:var(--txt);padding:6px 10px;font-family:'Space Mono',monospace;font-size:11px;width:190px;outline:none}
.api-inp:focus,.api-sel:focus{border-color:var(--red)}
.api-inp::placeholder{color:var(--mut)}
.body{display:flex;flex:1;overflow:hidden;position:relative}
.sidebar{width:260px;min-width:260px;max-width:260px;background:var(--surf);border-right:1px solid var(--b1);overflow-y:scroll;overflow-x:hidden;display:flex;flex-direction:column;flex-shrink:0;position:fixed;top:0;bottom:0;left:0;scroll-behavior:smooth;z-index:10}
.sidebar::-webkit-scrollbar{width:5px}.sidebar::-webkit-scrollbar-thumb{background:#333;border-radius:3px}.sidebar::-webkit-scrollbar-track{background:var(--surf)}
.sb{padding:12px;border-bottom:1px solid var(--b1);width:100%;overflow:hidden}
.lbl{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--mut);margin-bottom:7px;font-family:'Space Mono',monospace}
.pills{display:flex;flex-wrap:wrap;gap:4px}
.pill{padding:4px 8px;border:1px solid var(--b2);font-size:10px;cursor:pointer;color:var(--mut2);font-family:'Space Mono',monospace;background:transparent;transition:all .15s}
.pill.on{border-color:var(--red);color:var(--red);background:rgba(204,0,0,.07)}
.pill:hover:not(.on){border-color:#333;color:var(--txt)}
.inp{width:100%;padding:8px 10px;border:1px solid var(--b2);background:var(--surf2);color:var(--txt);font-size:12px;outline:none;font-family:'DM Sans',sans-serif}
.inp:focus{border-color:var(--red)}
textarea.inp{resize:vertical;min-height:60px;line-height:1.5}
.upz{border:1px dashed var(--b2);padding:11px;text-align:center;cursor:pointer;position:relative;background:var(--surf2);transition:border-color .2s}
.upz:hover{border-color:var(--red)}.upz input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.upz p{font-size:10px;color:var(--mut);letter-spacing:1px;text-transform:uppercase}
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:3px;margin-top:6px}
.pt{aspect-ratio:9/16;background:var(--surf2);border:1px solid var(--b1);overflow:hidden;cursor:pointer;position:relative}
.pt img{width:100%;height:100%;object-fit:cover;opacity:.6;transition:opacity .2s}
.pt:hover img,.pt.on img{opacity:1}.pt.on{border-color:var(--red)}
.pt-x{position:absolute;top:2px;right:2px;width:13px;height:13px;background:rgba(0,0,0,.85);color:var(--red);font-size:8px;display:none;align-items:center;justify-content:center;cursor:pointer;border:1px solid var(--red);z-index:2}
.pt:hover .pt-x{display:flex}
.btn-red{width:100%;max-width:100%;padding:11px;background:var(--red);color:#fff;border:none;font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:3px;cursor:pointer;transition:opacity .2s;box-sizing:border-box}
.btn-red:hover{opacity:.85}.btn-red:disabled{opacity:.35;cursor:not-allowed}
.btn-ghost{width:100%;padding:8px;background:transparent;color:var(--mut2);border:1px solid var(--b2);font-family:'Space Mono',monospace;font-size:10px;cursor:pointer;transition:all .2s;text-transform:uppercase}
.btn-ghost:hover{border-color:var(--red);color:var(--red)}.btn-ghost:disabled{opacity:.3;cursor:not-allowed}
.btn-gold{padding:8px 14px;background:transparent;color:var(--gold);border:1px solid var(--gold);font-family:'Space Mono',monospace;font-size:10px;cursor:pointer;transition:all .2s;text-transform:uppercase}
.btn-gold:hover{background:var(--gold);color:#000}.btn-gold:disabled{opacity:.3;cursor:not-allowed}
.copybtn{padding:6px 11px;background:transparent;color:var(--gold);border:1px solid var(--gold);font-size:10px;cursor:pointer;font-family:'Space Mono',monospace;transition:all .2s;text-transform:uppercase}
.copybtn:hover{background:var(--gold);color:#000}.copybtn.ok{background:#1a5c3a;border-color:#1a5c3a;color:#fff}
.st{font-size:10px;color:var(--mut);font-family:'Space Mono',monospace;text-align:center;min-height:14px;padding:3px 0}
.st.ok{color:#1D9E75}.st.err{color:var(--red)}.st.ld{color:var(--gold)}
.main{flex:1;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;min-width:0;margin-left:260px}
.pane{display:none;flex-direction:column;min-height:0}.pane.active{display:flex;flex:1;flex-direction:column;min-height:0}
.prev{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:20px 20px 60px}
.phone-mockup{position:relative;display:none;align-items:center;justify-content:center}
.phone-mockup.active{display:flex}
.phone-shell{width:320px;height:640px;background:#111;border-radius:44px;border:6px solid #333;box-shadow:0 0 0 1px #222,0 30px 80px rgba(0,0,0,.9);position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
.phone-shell::before{content:'';position:absolute;top:10px;left:50%;transform:translateX(-50%);width:80px;height:6px;background:#222;border-radius:3px;z-index:10}
.phone-shell::after{content:'';position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:36px;height:36px;border:2px solid #333;border-radius:50%;z-index:10}
.phone-inner{width:308px;height:620px;overflow:hidden;border-radius:38px;position:relative}
.mockup-toggle{padding:6px 14px;background:transparent;border:1px solid var(--b2);color:var(--mut2);font-family:'Space Mono',monospace;font-size:9px;cursor:pointer;letter-spacing:2px;text-transform:uppercase;transition:all .2s;margin-bottom:10px}
.mockup-toggle:hover,.mockup-toggle.on{border-color:var(--red);color:var(--red)}
.sf-normal{display:flex;flex-direction:column;align-items:center}
.sf{width:270px;height:480px;position:relative;overflow:hidden;border:1px solid #1a1a1a;box-shadow:0 20px 60px rgba(0,0,0,.85);flex-shrink:0}
canvas.cbg{position:absolute;inset:0;width:100%;height:100%}
.asian-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2}
.sov{position:absolute;inset:0;pointer-events:none;z-index:3;display:flex;flex-direction:column;padding:12px}
.s-top-block{display:flex;flex-direction:column;align-items:center;gap:6px;padding-top:4px}
.s-logo-wrap{height:56px;display:flex;align-items:center;justify-content:center}
.s-logo-wrap img{max-height:54px;max-width:130px;object-fit:contain;image-rendering:-webkit-optimize-contrast;image-rendering:crisp-edges}
.s-tag{display:flex;align-items:center;gap:5px}
.s-dot{width:5px;height:5px;border-radius:50%;background:var(--red);animation:blink 2s ease-in-out infinite}
.s-ey{font-family:'Space Mono',monospace;font-size:7px;letter-spacing:3px;text-transform:uppercase;color:var(--red)}
.s-div{height:.5px;background:linear-gradient(90deg,transparent,var(--red),transparent);margin:6px 4px}
.s-center{flex:1;display:flex;flex-direction:column;justify-content:center;padding:0 2px;gap:8px}
.s-title-big{font-family:'Noto Serif JP',serif;font-weight:900;line-height:.96;color:#fff;text-shadow:0 2px 20px rgba(0,0,0,.9);font-size:36px;word-break:break-word}
.s-title-big .acc{color:var(--red)}
.s-glass{background:rgba(5,5,5,.82);border:1px solid rgba(204,0,0,.3);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);padding:12px 14px;position:relative}
.s-glass::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(204,0,0,.6),transparent)}
.s-body-txt{font-size:10.5px;line-height:1.72;color:rgba(255,255,255,.9);font-weight:400;font-family:"Cinzel",serif;letter-spacing:.3px}
.s-div2{height:.5px;background:linear-gradient(90deg,transparent,var(--red),transparent);margin:4px 4px}
.s-hdl{text-align:center;font-family:'Space Mono',monospace;font-size:8px;letter-spacing:3px;color:rgba(255,255,255,.42);text-transform:uppercase;padding-bottom:2px}
.sloader{position:absolute;inset:0;background:rgba(5,5,5,.93);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;z-index:30}
.spin{width:26px;height:26px;border:2px solid #1a1a1a;border-top-color:var(--red);border-radius:50%;animation:spin .8s linear infinite}
.phdr{padding:13px 18px;border-bottom:1px solid var(--b1);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;flex-shrink:0}
.phdr h2{font-family:'Bebas Neue',sans-serif;font-size:17px;letter-spacing:3px}
.phdr-sub{font-size:10px;color:var(--mut);font-family:'Space Mono',monospace;margin-top:2px}
.wbody{flex:1;overflow-y:auto;padding:14px}.wgrid{display:flex;flex-direction:column;gap:5px}
.drow{background:var(--surf);border:1px solid var(--b1);display:flex}
.dcol{width:70px;min-width:70px;padding:10px;border-right:1px solid var(--b1);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:14px;letter-spacing:2px;color:var(--mut2)}
.dslots{display:flex;flex:1}
.dslot{flex:1;padding:9px 11px;border-right:1px solid var(--b1);min-height:68px}.dslot:last-child{border-right:none}.dslot.filled{background:rgba(204,0,0,.03)}
.dst{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:2px;color:var(--mut);text-transform:uppercase;margin-bottom:4px}
.dtype{font-size:9px;color:var(--red);font-family:'Space Mono',monospace;margin-bottom:3px}
.dtxt{font-size:9px;color:var(--mut2);line-height:1.4}
.dempty{font-size:9px;color:var(--mut);font-family:'Space Mono',monospace;text-transform:uppercase;letter-spacing:1px}
.wftr{padding:10px 18px;border-top:1px solid var(--b1);flex-shrink:0}
.sbody{flex:1;overflow-y:auto;padding:16px}
.sgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--b1)}
.sday{background:var(--surf);display:flex;flex-direction:column;gap:1px}
.sdname{padding:7px;text-align:center;font-family:'Bebas Neue',sans-serif;font-size:13px;letter-spacing:2px;color:var(--mut2);background:var(--surf2);border-bottom:1px solid var(--b1)}
.sslot{padding:8px;background:var(--surf2);position:relative}
.sslot.best{border-left:2px solid var(--red)}.sslot.good{border-left:2px solid var(--gold)}.sslot.low{border-left:2px solid var(--b2)}
.shr{font-size:8px;color:var(--mut);font-family:'Space Mono',monospace;margin-bottom:4px}
.sbar{height:3px;background:var(--b1);margin-bottom:5px}.sbarf{height:100%}
.stip{font-size:9px;color:var(--mut2);line-height:1.4}
.sbadge{position:absolute;top:5px;right:5px;font-size:7px;padding:2px 4px;font-family:'Space Mono',monospace;background:rgba(204,0,0,.15);color:var(--red);border:1px solid rgba(204,0,0,.3)}
.insights{margin-top:16px;background:var(--surf);border:1px solid var(--b1);padding:15px;display:flex;flex-direction:column;gap:12px}
.cbody{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:14px;max-width:780px;width:100%}
.cout{background:var(--surf2);border:1px solid var(--b2);padding:14px;font-size:13px;line-height:1.85;color:var(--mut2);min-height:130px;white-space:pre-wrap}
.hout{background:var(--surf2);border:1px solid var(--b1);padding:13px;font-size:11px;line-height:2.1;color:rgba(204,0,0,.8);min-height:68px;font-family:'Space Mono',monospace;word-break:break-all}
.abox{background:var(--surf2);border:1px solid var(--b2);padding:13px}.ares{font-size:11px;color:var(--mut2);line-height:1.6;margin-top:7px;font-style:italic}
.bbar{padding:11px 15px;border-bottom:1px solid var(--b1);display:flex;gap:8px;align-items:center;flex-shrink:0}
.bsearch{flex:1;padding:7px 10px;border:1px solid var(--b2);background:var(--surf2);color:var(--txt);font-size:12px;outline:none}
.bsearch:focus{border-color:var(--red)}
.bsel{padding:7px 10px;border:1px solid var(--b2);background:var(--surf2);color:var(--txt);font-size:11px;font-family:'Space Mono',monospace;outline:none;cursor:pointer}
.bgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(195px,1fr));gap:10px;padding:14px;overflow-y:auto;flex:1}
.bc{background:var(--surf);border:1px solid var(--b1);padding:13px;cursor:pointer;position:relative}
.bc:hover{border-color:var(--b2)}.bctype{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:2px;color:var(--red);text-transform:uppercase;margin-bottom:5px}
.bctitle{font-family:'Noto Serif JP',serif;font-size:15px;font-weight:900;line-height:1.1;margin-bottom:5px}
.bcbody{font-size:11px;color:var(--mut2);line-height:1.45}.bcdate{font-size:9px;color:var(--mut);font-family:'Space Mono',monospace;margin-top:7px}
.bcdel{position:absolute;top:8px;right:8px;font-size:10px;color:var(--mut);cursor:pointer;display:none}
.bc:hover .bcdel{display:block}.bcdel:hover{color:var(--red)}
.bempty{grid-column:1/-1;text-align:center;padding:60px 20px;color:var(--mut);font-family:'Space Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;line-height:2}
/* Progress overlay */
.prog-overlay{position:fixed;inset:0;background:rgba(6,6,6,.92);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;z-index:999;display:none}
.prog-bar-wrap{width:320px;height:6px;background:var(--b2);border-radius:3px;overflow:hidden}
.prog-bar{height:100%;background:var(--red);border-radius:3px;transition:width .1s;width:0%}
.prog-label{font-family:'Space Mono',monospace;font-size:11px;color:var(--muted2);letter-spacing:2px}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}

/* ── MÓVIL ────────────────────────────────────────────── */
@media(max-width:768px){

/* ── BODY BASE ── */
html,body{overflow:hidden;height:100%;height:100dvh}

/* ── TOPBAR ── */
.topbar{flex-wrap:wrap;height:auto;padding:7px 10px;gap:5px;flex-shrink:0}
.logo-sub{display:none}
.logo-txt{font-size:15px}
.tabs{margin-left:0;width:100%;order:2;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{height:34px;padding:0 10px;font-size:9px;white-space:nowrap;flex-shrink:0}
.api-area{order:1;margin-left:auto;gap:5px}
.api-sel{font-size:9px;padding:4px 5px}
.api-inp{width:120px;font-size:10px;padding:4px 7px}

/* ── LAYOUT PRINCIPAL ── */
.body{flex-direction:column;position:relative}
.main{margin-left:0;width:100%;height:100%}

/* ── SIDEBAR COMO DRAWER INFERIOR ── */
.sidebar{
position:fixed;
left:0;right:0;bottom:0;top:auto;
width:100%;max-width:100%;min-width:0;
/* Altura dinámica — cabe todo con scroll */
height:82dvh;height:82vh;
/* Scroll interno habilitado */
overflow-y:auto!important;
overflow-x:hidden!important;
-webkit-overflow-scrolling:touch;
overscroll-behavior:contain;
/* Secciones internas que no se corten */
display:flex;
flex-direction:column;
border-right:none;
border-top:2px solid var(–red);
transform:translateY(100%);
transition:transform .28s cubic-bezier(.4,0,.2,1);
z-index:100;
padding-bottom:70px; /* espacio para no tapar el botón generar */
}
.sidebar.mob-open{transform:translateY(0)}

/* Cada sección del sidebar NO corta su contenido */
.sb{
overflow:visible!important;
flex-shrink:0;
width:100%;
box-sizing:border-box;
}

/* Pills se envuelven bien */
.pills{display:flex;flex-wrap:wrap;gap:5px}
.pill{font-size:11px;padding:5px 9px}

/* Botón GENERAR siempre visible al fondo del drawer */
.sidebar .sb:last-child{
position:sticky;
bottom:0;
background:var(–surf);
z-index:10;
border-top:1px solid var(–b2);
padding-bottom:12px;
}

/* ── BOTÓN FLOTANTE ⚙️ ── */
#mob-toggle{
display:flex;
position:fixed;
bottom:18px;right:18px;
width:52px;height:52px;
background:var(–red);
border:none;border-radius:50%;
color:#fff;font-size:22px;
align-items:center;justify-content:center;
z-index:200;cursor:pointer;
box-shadow:0 4px 24px rgba(204,0,0,.6);
transition:transform .15s;
}
#mob-toggle:active{transform:scale(.9)}

/* ── PREVIEW HISTORIA ── */
.prev{padding:12px 12px 80px}
.sf{width:calc(100vw - 48px);max-width:260px;height:auto;aspect-ratio:9/16}
#dl-btn-area{width:calc(100vw - 48px)!important;max-width:260px!important}

/* ── SEMANA ── */
.wbody{padding:8px}
.wgrid{overflow-x:auto;-webkit-overflow-scrolling:touch}
.drow{min-width:580px}
.phdr{flex-direction:column;gap:6px}
.phdr>div:last-child{display:flex;flex-wrap:wrap;gap:5px}
.btn-gold{padding:6px 9px;font-size:9px}

/* ── HORARIOS ── */
.sbody{padding:10px}
.sgrid{overflow-x:auto;-webkit-overflow-scrolling:touch;display:flex;flex-wrap:nowrap}
.sday{min-width:95px;flex-shrink:0}

/* ── CAPTIONS ── */
.cbody{padding:10px}

/* ── BANCO ── */
.bgrid{grid-template-columns:1fr;padding:10px}

/* ── PROGRESS OVERLAY ── */
.prog-bar-wrap{width:88vw}
}

<style>
/* ══ SPLASH ══════════════════════════════════════════════ */
#splash{position:fixed;inset:0;z-index:99999;background:#060606;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:0;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;box-sizing:border-box}
#splash.hide{display:none!important}
#splash-inner{display:flex;flex-direction:column;align-items:center;width:100%;padding:40px 20px;min-height:100%;justify-content:center;box-sizing:border-box}
.sp-brand{font-family:'Bebas Neue',sans-serif;font-size:44px;letter-spacing:12px;color:#f0ebe3;margin-bottom:3px;text-align:center}
.sp-brand b{color:#CC0000}
.sp-tagline{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:4px;color:#E8720C;text-transform:uppercase;margin-bottom:28px;text-align:center}
.sp-api-block{width:100%;max-width:560px;background:#0d0d0d;border:1px solid #1c1c1c;padding:18px 20px;margin-bottom:22px;display:flex;flex-direction:column;gap:10px}
.sp-api-label{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#505050}
.sp-api-row{display:flex;gap:8px;align-items:center}
.sp-api-sel{background:#060606;border:1px solid #252525;color:#f0ebe3;padding:9px 10px;font-family:'Space Mono',monospace;font-size:10px;outline:none;cursor:pointer;flex-shrink:0}
.sp-api-sel:focus{border-color:#CC0000}
.sp-api-inp{flex:1;background:#060606;border:1px solid #252525;color:#f0ebe3;padding:9px 12px;font-family:'Space Mono',monospace;font-size:11px;outline:none}
.sp-api-inp:focus{border-color:#CC0000}
.sp-api-inp::placeholder{color:#333}
.sp-api-hint{font-family:'Space Mono',monospace;font-size:8px;color:#333;letter-spacing:1px}
.sp-api-hint a{color:#505050;text-decoration:none}.sp-api-hint a:hover{color:#CC0000}
.sp-cards{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;max-width:560px;width:100%}
.sp-card{flex:1;min-width:220px;max-width:270px;background:#0d0d0d;border:1px solid #1c1c1c;padding:24px 22px 20px;display:flex;flex-direction:column;gap:10px;cursor:pointer;transition:border-color .2s,transform .2s,box-shadow .2s;position:relative;overflow:hidden}
@media(max-width:500px){
.sp-cards{flex-direction:column;gap:12px;max-width:100%;padding:0 4px}
.sp-card{min-width:0;max-width:100%;width:100%;box-sizing:border-box}
#splash{overflow-y:scroll!important;-webkit-overflow-scrolling:touch}
#splash-inner{justify-content:flex-start;padding:20px 16px 80px;gap:10px;min-height:auto}
.sp-brand{font-size:36px;letter-spacing:8px;margin-bottom:0}
.sp-tagline{margin-bottom:10px;font-size:9px}
.sp-api-block{margin-bottom:10px;padding:14px 16px}
}
.sp-card:hover{transform:translateY(-3px)}
.sp-card.c1:hover{border-color:#CC0000;box-shadow:0 14px 34px rgba(204,0,0,.12)}
.sp-card.c2:hover{border-color:#E8720C;box-shadow:0 14px 34px rgba(200,134,10,.12)}
.sp-stripe{position:absolute;top:0;left:0;right:0;height:2px;transform:scaleX(0);transform-origin:left;transition:transform .32s}
.sp-card.c1 .sp-stripe{background:#CC0000}.sp-card.c2 .sp-stripe{background:#E8720C}
.sp-card:hover .sp-stripe{transform:scaleX(1)}
.sp-card-bg{position:absolute;top:12px;right:14px;font-family:'Noto Serif JP',serif;font-size:64px;font-weight:900;line-height:1;color:rgba(255,255,255,.025);pointer-events:none}
.sp-icon{font-size:32px;line-height:1}
.sp-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:4px;color:#f0ebe3;line-height:1.05}
.sp-card.c1 .sp-title span{color:#CC0000}.sp-card.c2 .sp-title span{color:#E8720C}
.sp-desc{font-family:'DM Sans',sans-serif;font-size:11px;color:#505050;line-height:1.55}
.sp-list{display:flex;flex-direction:column;gap:4px}
.sp-item{font-family:'Space Mono',monospace;font-size:9px;color:#3a3a3a;letter-spacing:1px;padding-left:10px;position:relative}
.sp-card.c1 .sp-item::before{content:'▸';position:absolute;left:0;color:#CC0000}
.sp-card.c2 .sp-item::before{content:'▸';position:absolute;left:0;color:#E8720C}
.sp-btn{margin-top:4px;padding:10px;border:none;font-family:'Bebas Neue',sans-serif;font-size:14px;letter-spacing:4px;cursor:pointer;text-align:center;transition:opacity .15s}
.sp-card.c1 .sp-btn{background:#CC0000;color:#fff}.sp-card.c2 .sp-btn{background:#E8720C;color:#000}
.sp-btn:hover{opacity:.86}
#btn-back{position:fixed;top:10px;left:10px;z-index:9998;padding:7px 14px;background:#0d0d0d;border:1px solid #252525;color:#505050;font-family:'Space Mono',monospace;font-size:9px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:all .15s;display:none}
#btn-back:hover{border-color:#CC0000;color:#CC0000}
#btn-back.show{display:block}

/* ══ DICCIONARIO VISUAL ══════════════════════════════════ */
#dict-app{display:none;width:100vw;height:100vh;overflow:hidden;flex-direction:row;background:#060606}
#dict-app.show{display:flex}
/* Sidebar del diccionario — scroll como el inkbot */
.d-sidebar{width:260px;min-width:260px;max-width:260px;background:#0d0d0d;border-right:1px solid #1c1c1c;overflow-y:scroll;overflow-x:hidden;display:flex;flex-direction:column;flex-shrink:0;position:absolute;top:0;bottom:0;left:0}
.d-sidebar::-webkit-scrollbar{width:5px}.d-sidebar::-webkit-scrollbar-thumb{background:#333}
#dict-app .d-main{flex:1;overflow-y:auto;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:20px 20px 60px;margin-left:260px}
#dict-app .d-main::-webkit-scrollbar{width:5px}.d-main::-webkit-scrollbar-thumb{background:#252525}
/* topbar dict */
.d-topbar{height:50px;background:#0d0d0d;border-bottom:1px solid #1c1c1c;display:flex;align-items:center;padding:0 14px;gap:8px;flex-shrink:0}
.d-topbar-logo{width:26px;height:26px;background:#E8720C;font-family:'Noto Serif JP',serif;font-size:14px;font-weight:900;color:#000;display:flex;align-items:center;justify-content:center}
.d-topbar-title{font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:4px;color:#f0ebe3}
/* Botón toggle móvil diccionario */
#d-mob-toggle{display:none}
@media(max-width:768px){
  #dict-app .d-main{margin-left:0;width:100%;padding:12px 12px 90px}
  .d-sidebar{
    position:fixed;left:0;right:0;bottom:0;top:auto;
    width:100%;max-width:100%;min-width:0;
    height:82dvh;
    overflow-y:auto!important;overflow-x:hidden!important;
    -webkit-overflow-scrolling:touch;overscroll-behavior:contain;
    display:flex;flex-direction:column;
    border-right:none;border-top:2px solid #E8720C;
    transform:translateY(100%);
    transition:transform .28s cubic-bezier(.4,0,.2,1);
    z-index:100;padding-bottom:70px;
  }
  .d-sidebar.d-mob-open{transform:translateY(0)}
  .d-sidebar .d-sb:last-child{position:sticky;bottom:0;background:#0d0d0d;z-index:10;border-top:1px solid #1c1c1c;padding-bottom:12px}
  #d-mob-toggle{
    display:flex;
    position:fixed;bottom:18px;right:18px;
    width:52px;height:52px;
    background:#E8720C;
    border:none;border-radius:50%;
    color:#000;font-size:22px;
    align-items:center;justify-content:center;
    z-index:200;cursor:pointer;
    box-shadow:0 4px 24px rgba(200,134,10,.6);
    transition:transform .15s;
  }
  #d-mob-toggle:active{transform:scale(.9)}
}
.d-topbar-sub{font-family:'Space Mono',monospace;font-size:8px;color:#E8720C;letter-spacing:2px}
.d-sb{padding:12px;border-bottom:1px solid #1c1c1c;width:100%;overflow:hidden;box-sizing:border-box}
.d-lbl{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#505050;margin-bottom:8px}
.d-pills{display:flex;flex-wrap:wrap;gap:4px}
.d-pill{padding:4px 7px;border:1px solid #1c1c1c;font-size:10px;cursor:pointer;color:#505050;font-family:'Space Mono',monospace;background:transparent;transition:all .15s}
.d-pill.on{border-color:#E8720C;color:#E8720C;background:rgba(200,134,10,.07)}
.d-pill:hover:not(.on){border-color:#333;color:#f0ebe3}
.d-inp-d{width:100%;padding:8px 10px;border:1px solid #1c1c1c;background:#060606;color:#f0ebe3;font-size:12px;outline:none;font-family:'DM Sans',sans-serif;box-sizing:border-box}
.d-inp-d:focus{border-color:#E8720C}
.d-photo-upz{border:1px dashed #1c1c1c;padding:10px;text-align:center;cursor:pointer;position:relative;background:#060606;transition:border-color .2s;box-sizing:border-box}
.d-photo-upz:hover{border-color:#E8720C}
.d-photo-upz input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.d-photo-upz p{font-size:10px;color:#505050;letter-spacing:1px;text-transform:uppercase}
.d-btn-gen-d{width:100%;padding:11px;background:#E8720C;color:#000;border:none;font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:3px;cursor:pointer;transition:opacity .2s;box-sizing:border-box}
.d-btn-gen-d:hover{opacity:.85}.d-btn-gen-d:disabled{opacity:.35;cursor:not-allowed}
.d-btn-regen-d{width:100%;padding:8px;background:transparent;color:#505050;border:1px solid #1c1c1c;font-family:'Space Mono',monospace;font-size:10px;cursor:pointer;transition:all .2s;text-transform:uppercase;display:none;box-sizing:border-box}
.d-btn-regen-d:hover{border-color:#E8720C;color:#E8720C}
.d-st-d{font-size:10px;color:#505050;font-family:'Space Mono',monospace;text-align:center;min-height:14px;padding:3px 0}
.d-st-d.ok{color:#1D9E75}.d-st-d.err{color:#CC0000}.d-st-d.ld{color:#E8720C}
/* campo tema dict — compacto */
.d-tema-wrap{padding:10px 12px;border-bottom:1px solid #1c1c1c;box-sizing:border-box}
.d-tema-label{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:2px;text-transform:uppercase;color:#E8720C;margin-bottom:6px;display:flex;align-items:center;gap:5px}
.d-tema-badge{background:#E8720C;color:#000;font-size:7px;padding:1px 5px;letter-spacing:1px}
.d-tema-inp{width:100%;padding:7px 10px;background:#060606;border:1px solid #252525;color:#f0ebe3;font-family:'DM Sans',sans-serif;font-size:12px;outline:none;box-sizing:border-box;transition:border-color .15s}
.d-tema-inp:focus{border-color:#E8720C}
.d-tema-inp::placeholder{color:#333;font-style:italic}
.d-tema-sugs{display:flex;flex-wrap:wrap;gap:3px;margin-top:5px}
.d-tema-sug{padding:3px 7px;border:1px solid #1c1c1c;color:#505050;font-family:'Space Mono',monospace;font-size:9px;cursor:pointer;background:transparent;transition:all .12s;letter-spacing:0}
.d-tema-sug:hover{border-color:#E8720C;color:#E8720C}
.d-tema-active{font-family:'Space Mono',monospace;font-size:8px;color:#E8720C;letter-spacing:1px;margin-top:4px;display:none}
/* card del diccionario */
.d-sf{width:270px;height:480px;position:relative;overflow:hidden;flex-shrink:0;background:#1a1208;box-shadow:0 8px 40px rgba(0,0,0,.7)}
.d-cbg{position:absolute;inset:0;width:100%;height:100%}
.d-svg-dec{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2}
.d-ov{position:absolute;inset:0;display:flex;flex-direction:column;z-index:5}
.d-photo-area{flex:0 0 38%;position:relative;overflow:hidden;border-bottom:1px solid rgba(200,134,10,.2);display:flex;align-items:center;justify-content:center;background:#0f0a02;cursor:pointer}
.d-photo-area input{position:absolute;inset:0;opacity:0;cursor:pointer;z-index:10}
.d-photo-area img.d-photo-img{width:100%;height:100%;object-fit:cover;display:none}
.d-photo-placeholder{display:flex;flex-direction:column;align-items:center;gap:4px;pointer-events:none}
.d-photo-placeholder .d-kanji{font-family:'Noto Serif JP',serif;font-size:64px;font-weight:900;color:rgba(200,134,10,.12);line-height:1}
.d-uplabel{font-family:'Space Mono',monospace;font-size:8px;color:#333;letter-spacing:2px;text-transform:uppercase}
.d-photo-hover-lbl{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.75);padding:4px;font-family:'Space Mono',monospace;font-size:8px;color:#E8720C;letter-spacing:2px;text-transform:uppercase;text-align:center;opacity:0;transition:opacity .2s;pointer-events:none}
.d-photo-area:hover .d-photo-hover-lbl{opacity:1}
.d-content{flex:1;display:flex;flex-direction:column;padding:10px 12px 8px;gap:5px;overflow:hidden}
.d-tag-row{display:flex;align-items:center;gap:6px}
.d-dot-gold{width:5px;height:5px;background:#E8720C;border-radius:50%;flex-shrink:0}
.d-eyebrow{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:3px;color:#E8720C;text-transform:uppercase}
.d-divline{width:100%;height:1px;background:linear-gradient(to right,rgba(200,134,10,.6),transparent)}
.d-symbol-name{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:3px;color:#f0ebe3;line-height:1.05}
.d-symbol-name .d-acc{color:#E8720C}
.d-symbol-jp{font-family:'Noto Serif JP',serif;font-size:11px;color:rgba(200,134,10,.55);font-weight:400;margin-top:-2px;display:block}
.d-glass{background:rgba(200,134,10,.06);border:1px solid rgba(200,134,10,.15);border-left:2px solid #E8720C;padding:8px 10px;flex:1;overflow:hidden}
.d-body-txt{font-family:'DM Sans',sans-serif;font-size:9.5px;color:rgba(240,235,227,.82);line-height:1.5}
.d-divline2{width:100%;height:1px;background:linear-gradient(to right,transparent,rgba(200,134,10,.4),transparent)}
.d-footer-row{display:flex;align-items:center;justify-content:space-between;padding:0 2px}
.d-handle-txt{font-family:'Space Mono',monospace;font-size:8px;color:rgba(200,134,10,.7);letter-spacing:2px}
.d-badge-jp{font-family:'Noto Serif JP',serif;font-size:9px;color:rgba(200,134,10,.4);font-weight:900}
.d-loader{position:absolute;inset:0;background:rgba(10,8,2,.85);z-index:20;display:none;flex-direction:column;align-items:center;justify-content:center;gap:10px}
.d-loader.show{display:flex}
.d-spin{width:22px;height:22px;border:2px solid #333;border-top-color:#E8720C;border-radius:50%;animation:dspin .8s linear infinite}
@keyframes dspin{to{transform:rotate(360deg)}}
/* botones bajo la card dict */
.d-dl-area{display:none;flex-direction:column;gap:6px;width:270px;margin-top:10px}
.d-dl-area.show{display:flex}
.d-fb-bar{display:flex;gap:6px;align-items:center;background:rgba(255,255,255,.03);border:1px solid #1c1c1c;padding:8px 10px}
.d-fb-label{font-size:9px;color:#505050;font-family:'Space Mono',monospace;letter-spacing:1px;text-transform:uppercase;flex:1}
.d-btn-like{flex:1;padding:7px 4px;background:transparent;border:1px solid #2a5c2a;color:#4ade80;font-family:'Space Mono',monospace;font-size:11px;cursor:pointer;transition:all .2s}
.d-btn-dislike{flex:1;padding:7px 4px;background:transparent;border:1px solid #5c2a2a;color:#f87171;font-family:'Space Mono',monospace;font-size:11px;cursor:pointer;transition:all .2s}
.d-fb-msg{display:none;font-size:9px;font-family:'Space Mono',monospace;letter-spacing:1px;text-align:center;padding:4px 0;text-transform:uppercase}
.d-btn-dl{flex:1;padding:9px 6px;background:transparent;color:#f0ebe3;border:1px solid #252525;font-family:'Space Mono',monospace;font-size:10px;cursor:pointer;text-transform:uppercase;transition:all .2s}
.d-btn-dl:hover{border-color:#E8720C;color:#E8720C}
.d-btn-dl-gold{flex:1;padding:9px 6px;background:transparent;color:#E8720C;border:1px solid #E8720C;font-family:'Space Mono',monospace;font-size:10px;cursor:pointer;text-transform:uppercase;transition:all .2s}
.d-btn-dl-gold:hover{background:#E8720C;color:#000}
</style>
</head>

<!-- ═══════════ SPLASH ═══════════ -->
<div id="splash">
  <div id="splash-inner">
  <div class="sp-brand">INK<b>BOT</b></div>
  <div class="sp-tagline">Sistema de contenido · V.SOBRONTT</div>
  <div class="sp-api-block">
    <div class="sp-api-label">API Key — requerida para generar contenido</div>
    <div class="sp-api-row">
      <select class="sp-api-sel" id="sp-provider">
        <option value="anthropic">Anthropic</option>
        <option value="gemini">Gemini</option>
      </select>
      <input type="password" class="sp-api-inp" id="sp-key" placeholder="sk-ant-... / fe_oa_... / AIza...">
    </div>
    <div class="sp-api-hint">
      Anthropic: <a href="https://console.anthropic.com" target="_blank">console.anthropic.com</a> &nbsp;·&nbsp;
      Gemini: <a href="https://aistudio.google.com" target="_blank">aistudio.google.com</a>
    </div>
  </div>
  <div class="sp-cards">
    <div class="sp-card c1" id="sp-inkbot">
      <div class="sp-stripe"></div><div class="sp-card-bg">一</div>
      <div class="sp-icon">⚡</div>
      <div class="sp-title">Creación de<br><span>Contenido</span></div>
      <div class="sp-desc">Historias animadas, semana completa, captions. Escribe un tema y toda la generación se orienta a él.</div>
      <div class="sp-list">
        <div class="sp-item">Historias con tema libre</div>
        <div class="sp-item">Planeador semanal</div>
        <div class="sp-item">Captions + hashtags</div>
        <div class="sp-item">Like/dislike que entrena la IA</div>
      </div>
      <div class="sp-btn">ENTRAR →</div>
    </div>
    <div class="sp-card c2" id="sp-dict">
      <div class="sp-stripe"></div><div class="sp-card-bg">二</div>
      <div class="sp-icon">📖</div>
      <div class="sp-title">Diccionario<br><span>Visual</span></div>
      <div class="sp-desc">Cards animadas de significado de símbolos. Sube tu foto y orienta el contenido a cualquier tema.</div>
      <div class="sp-list">
        <div class="sp-item">Video animado 15s (como Inkbot)</div>
        <div class="sp-item">Foto del tatuaje arriba</div>
        <div class="sp-item">Tema 100% temático</div>
        <div class="sp-item">Like/dislike para aprender</div>
      </div>
      <div class="sp-btn">ENTRAR →</div>
    </div>
  </div>
  </div><!-- /#splash-inner -->
</div>
<button id="btn-back">← Menú</button>

<!-- ═══════════ DICCIONARIO VISUAL ═══════════ -->
<button id="d-mob-toggle" onclick="document.querySelector('.d-sidebar').classList.toggle('d-mob-open');this.textContent=document.querySelector('.d-sidebar').classList.contains('d-mob-open')?'✕':'⚙️'">⚙️</button>
<div id="dict-app" style="position:relative;height:100vh">
  <!-- Progress overlay dict -->
  <div id="d-prog-overlay" style="position:fixed;inset:0;background:rgba(6,6,6,.92);display:none;flex-direction:column;align-items:center;justify-content:center;gap:16px;z-index:9999">
    <div style="font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:4px;color:#E8720C">GENERANDO VIDEO</div>
    <div style="width:320px;height:6px;background:#1c1c1c;border-radius:3px;overflow:hidden"><div id="d-prog-bar" style="height:100%;background:#E8720C;border-radius:3px;transition:width .1s;width:0%"></div></div>
    <div id="d-prog-label" style="font-family:'Space Mono',monospace;font-size:10px;color:#505050;letter-spacing:2px">Iniciando...</div>
  </div>
  <div class="d-sidebar">
    <div class="d-topbar">
      <div class="d-topbar-logo">彫</div>
      <div><div class="d-topbar-title">DICCIONARIO</div><div class="d-topbar-sub">VISUAL · TATUAJE</div></div>
    </div>

    <!-- TEMA LIBRE -->
    <div class="d-tema-wrap">
      <div class="d-tema-label">🎨 Tema libre <span class="d-tema-badge">NUEVO</span></div>
      <input type="text" class="d-tema-inp" id="d-tema" placeholder="Navidad, Halloween, amor...">
      <div class="d-tema-sugs" id="d-tema-sugs">
        <button class="d-tema-sug" data-tema="">✕ Sin tema</button>
        <button class="d-tema-sug" data-tema="Navidad">🎄 Navidad</button>
        <button class="d-tema-sug" data-tema="Día de Muertos">💀 D. Muertos</button>
        <button class="d-tema-sug" data-tema="San Valentín">❤️ San Valentín</button>
        <button class="d-tema-sug" data-tema="Halloween">🎃 Halloween</button>
        <button class="d-tema-sug" data-tema="Año Nuevo">🎆 Año Nuevo</button>
        <button class="d-tema-sug" data-tema="Verano">☀️ Verano</button>
      </div>
      <div class="d-tema-active" id="d-tema-active"></div>
    </div>

    <!-- SÍMBOLO -->
    <div class="d-sb">
      <div class="d-lbl">Símbolo</div>
      <div class="d-pills" id="d-type-pills">
        <div class="d-pill on" data-val="random" style="color:#E8720C;border-color:#E8720C">🎲 RANDOM</div>
        <div class="d-pill" data-val="koi">🐟 Koi</div>
        <div class="d-pill" data-val="oni">👹 Oni</div>
        <div class="d-pill" data-val="hannya">🎭 Hannya</div>
        <div class="d-pill" data-val="dragon">🐉 Dragón</div>
        <div class="d-pill" data-val="sakura">🌸 Sakura</div>
        <div class="d-pill" data-val="peonia">🌺 Peonía</div>
        <div class="d-pill" data-val="tigre">🐯 Tigre</div>
        <div class="d-pill" data-val="calavera">💀 Calavera</div>
        <div class="d-pill" data-val="serpiente">🐍 Serpiente</div>
        <div class="d-pill" data-val="aguila">🦅 Águila</div>
        <div class="d-pill" data-val="lobo">🐺 Lobo</div>
        <div class="d-pill" data-val="rosa">🥀 Rosa</div>
        <div class="d-pill" data-val="ancla">⚓ Ancla</div>
        <div class="d-pill" data-val="reloj">⏱ Sin manecillas</div>
        <div class="d-pill" data-val="luna">🌙 Luna</div>
