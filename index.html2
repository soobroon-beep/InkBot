<div class="main">
  <div class="pane active" id="pane-story">
    <div class="prev">
      <div class="sf" id="sf">
        <canvas class="cbg" id="cv"></canvas>
        <svg class="asian-svg" id="asian-svg" viewBox="0 0 270 480" xmlns="http://www.w3.org/2000/svg"></svg>
        <div class="sov">
          <div class="s-top-block">
            <div class="s-logo-wrap"><img id="s-logo" style="display:none"></div>
            <div class="s-tag"><div class="s-dot"></div><div class="s-ey" id="s-ey">INKBOT PRO</div></div>
          </div>
          <div class="s-div"></div>
          <div class="s-center">
            <div class="s-title-big" id="s-ttl" style="color:rgba(255,255,255,.2)">Genera tu primera<br><span class="acc">historia</span></div>
            <div class="s-glass"><div class="s-body-txt" id="s-bod" style="color:rgba(255,255,255,.2)">Configura y presiona generar.</div></div>
          </div>
          <div class="s-div2"></div>
          <div class="s-hdl" id="s-hdl">@victortip</div>
        </div>
        <div class="sloader" id="sloader" style="display:none"><div class="spin"></div><p style="font-family:'Space Mono',monospace;font-size:9px;letter-spacing:3px;color:var(--mut);text-transform:uppercase">Creando...</p></div>
      </div>
      <!-- Download buttons below preview -->
      <div id="dl-btn-area" style="display:none;flex-direction:column;gap:6px;width:270px;margin-top:10px">
        <!-- ── LIKE / DISLIKE ── -->
        <div id="feedback-bar" style="display:flex;gap:6px;align-items:center;background:rgba(255,255,255,.03);border:1px solid var(--b2);padding:8px 10px">
          <span style="font-size:9px;color:var(--mut);font-family:'Space Mono',monospace;letter-spacing:1px;text-transform:uppercase;flex:1">¿Te gustó?</span>
          <button id="btn-like" title="Me gustó — genera más así" style="flex:1;padding:7px 4px;background:transparent;border:1px solid #2a5c2a;color:#4ade80;font-family:'Space Mono',monospace;font-size:11px;cursor:pointer;transition:all .2s;border-radius:2px">👍 Me gustó</button>
          <button id="btn-dislike" title="Repetida — genera otra distinta" style="flex:1;padding:7px 4px;background:transparent;border:1px solid #5c2a2a;color:#f87171;font-family:'Space Mono',monospace;font-size:11px;cursor:pointer;transition:all .2s;border-radius:2px">👎 Repetida</button>
        </div>
        <div id="feedback-msg" style="display:none;font-size:9px;font-family:'Space Mono',monospace;letter-spacing:1px;text-align:center;padding:4px 0;text-transform:uppercase"></div>
        <div style="display:flex;gap:6px">
          <button id="btn-dl-png" style="flex:1;padding:9px 6px;background:transparent;color:var(--txt);border:1px solid var(--b2);font-family:'Space Mono',monospace;font-size:10px;cursor:pointer;text-transform:uppercase;transition:all .2s" onmouseover="this.style.borderColor='var(--red)';this.style.color='var(--red)'" onmouseout="this.style.borderColor='var(--b2)';this.style.color='var(--txt)'">↓ PNG</button>
          <button id="btn-dl-mp4" style="flex:1;padding:9px 6px;background:transparent;color:var(--gold);border:1px solid var(--gold);font-family:'Space Mono',monospace;font-size:10px;cursor:pointer;text-transform:uppercase;transition:all .2s" onmouseover="this.style.background='var(--gold)';this.style.color='#000'" onmouseout="this.style.background='transparent';this.style.color='var(--gold)'">▶ Video 15s</button>
        </div>
        <a id="btn-convert-mp4" href="https://cloudconvert.com/webm-to-mp4" target="_blank" style="display:none;width:100%;padding:8px 6px;background:transparent;color:#60a5fa;border:1px solid #60a5fa;font-family:'Space Mono',monospace;font-size:9px;cursor:pointer;text-transform:uppercase;transition:all .2s;text-decoration:none;align-items:center;justify-content:center;gap:6px;box-sizing:border-box" onmouseover="this.style.background='#60a5fa';this.style.color='#000'" onmouseout="this.style.background='transparent';this.style.color='#60a5fa'">
          🔄 Convertir .webm → .mp4 (cloudconvert.com)
        </a>
        <button id="btn-drive-png" style="width:100%;padding:8px 6px;background:transparent;color:#4ade80;border:1px solid #4ade80;font-family:'Space Mono',monospace;font-size:10px;cursor:pointer;text-transform:uppercase;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px" onmouseover="this.style.background='#4ade80';this.style.color='#000'" onmouseout="this.style.background='transparent';this.style.color='#4ade80'">
          <svg width="12" height="12" viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg"><path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/><path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" fill="#00ac47"/><path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/><path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/><path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/><path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/></svg>
          Guardar en Drive
        </button>
      </div>
    </div>
  </div>

  <div class="pane" id="pane-week">
    <div class="phdr"><div><h2>Planeador Semanal</h2><div class="phdr-sub">21 historias · 3 por día · temas y fondos variados</div></div>
      <div style="display:flex;gap:8px">
        <button class="btn-ghost" id="btn-gen-week" style="width:auto;padding:8px 14px">⚡ Generar semana</button>
        <button class="btn-gold" id="btn-export-week" disabled>↓ ZIP PNG</button>
        <button class="btn-gold" id="btn-export-week-mp4" disabled style="border-color:#e8720c">▶ ZIP Video</button>
        <button id="btn-drive-week" disabled style="padding:8px 10px;background:transparent;color:#4ade80;border:1px solid #4ade80;font-family:'Space Mono',monospace;font-size:9px;cursor:pointer;text-transform:uppercase;transition:all .2s;opacity:.4;display:flex;align-items:center;gap:5px" onmouseover="if(!this.disabled){this.style.background='#4ade80';this.style.color='#000'}" onmouseout="this.style.background='transparent';this.style.color='#4ade80'">
          <svg width="10" height="10" viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg"><path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/><path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" fill="#00ac47"/><path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/><path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/><path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/><path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/></svg>
          Drive ZIP
        </button>
