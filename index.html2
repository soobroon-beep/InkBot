</div>

<!-- Google Drive setup panel -->

<div id="gd-setup" style="display:none;background:#0d1f0d;border-bottom:1px solid #1a4a1a;padding:10px 16px;display:none;align-items:center;gap:10px;flex-wrap:wrap">
  <span style="font-size:10px;color:#4ade80;font-family:'Space Mono',monospace;letter-spacing:2px;text-transform:uppercase">Google Drive</span>
  <input type="text" id="gd-client-id" placeholder="Google OAuth Client ID (console.cloud.google.com)" style="flex:1;min-width:260px;padding:6px 10px;background:#0a1a0a;border:1px solid #2a5a2a;color:#4ade80;font-family:'Space Mono',monospace;font-size:10px;outline:none">
  <button onclick="document.getElementById('gd-setup').style.display='none';document.getElementById('btn-drive-png').click()" style="padding:6px 14px;background:#4ade80;color:#000;border:none;font-family:'Space Mono',monospace;font-size:10px;cursor:pointer">Conectar</button>
  <button onclick="document.getElementById('gd-setup').style.display='none'" style="padding:6px 10px;background:transparent;color:#555;border:1px solid #333;font-family:'Space Mono',monospace;font-size:10px;cursor:pointer">✕</button>
  <div style="width:100%;font-size:9px;color:#2a6a2a;font-family:'Space Mono',monospace">Necesitas crear credenciales OAuth en console.cloud.google.com → APIs → Drive API → Credenciales</div>
</div>

