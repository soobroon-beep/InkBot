<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/mp4-muxer@5.1.3/build/mp4-muxer.min.js"></script>

<script>
// ── ENCODER DE VIDEO — WebCodecs + mp4-muxer ──────────────────────────────
// Genera MP4 H.264 Baseline idéntico al video que funciona en Instagram:
//   H.264 Baseline Profile Level 4.0, 30fps, ~1.4Mbps, yuv420p, bt709
//   1080×1920, sin audio, contenedor isom/avc1/mp41

function recordAndExport(canvas, renderFn, durationMs, progressCb) {
  durationMs = durationMs || 15000;
  var fps = 30;
  var totalFrames = Math.round(fps * durationMs / 1000);
  var W = canvas.width, H = canvas.height;

  // Verificar soporte de WebCodecs + mp4-muxer
  if (typeof VideoEncoder === 'undefined' || typeof Mp4Muxer === 'undefined') {
    return recordWebmFallback(canvas, renderFn, durationMs, progressCb);
  }

  return new Promise(function(resolve, reject) {
    var muxer = new Mp4Muxer.Muxer({
      target: new Mp4Muxer.ArrayBufferTarget(),
      video: {
        codec: 'avc',
        width: W,
        height: H,
        frameRate: fps
      },
      fastStart: 'in-memory', // moov al principio — obligatorio para streaming
      firstTimestampBehavior: 'offset'
    });

    var encoder = new VideoEncoder({
      output: function(chunk, meta) {
        muxer.addVideoChunk(chunk, meta);
      },
      error: function(e) { reject(e); }
    });

    encoder.configure({
      codec: 'avc1.42C028',  // H.264 Baseline Profile Level 4.0 — igual que el video funcional
      width: W,
      height: H,
      framerate: fps,
      bitrate: 1400000,      // ~1.4 Mbps — igual que el video que funciona
      latencyMode: 'quality',
      avc: { format: 'avc' } // formato AVC (annexb=false) — requerido por mp4-muxer
    });

    if (progressCb) progressCb(0, 'Iniciando encoder...');

    var frameIdx = 0;

    function encodeNextFrame() {
      if (frameIdx >= totalFrames) {
        encoder.flush().then(function() {
          encoder.close();
          muxer.finalize();
          if (progressCb) progressCb(98, 'Empaquetando MP4...');
          var buf = muxer.target.buffer;
          var blob = new Blob([buf], { type: 'video/mp4' });
          if (progressCb) progressCb(100, '¡Listo!');
          resolve(blob);
        }).catch(reject);
        return;
      }

      var t = frameIdx / totalFrames;
      renderFn(t);

      if (progressCb && frameIdx % 15 === 0) {
        progressCb(Math.round(t * 95), 'Renderizando: ' + Math.round(t * durationMs / 1000) + 's / 15s...');
      }

      createImageBitmap(canvas).then(function(bmp) {
        var timestampUs = Math.round(frameIdx * 1000000 / fps);
        var vf = new VideoFrame(bmp, {
          timestamp: timestampUs,
          duration: Math.round(1000000 / fps)
        });
        // Keyframe cada 2 segundos (igual que el video funcional)
        encoder.encode(vf, { keyFrame: frameIdx % (fps * 2) === 0 });
        vf.close();
        bmp.close();
        frameIdx++;
        setTimeout(encodeNextFrame, 0);
      }).catch(function() {
        frameIdx++;
        setTimeout(encodeNextFrame, 0);
      });
    }

    encodeNextFrame();
  });
}

// Fallback para navegadores sin WebCodecs (Firefox, Safari antiguo)
// Graba WebM y corrige la duración en el header — Instagram acepta WebM en móvil
function recordWebmFallback(canvas, renderFn, durationMs, progressCb) {
  return new Promise(function(resolve, reject) {
    var fps = 30, mimeType = '';
    ['video/webm;codecs=vp9', 'video/webm;codecs=vp8', 'video/webm'].forEach(function(m) {
      if (!mimeType && MediaRecorder.isTypeSupported(m)) mimeType = m;
    });
    if (!mimeType) { reject(new Error('Navegador no soporta grabación de video')); return; }

    var chunks = [], stopped = false, recStart = Date.now();
    renderFn(0);

    var mr = new MediaRecorder(canvas.captureStream(fps), {
      mimeType: mimeType,
      videoBitsPerSecond: 6000000
    });
    mr.ondataavailable = function(e) { if (e.data && e.data.size > 0) chunks.push(e.data); };
    mr.onstop = function() {
      var blob = new Blob(chunks, { type: mimeType });
      // Corregir duración en header WebM para que Instagram lo reconozca
      var reader = new FileReader();
      reader.onload = function(e) {
        var buf = new Uint8Array(e.target.result);
        var dv = new DataView(new ArrayBuffer(8));
        dv.setFloat64(0, durationMs / 1000, false);
        var db = new Uint8Array(dv.buffer);
        for (var i = 0; i < buf.length - 10; i++) {
          if (buf[i] === 0x44 && buf[i+1] === 0x89 && buf[i+2] === 0x88) {
            for (var j = 0; j < 8; j++) buf[i+3+j] = db[j];
            break;
          }
        }
        resolve(new Blob([buf.buffer], { type: 'video/webm' }));
      };
      reader.onerror = function() { resolve(blob); };
      reader.readAsArrayBuffer(blob);
    };
    mr.onerror = function(e) { reject(e.error || new Error('Error grabando')); };
    mr.start(100);

    var targetEnd = Date.now() + durationMs;
    var loop = setInterval(function() {
      if (stopped) return;
      var now = Date.now(), elapsed = now - recStart, t = Math.min(elapsed / durationMs, 1);
      renderFn(t);
      var c = canvas.getContext('2d'); c.fillStyle = 'rgba(0,0,0,0.0001)'; c.fillRect(0, 0, 1, 1);
      if (progressCb) progressCb(Math.round(t * 90), 'Grabando: ' + Math.round(elapsed / 1000) + 's / 15s...');
      if (now >= targetEnd && !stopped) {
        stopped = true; clearInterval(loop);
        setTimeout(function() { if (mr.state !== 'inactive') mr.stop(); }, 300);
      }
    }, Math.round(1000 / fps));
  });
}

</script>

<script>
(function(){

var selType='dato',selBg='photo',selTone='storytelling';
var logoUrl=null,logoImg=null,photos=[],pidx=0,animId=null;
var bank=[],weekData=[],currentStory=null;
var capB64=null,capMime=null,fontsReady=false;

var typeMap={
  dato:'un dato curioso REAL, sorprendente y verificable sobre tatuajes que casi nadie conoce. REGLA DE ORO: cada vez elige un ángulo COMPLETAMENTE distinto del último. Categorías para rotar (NUNCA dos veces la misma seguidas): leyes raras por país, costumbres laborales, récords mundiales documentados, datos médicos verificables, datos de la industria del tatuaje en cifras, anécdotas históricas reales con personajes nombrados, datos sobre tatuadores famosos vivos, estadísticas de arrepentimiento o satisfacción según estudios reales. PROHIBIDO: tintas UV, rayos X, propiedades ópticas, datos genéricos. Que sorprenda de verdad.',
  estilo:'explica UN estilo de tatuaje concreto de forma visual y emocionante. Cada generación un estilo DIFERENTE. Rota entre: blackwork geométrico, realismo fotográfico, irezumi japonés, fineline minimalista, acuarela, old school americano, maorí, biomecánico, pointillism, chicano black and grey, trash polka, ornamental hindú, illustrative moderno, neo-japonés, dotwork sagrado, brushstroke caligráfico, single needle, hyper-realismo, anime/manga, surrealista pop, sticker tattoo, blackout, micro-paisajes, retrato hiperrealista a color. Para cada uno: dónde nació, qué lo hace único visualmente, qué tipo de persona lo elige.',
  historia:'una historia ESPECÍFICA, dramática y casi desconocida del mundo del tatuaje, con personajes reales nombrados y fechas. Rota entre épocas y geografías muy distintas: Samuel O\'Reilly y la primera máquina eléctrica (1891), las mujeres tatuadas del circo siglo XIX (Nora Hildebrandt, Maud Wagner), los marineros y supersticiones, los gulags soviéticos y su lenguaje secreto en piel, samuráis tatuados del Edo, las guerreras maoríes y el tā moko, la corte de Birmania, los tatuajes en la Roma de Constantino, Capitán Cook trayendo la palabra "tatau" a Europa en 1769, el caso del Hombre de Hielo Ötzi (5300 años, 61 tatuajes), la prohibición Meiji en Japón. Que sea cinematográfica.',
  mito:'desmiente un mito MUY ESPECÍFICO sobre tatuajes con datos contundentes. Cada generación un mito completamente DIFERENTE. Rota: los negros envejecen peor — falso. Tatuar sobre cicatriz es imposible — falso. Limón borra tatuajes — falso y peligroso. Afecta análisis de sangre — falso. Embarazo y tatuaje — matizado. Tatuarse mismo lugar dos veces destruye piel — falso. Alcohol antes de tatuarse — verdadero adelgaza la sangre. El tatuaje se ve igual toda la vida — falso, evoluciona. Alergias raras — falso. Donar sangre tras tatuarse — depende del país. Resonancia magnética y tatuajes — matizado. Tatuajes y ejercicio post-sesión — riesgo real. Datos verificables.',
  simbolo:'el significado profundo de UN símbolo en tatuajes con origen mitológico exacto. Cada vez DIFERENTE: ouroboros (eternidad alquímica), loto (renacimiento desde el barro), ojo de Horus, calavera mexicana, ancla, reloj sin manecillas, luna creciente, lobo solitario, Ganesha, cuervo nórdico Huginn y Muninn, rosa negra, tigre Baekho coreano, fénix renaciendo, Hannya japonés, Quetzalcóatl mesoamericano, jaguar maya, colibrí mexica, ouija como símbolo de límite, semicolon de Amy Bleuel, unalome budista, hamsa árabe, ankh egipcio, triskelion celta, valknut nórdico, dragón chino vs dragón japonés. Origen y por qué la gente lo elige en momentos clave.',
  famoso:'historia ESPECÍFICA con datos VERÍDICOS sobre el tatuaje de una celebridad REAL — actual o histórica. Rota entre personas COMPLETAMENTE distintas cada vez (jamás dos veces la misma persona seguida): LeBron James, Rihanna, Post Malone, Angelina Jolie, Tupac, Harry Styles, Robbie Williams, Kat Von D, Travis Barker, Megan Fox, David Beckham, Dwayne Johnson y su pe\'a samoano real, Justin Bieber, Bad Bunny, Peso Pluma y sus tatuajes regionales, Christian Nodal, Adele, Cardi B, Lana del Rey, Maluma, Ricky Martin, Anuel AA, Kanye West (sin tatuajes — la historia detrás), Marilyn Monroe (mancha de nacimiento que parecía tat), Frida Kahlo (sin tatuajes pero su iconografía hoy es la más tatuada del mundo). Solo datos verificables.',
  region:'la tradición ANCESTRAL del tatuaje en UNA región o cultura específica con datos arqueológicos. Cada vez una distinta: Sak Yant tailandés (monjes con barras de acero), Kakau hawaiano (extinto y revivido por Keone Nunes), Tā Moko maorí, Kalinga filipino (Whang Od, 100+ años), Tebori japonés a mano, coptos egipcios cristianos (cruz en muñeca), código del Gulag, Shuar amazónicos, Yakuza japoneses y su irezumi prohibido, Inuit del Ártico, Picts escoceses pintados de azul, Beréberes del Atlas marroquí, escitas de las estepas, Dayak de Borneo, Kayan Lahwi de Birmania (mujeres jirafa que también se tatúan), Atayal de Taiwán, Apache y Comanche en EE.UU. Datos culturales precisos.',
  idea:'una idea de tatuaje ESPECÍFICA, original y con significado profundo. NUNCA repitas. Rota categorías muy distintas: (A) NATURALEZA: constelación de tu fecha exacta, animal espíritu ancestral, árbol con raíces=fechas y ramas=nombres. (B) MEMORIA: coordenadas GPS, ECG real, huella dactilar de un familiar. (C) IDENTIDAD: frase en náhuatl, latín o sánscrito, símbolo del signo griego original, retrato de mascota fallecida. (D) ARTE: fragmento de Klimt, arquitectura de tu ciudad, compás musical de tu canción. (E) VIAJE: silueta de la montaña que escalaste, mapa del barrio. (F) MEXICANO: corazón sagrado mexica, ofrenda de día de muertos miniatura, alebrije original tuyo, fragmento del códice Mendoza, cempasúchil estilizado, Catrina de José Guadalupe Posada. (G) PERSONAL DARK: tu mayor cicatriz tatuada como decoración, fecha en romano de algo que superaste. Especifica zona del cuerpo y por qué.',
  consejo:'un consejo CONCRETO para quien va a tatuarse por primera vez. Cada vez uno DIFERENTE: (1) Espera 2 semanas entre decidir y tatuar. (2) Regla del puño para tamaño. (3) La zona importa más que el diseño. (4) Hidratación, sueño y azúcar el día antes. (5) No lleves referencia cerrada — confía en el artista. (6) Qué preguntar en la consulta. (7) Por qué barato sale caro. (8) Cuidados post 14 días. (9) Por qué no debes "regalarle" la idea a tu artista — pide cotización. (10) Qué hacer si en la sesión sientes que algo está mal. (11) Por qué nunca debes tatuarte borracho ni cruzando duelo activo. (12) Cómo elegir tu primer artista (portafolio vs precio). (13) Por qué el dolor que imaginas es peor que el real. Práctico y honesto.',
  cliente:'la experiencia EMOCIONAL específica de tatuarse. Cada vez un ángulo diferente: el momento exacto en que decides que ESTE diseño es; las horas antes de entrar al estudio; el antes/después emocional; por qué algunas personas lloran (liberación, no dolor); ver tu piel tatuada por primera vez en el espejo; explicarle a tu mamá; amar un tatuaje que nadie entiende; el silencio raro de las primeras 2 horas; sentir orgullo en la calle por algo invisible; tocar el tatuaje cicatrizado por primera vez con la palma; la primera vez que te lo elogian un extraño. Real, sin clichés.',
  tendencia:'una tendencia ACTUAL del tatuaje con nombre técnico. Rota: Ignorant Style, Botanical Fine Line, Micro-Realism, Geometric Blackwork, Anatomical Art Nouveau, Anime Realism, Vintage Flash Revival, Dark Surrealism, Lettering tipográfico, Color Bombing, Sticker Tattoo (parche imitando stickers), Patchwork (mezcla aleatoria de flash), Hand-poke revival, Tattoo Heritage (réplica de tats antiguos de tus abuelos), Cursive en mexicano-chicano nuevo, Body suit de una sola sesión maratón, AI-generated designs y la polémica, tatuajes que cambian con luz solar, white-on-black ink reverso, tatuajes ephemeral (1.5 años, Ephemeral Tattoo). Por qué crece y quién la adopta primero.',
  tribu:'la historia de UNA tribu ancestral con tatuajes verificables y épicos. Rota: Dayak de Borneo (cabezas tomadas como trofeos), Inuit (mentón = mayoría de edad), Cherokee, Amunet del Antiguo Egipto, Pictos azules de Escocia, Escitas de las estepas con animales míticos en momias, Haida del Pacífico canadiense, Mentawai de Indonesia, Maoris guerreros, Iban de Sarawak, Atayal de Taiwán (boca tatuada=adulta), Apatani de la India, Berberes del Atlas, Beduinos del Sinaí, Hawaianos antiguos, Kalinga, Yakuza como tribu urbana moderna, Pachuco-cholo en EE.UU.-México como tribu identitaria. Datos verificables.',
  psicologia:'aspecto ESPECÍFICO de la psicología del tatuaje con base en estudios reales. Rota ángulo: tatuajes y ansiedad social, coleccionismo positivo, terapia de exposición, predictores de arrepentimiento, arquetipos dominantes (león/águila/serpiente), tolerancia al riesgo, la piel como lienzo único, el efecto identidad post-tatuaje (estudios de Anne Velliquette), la dopamina de tatuarse y por qué es adictivo sin ser droga, autoestima y tatuaje en mujeres mayores de 40 (estudio Galway 2017), tatuajes después de duelo y sus efectos en cierre psicológico documentado.',
  encuesta:'encuesta con DOS opciones OPUESTAS, divertidas e interesantes. Cada vez tema DIFERENTE: ¿5 min o 8 hrs? / ¿Diseño del artista o tu idea? / ¿Joven-pasado o adulto-presente? / ¿Solo tú lo ves o todos lo ven? / ¿Negro sólido o full color? / ¿Uno enorme o diez pequeños? / ¿Con fecha o sin fecha? / ¿Único de artista o flash? / ¿Primero arte o primero artista? / ¿Tatúate ya o esperas 6 meses? / ¿En español o en otro idioma? / ¿Algo de tu mamá o algo tuyo? / ¿Dolor concentrado en 1 hora o esparcido en 5? / ¿Algo místico o algo terrenal? / ¿Color rojo o color negro? / ¿Algo prehispánico o algo japonés? Las dos opciones con emoji.',
  confiesa:'invitación íntima a confesar algo sobre tatuajes. Cada vez ángulo DIFERENTE: ¿Le ocultaste tu primer tatuaje? / ¿Tienes uno que ya no eres tú? / ¿Cuántas horas te tomó decidirte? / ¿Cancelaste citas? cuántas / ¿Tienes uno secreto en zona oculta? / ¿Tu familia aún no sabe? / ¿Tatuaste a alguien que ya no está en tu vida? / ¿Tu más barato es tu favorito? / ¿Tienes un boceto guardado más de un año? / ¿Le mentiste a tu mamá sobre uno? / ¿Te tatuaste a escondidas a los 17? / ¿Te arrepientes pero no lo borrarías? / ¿Tienes un dueño moral del tatuaje aunque sea tuyo? Sin juicio.',
  mitoregional:'creencia popular sobre tatuajes en una cultura específica, MUY MEXICANA cuando sea posible. Rota: México: tatuar nombre de pareja trae mala suerte (origen y veracidad estadística). Japón: prohibición en onsen y templos. Tailandia: Sak Yant pierden poder con mala conducta. Colombia: Semana Santa. Brasil: tatuajes asociados a grupos. México pueblerino: tatuarse en luna llena vs nueva. Veracruz: leyenda local sobre tatuajes en marineros. Norte de México: tatuajes y narcocultura — el mito vs la realidad. Centroamérica: marcas del MS-13 y por qué cualquier civil con esos diseños arriesga la vida. Yucatán: tatuajes mayas y permiso ancestral. Origen del mito y dato real.',
  cultpop:'historia de UN tatuaje icónico de cultura pop con datos REALES y VERIFICABLES. Rota personas y obras DISTINTAS: Johnny Depp y cómo borró el de Winona Ryder, Lady Gaga y el verso de Rilke, Amy Winehouse, Mike Tyson y el artista maorí real (S. Victor Whitmill), David Beckham, Dwayne Johnson y su pe\'a samoano, Ozzy, Justin Bieber y los 90+ tatuajes, Bad Bunny y los tatuajes que cubrió, Peso Pluma y lo que tatúa de su carrera, Christian Nodal y los tatuajes faciales que polarizan México, Ariana Grande y sus errores ortográficos en japonés (la historia del 七輪), 50 Cent, Eminem, Drake, Cardi B y la rosa de la espalda. Solo verificables.',
  sabias:'un "¿Sabías que...?" VERIFICABLE y sorprendente. Rota ángulo COMPLETO cada vez: (A) ARQUEOLOGÍA: Ötzi y sus 61 tatuajes (5300 años), momias Chinchorro, Paracas. (B) GEOGRAFÍA: país con más tatuados (Italia o EE.UU. dependiendo del estudio). (C) BIOLOGÍA: macrófagos y permanencia. (D) RÉCORD: récords Guinness verificables (Lucky Diamond Rich, Etienne Dumont). (E) LEGAL: prohibiciones en Irán, Corea del Norte, ciertas ramas militares. (F) HISTORIA: primer libro de tatuajes occidental. (G) SOCIOLOGÍA: estudios de empleabilidad recientes. (H) MEXICANA: el primer tatuador profesional documentado en México y la fecha. (I) ANIMAL: que el tatuaje no es solo humano — pesca regulada con peces marcados. NUNCA UV.',
  interactivo:'pregunta DIRECTA que invite a responder en una frase. Rota cada vez con ángulos completamente diferentes: ¿Cuál fue el primer tat que quisiste y nunca te hiciste? / ¿Qué palabra llevarías toda la vida? / ¿Qué animal te representa hoy, no ayer? / ¿Qué coordenadas? / ¿Qué parte de tu historia merece tinta? / ¿Qué le tatuarías a tu yo de hace 10 años? / ¿En qué idioma tatuarías una frase? / ¿Tatuaje en zona visible o escondida? / ¿Si pudieras borrar uno cuál sería? / ¿Qué fecha llevas o llevarías? / ¿Qué canción tatuarías como letra? / ¿Qué te impide tatuarte hoy mismo? / ¿Cuál es tu próximo tat ya pensado? Inesperada, no genérica.',
  inspiracion:'historia REAL o arquetípica de transformación a través de un tatuaje. Rota ángulo: (A) cicatrices de cirugía cardíaca o mastectomía convertidas en arte. (B) primer acto de autonomía a los 18. (C) fecha de superar adicción. (D) madres que tatúan ECG del bebé. (E) veteranos procesando trauma en piel. (F) nombre de quien perdiste. (G) amor propio post-inseguridad. (H) tatuaje como cierre de duelo migratorio (mexicanos en EE.UU. tatuándose la patria). (I) supervivientes de violencia que retoman su cuerpo con tinta. (J) personas trans que estrenan piel con tatuaje afirmativo. Real, jamás cursi.',
  curiosidad:'hecho COMPLETAMENTE DESCONOCIDO sobre tatuajes que ninguna cuenta repite. Ángulos únicos: arqueología (momias Paracas, Chinchorro, Pazyryk con tatuaje de venado), forense (casos donde tats identificaron víctimas — caso Adam de la Torre del Támesis), biología molecular (proteína responsable), historia del arte (Renacentistas con tatuajes ocultos), economía (industria 3 mil M USD en EE.UU.), sociología (estudio de salario), geografía (la isla con la mayor densidad de tatuadores per cápita), antropología (los pueblos donde NUNCA hubo tradición de tatuaje y por qué). Único y específico.',
  proceso:'el proceso de hacerse un tatuaje desde la perspectiva del cliente. Cada vez aspecto DIFERENTE: (1) la consulta previa y por qué importa más que el tatuaje. (2) cómo el artista adapta el diseño a tu curva. (3) por qué el boceto digital nunca es igual al real. (4) las 4 etapas de cicatrización. (5) los retoques no son error. (6) cómo la piel absorbe pigmento según zona, edad y tono. (7) qué pasa en tu cabeza minuto a minuto en una sesión de 4 horas. (8) por qué la postura del cuerpo afecta el resultado. (9) los tatuadores que usan stencil digital vs los que dibujan a mano libre encima. (10) por qué la sangre que sale durante el tatuaje es buena señal. Sin tecnicismos, desde el cliente.',
  ritual:'el ritual personal o cultural alrededor de tatuarse. Rota: (A) por qué muchos se tatúan en silencio sin avisar. (B) ayuno espiritual de Sak Yant. (C) grupos de amigos con rituales compartidos. (D) marineros del XIX y código de tatuajes por cada océano cruzado. (E) en algunas culturas el dolor ES el ritual. (F) mirarse al espejo por primera vez. (G) el ritual mexicano de tatuarse el día del cumpleaños como renacimiento. (H) tatuarse después de un duelo como ritual de cierre. (I) tatuarse al cumplir 50 años como segunda juventud. (J) los rituales con copal, sahumerio o tabaco antes de tatuarse en culturas indígenas. Íntimo y cultural.',
  significado:'el significado OCULTO de un diseño común. Rota: rosa con espinas (luto victoriano, no amor), reloj detenido (Dickens), mariposa monarca (migración México-EE.UU.), diente de león que se dispersa (dejar ir), semicolon (Amy Bleuel, 2013, salud mental), unalome budista, brújula náutica (perdido, no aventura), corazón sagrado mexicano (no romántico — devoción cristiana), calavera mexicana sonriente (no muerte — celebración), ancla con cuerda rota (libertad, no estabilidad), llave sin candado (esperanza), mariposa en general (no transformación banal — alma de los muertos en culturas mayas), olas japonesas (no mar — la impermanencia budista), peonía japonesa (riqueza, no belleza). Origen cultural real.',
  comparacion:'comparación FASCINANTE entre dos formas de vivir el tatuaje. Rota: con significado vs estético — cuál envejece mejor emocionalmente. Visible vs oculto — qué dice según estudios. Único de artista vs flash. Joven vs +50. Occidente vs Asia. Sesión única vs proyecto multi-año. Tatuajes en hombre vs mujer en estudios sociológicos. Tatuajes en zonas dolorosas vs zonas suaves — quién elige qué. Tatuaje en pareja vs tatuaje individual — tasa de arrepentimiento real. Tatuaje espontáneo (en vacaciones) vs planeado años — cuál se ama más con el tiempo. Tatuaje grande primero vs pequeño primero — psicología de cada uno.',
  filosofia:'reflexión filosófica sobre tatuajes. Rota: (1) la única forma de arte que muere contigo. (2) marcar el cuerpo como acto político. (3) lo permanente en un cuerpo que cambia — la paradoja. (4) el único arte cuyo proceso duele. (5) decorar vs habitar el cuerpo. (6) autobiografía visible que el tiempo reescribe. (7) resistencia al olvido. (8) el cuerpo como museo curado por uno mismo. (9) tatuarse es responder a la pregunta "¿qué quiero recordar cuando ya no recuerde nada más?". (10) por qué nadie se tatúa "para nadie" — siempre es un mensaje a algo o alguien, aunque sea uno mismo. Profunda sin ser pretenciosa.',
  colores:'historia y simbolismo de UN color en tatuajes. Rota: negro (universal, la base), rojo carmesí (irezumi japonés, vida y sangre), blanco (técnicamente difícil, pieles oscuras), verde (celta y druida, sagrado), azul marino (marineros XIX), dorado (realeza tailandesa), morado (lealtad y luto en algunas culturas), naranja (sol en culturas mexicas), turquesa (chamanismo navajo y huichol), amarillo (oro maya y dificultad en piel), gris (todos los gris-wash y cómo se logra), rosa (su connotación moderna en tatuajes feministas). Sin tintas UV ni fluorescentes.',
  dolor:'aspecto específico del dolor en tatuajes. Rota: (1) mapa real del dolor según densidad nerviosa (zonas peor: costillas, esternón, ingle, codo interno). (2) por qué el mismo tat duele distinto en personas con misma tolerancia. (3) por qué muchos lo describen como adictivo y liberador. (4) tatuarse sobre zona ya tatuada duele diferente. (5) tatuadores que usan música y respiración. (6) dolor agudo inicial vs ardor continuo y qué indica. (7) por qué los hombres no aguantan más que las mujeres (ginecólogos confirman umbral femenino mayor por evolución). (8) cómo el ciclo menstrual cambia el dolor. (9) por qué dormir mal duplica la sensación de dolor. Sin drama.',

  // ── 12 NUEVOS TEMAS MUCHO MÁS INTERESANTES ───────────────────────────
  mexico:'una historia del MÉXICO TATUADOR profundo y poco contado, con datos reales. Rota: el primer estudio formal de tatuaje en México (Tinta Mortal en CDMX, años 90), Mister Cartoon y la conexión chicana México-LA, los tatuajes de Tijuana en los 70 y los marines de San Diego, el chicano black and grey nacido en cárceles californianas con presos mexicanos, los tatuajes en Ciudad Juárez como cicatriz de la guerra al narco, la escena del tatuaje en Mérida vs CDMX vs Tijuana, los tatuajes huicholes de peyote en San Luis Potosí, las mujeres tatuadoras pioneras mexicanas (Kat Von D nació en Monterrey), la lucha de los tatuadores mexicanos por ser arte y no estigma. NUNCA generalidades — datos, lugares, nombres reales.',
  prehispanico:'el mundo del tatuaje y la marca corporal en las culturas PREHISPÁNICAS de Mesoamérica con datos arqueológicos verificables. Rota: los olmecas y sus modificaciones corporales documentadas en figurillas, los mayas y la práctica del "ch\'ah" (escarificación ritual con punzones de hueso), los mexicas con guerreros águila y jaguar marcados, los códices que muestran sacerdotes con marcas en cara, los huicholes y sus tatuajes con peyote como puente con Tatewari, los teotihuacanos con marcas faciales documentadas en murales, los zapotecas, los purépechas, las prácticas de cráneo deformado y su relación con el tatuaje como "marca del cuerpo elegido". Cita códices, sitios arqueológicos y fuentes (Sahagún, Códice Florentino). Que sea épico y verificable.',
  narcocultura:'el mundo de los tatuajes en la NARCOCULTURA mexicana, sin glorificar ni demonizar — solo el dato real. Rota: el santo informal Jesús Malverde y sus tatuajes en Sinaloa, la Santa Muerte y el código de colores tatuados (rojo amor, dorado dinero, blanco protección), los tatuajes de "M" para los Zetas y por qué portarlos hoy es sentencia de muerte si el grupo cambió, los corridos hechos tatuaje (verses de Chalino Sánchez tatuados), la diferencia entre tatuaje narco real y estética narco que adopta civiles que no entienden el riesgo, por qué un tatuaje del 7-7 puede confundirse con afiliación, las reglas tácitas de qué un civil NO debe tatuarse en zonas calientes de México. Sin moralizar, datos puros y útiles para entender riesgo cultural real.',
  luchalibre:'el mundo de los tatuajes inspirados en la LUCHA LIBRE MEXICANA. Rota: las máscaras tatuadas (El Santo, Blue Demon, Mil Máscaras, Místico, Rey Mysterio, Pentagón, Psycho Clown, La Parka), por qué tatuarse máscara de luchador desenmascarado es tabú en la cultura lucha-libre, la historia del Santo y por qué su tatuaje es el más popular en hombres mexicanos +40, los tatuajes de las arenas (México, Coliseo, Naucalpan), la conexión entre lucha libre y tatuaje chicano en LA, las luchadoras tatuadas y la resistencia femenina en el ring (Sexy Star, Lady Apache), los códigos de respeto: nunca tatuar la máscara de un luchador activo sin permiso. Datos reales con nombres y arenas.',
  leyenda:'una LEYENDA URBANA o histórica mexicana relacionada al tatuaje o que se tatúa hoy. Rota: La Llorona y por qué su tatuaje creció en mujeres post-2010, El Charro Negro de Guanajuato, el Nahual y los tatuadores indígenas que aún hoy hacen "tatuajes nahuales" en Oaxaca, la leyenda del Tlahuelpuchi en Tlaxcala, el Sombrerón yucateco, la leyenda de la Mulata de Córdoba (Veracruz) y por qué se tatúa en el puerto, el Cadejo, el Cipitío, la Siguanaba salvadoreña que llega tatuada a México, la Leyenda del Popocatépetl e Iztaccíhuatl como tatuaje de pareja en CDMX. Cita la región exacta y el origen del relato.',
  prison:'el mundo del tatuaje CARCELARIO con códigos visuales reales y verificables. Rota: el lenguaje de los puntos en los nudillos rusos, las telarañas en el codo y qué significa según el país (México vs EE.UU. vs Rusia: distinto), los lágrimas tatuadas y por qué su lectura ha cambiado, el código de la EME (Mexican Mafia) y por qué es peligroso copiarlo en libertad, los tatuajes con tinta improvisada (ceniza, máquinas con motor de cassette), la historia de Norman Reedus en cárcel-tatuajes para Walking Dead vs los tatuajes carcelarios reales, los tatuajes de cristianismo carcelario en México (Cristo coronado, manos rezando con rosario), por qué ningún tatuador profesional copia un diseño claramente carcelario sin avisar al cliente del riesgo. Datos verificables.',
  oscuro:'el LADO OSCURO del mundo del tatuaje que casi nadie cuenta. Rota: tatuadores estafadores y cómo detectarlos antes (luces, banner, redes sociales), las máquinas y tintas de Wish y la epidemia de infecciones graves en México 2022-2023, casos reales de tatuajes hechos a la fuerza (víctimas de trata marcadas), la mafia china de las tintas adulteradas con metales pesados, los "tatuadores fantasma" que hacen casas itinerantes sin licencia sanitaria, casos verificables de hepatitis C contraída por aguja sin esterilizar en Latinoamérica, el debate ético de tatuar a alguien obviamente borracho o drogado, el caso del tatuador que tatuó "Devast8" en la frente de un cliente menor de edad en Nueva Zelanda y la responsabilidad legal posterior. Útil y verificable, no morboso.',
  amor:'una historia ESPECÍFICA sobre tatuajes y AMOR o PÉRDIDA. Rota: las parejas que se tatuaron y siguen juntos 30 años después (tasa real: 16% según estudios), las que se tatuaron y se borraron (Johnny Depp-Winona, Angelina-Billy Bob, Marc Anthony-Jennifer Lopez), tatuajes para hijos perdidos en parto (las constelaciones del día exacto), tatuajes para abuelas con su receta a mano del recetario, tatuajes para mascotas fallecidas y la psicología detrás, los gemelos que se tatúan iguales en el mismo cumpleaños, las amistades de 20 años que se tatúan algo solo entre ellas, tatuajes para alguien que ya no te habla pero a quien decides honrar, el primer tatuaje después de un divorcio como acto de re-fundación. Real y emocional, no cursi.',
  cuerpo:'cómo el TATUAJE INTERACTÚA con el cuerpo vivo. Rota: tatuajes en el embarazo y cómo se estiran después (zonas seguras y zonas que casi siempre se deforman), tatuajes en zonas que pierden grasa con la edad (mejillas, mano, antebrazo interno), tatuajes y ejercicio extremo (powerlifters y la deformación por hipertrofia), tatuajes y pérdida de peso radical (qué pasa con un tat de 30cm si pierdes 40 kg), tatuajes en piel con cicatrices de acné severo (puede mejorarlas o empeorarlas según técnica), cómo cambia un tatuaje a los 5, 10, 20 y 40 años, qué zonas casi nunca pierden detalle (hombro, gemelo) vs qué zonas siempre se ven mal a los 15 años (dedos, palma, planta del pie), tatuajes en personas con vitíligo y la decisión ética del artista. Datos clínicos reales.',
  dinero:'el DINERO real del mundo del tatuaje, con cifras MX y verificables. Rota: cuánto cuesta una hora con los mejores tatuadores de México vs internacionales (Mister Cartoon $1500-$3000 USD/hora, mexicanos top $2000-$8000 MXN/hora), por qué el precio sube exponencialmente con el portafolio y no con la habilidad técnica únicamente, cuánto gana realmente un tatuador en un estudio compartido en CDMX (la cifra menos sexy de lo que parece), el costo real de abrir un estudio legal en México (Cofepris, registro, equipo, $300-$500 mil MXN), los tatuajes más caros del mundo cobrados (el "Diamond Tattoo" con 612 diamantes incrustados, $924 mil USD), por qué nunca hay que negociar precio en tatuaje (impacto en calidad), el modelo de negocio "guest spot" y cómo viven los tatuadores que viajan, propinas en tatuaje: 15-25% es estándar global, en México aún se debate. Cifras y nombres reales.',
  ciencia:'CIENCIA VERIFICABLE detrás de los tatuajes. Rota: por qué los tatuajes son permanentes (macrófagos atrapados con tinta para siempre, descubrimiento de Sandrine Henri 2018), por qué el láser de remoción funciona (fragmenta partículas a tamaño que el cuerpo finalmente puede limpiar), la composición real de la tinta negra (carbón, no "tinta china" como se cree), tintas con metales pesados y los estudios de la EU 2022 que prohibieron 4000 sustancias, por qué la piel del antebrazo retiene más tinta que la del codo, el sistema linfático y por qué los ganglios de personas tatuadas pueden mostrar pigmento años después (estudio publicado en Nature 2017), por qué los tatuajes blancos eventualmente se ven amarillos (oxidación del dióxido de titanio), la genética y por qué algunas personas cicatrizan con queloide. Sin pseudociencia.',
  errores:'ERRORES REALES en el mundo del tatuaje, contados como advertencia útil. Rota: el "No Ragrets" de We\'re the Millers como meme pero existe: hay un caso real de Brian Lambert con error similar permanente. Los tatuajes en chino que dicen otra cosa (Britney Spears con 異 que significa "extraño" en lugar de "místico"), los tatuajes en árabe que están al revés porque el artista no sabe el sentido de la lectura, las firmas en cursiva donde sobra una letra, los retratos de mascotas que terminan parecidos a un primate, los nombres con acento ortográfico equivocado, los tatuajes en latín que copian Google Translate y dicen otra cosa (estudios de la U. de Cambridge documentan 22% de errores en tatuajes en latín), las coordenadas tatuadas que en realidad apuntan al océano. Sin burlarse — útil.',
  primero:'PRIMERAS VECES épicas y documentadas en el mundo del tatuaje. Rota: el primer tatuaje del que hay evidencia humana (Ötzi, 5300 años, descubierto 1991 en los Alpes), la primera mujer tatuadora occidental documentada (Maud Wagner, 1907), el primer estudio de tatuaje en Estados Unidos (Martin Hildebrandt, NYC 1846), el primer tatuaje de máquina eléctrica (Samuel O\'Reilly, 1891, basado en una pluma de Edison), la primera convención de tatuaje del mundo (Houston, 1976), el primer mexicano en ganar un primer lugar en convención mundial, la primera vez que un presidente de un país tuvo tatuaje visible reconocido (Theodore Roosevelt con escudo familiar en el pecho), el primer tatuaje en mostrarse en TV abierta sin censura, la primera mujer presidenta con tatuaje visible. Fechas, nombres y lugares reales verificables.'
};
var toneMap={storytelling:'narrativo, evocador',educativo:'informativo y claro',personal:'en primera persona, cercano',misterioso:'intrigante y poético'};
var bgList=['photo','ink','fire','smoke','sakura','geo','lightning','matrix','blood','neon','stars','waves','lava','circuit','aurora','vortex','ink2','tribal','galaxy','sandstorm','glitch','dragonscale','bokeh','redmoon'];
var DAYS=['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'];
var TIMES=['8:00 AM','1:00 PM','7:00 PM'];
var TYPES=Object.keys(typeMap);
var EW=1080,EH=1920;
var VID_DURATION=15000; // 15 seconds
var VID_FPS=24;

// ── FONTS ─────────────────────────────────────────────
function loadFonts(){
  if(fontsReady)return Promise.resolve();
  return Promise.all([
    new FontFace('Noto Serif JP','url(https://fonts.gstatic.com/s/notoserifjp/v30/xn7mYHs72GKoTvER4Gn3b5eMZBaPRkgfDMh8MA.woff2)',{weight:'900'}).load(),
    new FontFace('Space Mono','url(https://fonts.gstatic.com/s/spacemono/v13/i7dPIFZifjKcF5UAWdDRUEZ2RQ.woff2)',{weight:'400'}).load(),
    new FontFace('DM Sans','url(https://fonts.gstatic.com/s/dmsans/v14/rP2Hp2ywxg089UriCZOIHQ.woff2)',{weight:'300'}).load(),
    new FontFace('Cinzel','url(https://fonts.gstatic.com/s/cinzel/v23/8vIU7ww63mVu7gtL-ATkAA.woff2)',{weight:'400'}).load()
  ]).then(function(ff){ff.forEach(function(f){document.fonts.add(f);});fontsReady=true;}).catch(function(){fontsReady=true;});
}

