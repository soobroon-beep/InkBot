document.getElementById('s-hdl').textContent='@victortip';
loadSaved();buildWeek();buildSchedule();buildAsianSVG();
setTimeout(function(){startBg('photo');},100);
loadFonts();

// ── ASIAN BORDER SVG ──────────────────────────────────
function buildAsianSVG(){drawAsianSVG(document.getElementById('asian-svg'),270,480);}
function drawAsianSVG(el,W,H){
  el.innerHTML='';var c='rgba(204,0,0,0.55)';var m=9,inn=5;
  function mk(tag,a){var e=document.createElementNS('http://www.w3.org/2000/svg',tag);Object.keys(a).forEach(function(k){e.setAttribute(k,a[k]);});return e;}
  el.appendChild(mk('rect',{x:m,y:m,width:W-m*2,height:H-m*2,fill:'none',stroke:c,'stroke-width':'1'}));
  el.appendChild(mk('rect',{x:m+inn,y:m+inn,width:W-m*2-inn*2,height:H-m*2-inn*2,fill:'none',stroke:c,'stroke-width':'0.5','stroke-dasharray':'3 4','stroke-opacity':'0.5'}));
  [[m,m],[W-m,m],[m,H-m],[W-m,H-m]].forEach(function(p){el.appendChild(mk('rect',{x:p[0]-3,y:p[1]-3,width:6,height:6,fill:c,'fill-opacity':'0.8'}));});
  var bl=18;[[m,m,1,0],[m,m,0,1],[W-m,m,-1,0],[W-m,m,0,1],[m,H-m,1,0],[m,H-m,0,-1],[W-m,H-m,-1,0],[W-m,H-m,0,-1]].forEach(function(d){el.appendChild(mk('line',{x1:d[0],y1:d[1],x2:d[0]+d[2]*bl,y2:d[1]+d[3]*bl,stroke:c,'stroke-width':'1.5'}));});
  [H*.32,H*.68].forEach(function(by){el.appendChild(mk('path',{d:'M'+m+' '+(by-6)+' L'+(m-5)+' '+by+' L'+m+' '+(by+6),fill:'none',stroke:c,'stroke-width':'1'}));el.appendChild(mk('path',{d:'M'+(W-m)+' '+(by-6)+' L'+(W-m+5)+' '+by+' L'+(W-m)+' '+(by+6),fill:'none',stroke:c,'stroke-width':'1'}));});
  var cx=W/2,da=5;el.appendChild(mk('polygon',{points:cx+','+(m-da)+' '+(cx+da)+','+m+' '+cx+','+(m+da)+' '+(cx-da)+','+m,fill:c,'fill-opacity':'0.7'}));el.appendChild(mk('polygon',{points:cx+','+(H-m-da)+' '+(cx+da)+','+(H-m)+' '+cx+','+(H-m+da)+' '+(cx-da)+','+(H-m),fill:c,'fill-opacity':'0.7'}));
  function sakura(px,py,r){for(var i=0;i<5;i++){var a=i/5*Math.PI*2;var ex=(px+Math.cos(a)*r*.7+px+Math.cos(a)*r)/2,ey=(py+Math.sin(a)*r*.7+py+Math.sin(a)*r)/2;el.appendChild(mk('ellipse',{cx:ex,cy:ey,rx:r*.22,ry:r*.13,transform:'rotate('+(a*180/Math.PI+90)+' '+ex+' '+ey+')',fill:c,'fill-opacity':'0.3'}));}}
  sakura(m+28,m+26,9);sakura(W-m-28,m+26,9);sakura(m+28,H-m-26,9);sakura(W-m-28,H-m-26,9);
  el.appendChild(mk('path',{d:'M'+(m+13)+','+(m+13)+' Q'+(m+38)+','+(m+18)+' '+(m+48)+','+(m+40),fill:'none',stroke:c,'stroke-width':'0.5','stroke-opacity':'0.4'}));
  el.appendChild(mk('path',{d:'M'+(W-m-13)+','+(m+13)+' Q'+(W-m-38)+','+(m+18)+' '+(W-m-48)+','+(m+40),fill:'none',stroke:c,'stroke-width':'0.5','stroke-opacity':'0.4'}));
  var lx=W-m-30,ly=m+36;el.appendChild(mk('rect',{x:lx-5,y:ly,width:10,height:13,rx:'3',fill:'none',stroke:c,'stroke-width':'0.7','stroke-opacity':'0.45'}));el.appendChild(mk('line',{x1:lx,y1:ly-2,x2:lx,y2:ly,stroke:c,'stroke-width':'0.7','stroke-opacity':'0.45'}));el.appendChild(mk('line',{x1:lx,y1:ly+13,x2:lx,y2:ly+17,stroke:c,'stroke-width':'0.7','stroke-opacity':'0.45'}));
}

// ── FEEDBACK MEMORY ── persists what the user liked/disliked so AI learns
var feedbackMem={liked:{},disliked:{},recentBodies:[],likedBodies:{},dislikedBodies:{}};

// ── SAVE/LOAD ─────────────────────────────────────────
function loadSaved(){
  try{
    var s=JSON.parse(localStorage.getItem('inkbot_pro')||'{}');
    if(s.key)document.getElementById('api-key').value=s.key;
    if(s.prov)document.getElementById('api-provider').value=s.prov;
    if(s.handle){document.getElementById('handle').value=s.handle;document.getElementById('s-hdl').textContent=s.handle;}
    if(s.ctx)document.getElementById('ctx').value=s.ctx;
    if(s.logo){logoUrl=s.logo;applyLogo(s.logo);}
    if(s.bank)bank=s.bank;
    if(s.feedbackMem)feedbackMem=Object.assign({liked:{},disliked:{},recentBodies:[],likedBodies:{},dislikedBodies:{}},s.feedbackMem);
  }catch(e){}
  renderBank();
}
function save(){
  try{
    localStorage.setItem('inkbot_pro',JSON.stringify({
      key:document.getElementById('api-key').value,
      prov:document.getElementById('api-provider').value,
      handle:document.getElementById('handle').value,
      ctx:document.getElementById('ctx').value,
      logo:logoUrl,
      bank:bank,
      feedbackMem:feedbackMem
    }));
  }catch(e){}
}
['api-key','api-provider','handle','ctx'].forEach(function(id){document.getElementById(id).addEventListener('change',save);document.getElementById(id).addEventListener('input',function(){save();if(id==='handle')document.getElementById('s-hdl').textContent=this.value;});});

// ── TABS ──────────────────────────────────────────────
document.querySelectorAll('.tab').forEach(function(btn){btn.addEventListener('click',function(){document.querySelectorAll('.tab').forEach(function(b){b.classList.remove('active');});btn.classList.add('active');document.querySelectorAll('.pane').forEach(function(p){p.classList.remove('active');});document.getElementById('pane-'+btn.dataset.tab).classList.add('active');});});

// ── PILLS ─────────────────────────────────────────────
function initPills(id,cb){document.querySelectorAll('#'+id+' .pill').forEach(function(p){p.addEventListener('click',function(){document.querySelectorAll('#'+id+' .pill').forEach(function(x){x.classList.remove('on');});p.classList.add('on');cb(p.dataset.val);});});}
initPills('type-pills',function(v){selType=v;});
initPills('bg-pills',function(v){selBg=v;startBg(v);});
initPills('tone-pills',function(v){selTone=v;});

// ── PHOTOS ────────────────────────────────────────────
document.getElementById('photo-input').addEventListener('change',function(e){Array.from(e.target.files).forEach(function(f){var r=new FileReader();r.onload=function(ev){photos.push(ev.target.result);renderPhotos();if(selBg==='photo')startBg('photo');};r.readAsDataURL(f);});});
function renderPhotos(){var g=document.getElementById('pgrid');g.innerHTML='';photos.forEach(function(url,i){var d=document.createElement('div');d.className='pt'+(i===pidx?' on':'');d.innerHTML='<img src="'+url+'"><div class="pt-x">x</div>';(function(idx){d.querySelector('img').addEventListener('click',function(){pidx=idx;renderPhotos();if(selBg==='photo')startBg('photo');});d.querySelector('.pt-x').addEventListener('click',function(e){e.stopPropagation();photos.splice(idx,1);if(pidx>=photos.length)pidx=Math.max(0,photos.length-1);renderPhotos();if(selBg==='photo')startBg('photo');});})(i);g.appendChild(d);});document.getElementById('pcount').textContent=photos.length?photos.length+' foto'+(photos.length>1?'s':''):'';document.getElementById('analyze-wrap').style.display=photos.length?'block':'none';}

// ── LOGO ──────────────────────────────────────────────
document.getElementById('logo-input').addEventListener('change',function(e){var f=e.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(ev){logoUrl=ev.target.result;applyLogo(logoUrl);save();};r.readAsDataURL(f);});
function applyLogo(url){document.getElementById('logo-prev').src=url;document.getElementById('logo-prev').style.display='block';document.getElementById('logo-txt').textContent='✓ Logo cargado';logoImg=new Image();logoImg.onload=function(){document.getElementById('s-logo').src=url;document.getElementById('s-logo').style.display='block';};logoImg.src=url;}

// ── ANALYZE ───────────────────────────────────────────
// FreeModel.dev usa keys con prefijo fe_oa_ y habla el mismo protocolo
// (Anthropic Messages API) pero en cc.freemodel.dev en vez de api.anthropic.com
function anthropicEndpoint(key){return (key&&key.indexOf('fe_oa_')===0)?'https://cc.freemodel.dev/v1/messages':'https://api.anthropic.com/v1/messages';}
document.getElementById('btn-analyze').addEventListener('click',function(){var key=getKey();if(!key){setSt('st-gen','Ingresa API Key','err');return;}if(!photos.length)return;setSt('st-gen','Analizando...','ld');analyzeImg(key,photos[pidx].split(',')[1],'image/jpeg').then(function(d){document.getElementById('tat-desc').value=d;goTab('caption');setSt('st-gen','✓ Listo','ok');}).catch(function(){setSt('st-gen','Error','err');});});
document.getElementById('cap-photo').addEventListener('change',function(e){var f=e.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(ev){var url=ev.target.result;capB64=url.split(',')[1];capMime=f.type;document.getElementById('cap-prev').src=url;document.getElementById('cap-prev').style.display='block';document.getElementById('cap-ptxt').textContent='✓ Cargada';var key=getKey();if(!key)return;document.getElementById('abox').style.display='block';document.getElementById('ares').textContent='Analizando...';analyzeImg(key,capB64,f.type).then(function(d){document.getElementById('ares').textContent=d;document.getElementById('tat-desc').value=d;}).catch(function(){document.getElementById('ares').textContent='No se pudo analizar.';});};r.readAsDataURL(f);});
function analyzeImg(key,b64,mime){if(document.getElementById('api-provider').value==='gemini')return callGemini(key,null,b64,mime,'Analiza este tatuaje. Describe: estilo, elementos, colores, zona del cuerpo. Máximo 3 oraciones. Solo la descripción.');return fetch(anthropicEndpoint(key),{method:'POST',headers:{'Content-Type':'application/json','x-api-key':key,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:280,messages:[{role:'user',content:[{type:'image',source:{type:'base64',media_type:mime,data:b64}},{type:'text',text:'Analiza este tatuaje. Describe: estilo, elementos, colores, zona del cuerpo. Máximo 3 oraciones. Solo la descripción.'}]}]})}).then(function(r){return r.json();}).then(function(d){if(d.error)throw new Error(d.error.message);return d.content[0].text;});}

// ── CANVAS BG PREVIEW ────────────────────────────────
var cv=document.getElementById('cv'),ctx=cv.getContext('2d');
function resizeCv(){cv.width=cv.offsetWidth*(window.devicePixelRatio||1);cv.height=cv.offsetHeight*(window.devicePixelRatio||1);ctx.scale(window.devicePixelRatio||1,window.devicePixelRatio||1);}
function stopAnim(){if(animId!==null){if(animId<1e10)cancelAnimationFrame(animId);else clearTimeout(animId);animId=null;}}
function startBg(type){stopAnim();resizeCv();var W=cv.offsetWidth,H=cv.offsetHeight;if(type==='photo'){if(!photos.length){startBg('ink');return;}var img=new Image();img.onload=function(){drawPhoto(ctx,img,W,H);};img.src=photos[pidx];animId=setTimeout(function(){pidx=(pidx+1)%photos.length;startBg('photo');},9000);return;}
var bgFn=bgAnimFunctions[type];if(bgFn)bgFn(ctx,W,H,function(id){animId=id;});else{animInk(ctx,W,H,function(id){animId=id;});}
}
function drawPhoto(c,img,W,H){c.clearRect(0,0,W,H);c.fillStyle='#080808';c.fillRect(0,0,W,H);var sc=Math.max(W/img.width,H/img.height);c.drawImage(img,(W-img.width*sc)/2,(H-img.height*sc)/2,img.width*sc,img.height*sc);var v=c.createRadialGradient(W/2,H/2,H*.05,W/2,H/2,H*.9);v.addColorStop(0,'rgba(0,0,0,.4)');v.addColorStop(1,'rgba(0,0,0,.85)');c.fillStyle=v;c.fillRect(0,0,W,H);var bg=c.createLinearGradient(0,H*.4,0,H);bg.addColorStop(0,'transparent');bg.addColorStop(1,'rgba(60,0,0,.6)');c.fillStyle=bg;c.fillRect(0,0,W,H);}

// ── ALL BG ANIMATION FUNCTIONS ────────────────────────
var bgAnimFunctions={};

function animInk(c,W,H,cb){
  var drops=[];for(var i=0;i<22;i++)drops.push({x:Math.random()*W,y:Math.random()*H,r:Math.random()*50+10,vx:(Math.random()-.5)*.22,vy:Math.random()*.3+.05,op:Math.random()*.28+.07,hue:Math.random()<.65?0:(Math.random()<.5?15:120),life:Math.random()*300,max:220+Math.random()*200,born:Math.random()*200});
  var rafId;
  function f(){c.clearRect(0,0,W,H);c.fillStyle='#080808';c.fillRect(0,0,W,H);var g=c.createRadialGradient(W*.5,H*.25,0,W*.5,H*.25,W*.75);g.addColorStop(0,'rgba(100,0,0,.18)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);drops.forEach(function(p){p.life++;if(p.life<p.born)return;var prog=(p.life-p.born)/p.max;if(prog>1){p.x=Math.random()*W;p.y=-30;p.born=0;p.life=0;p.max=220+Math.random()*200;return;}p.x+=p.vx;p.y+=p.vy;var fade=prog<.2?prog/.2:prog>.75?(1-prog)/.25:1;var gr=c.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*(1+prog*.6));gr.addColorStop(0,'hsla('+p.hue+',90%,'+(p.hue===0?14:28)+'%,'+p.op*fade+')');gr.addColorStop(1,'transparent');c.fillStyle=gr;c.beginPath();c.arc(p.x,p.y,p.r*(1+prog*.6),0,Math.PI*2);c.fill();});rafId=requestAnimationFrame(f);if(cb){cb(rafId);cb=null;}}
  f();
}
bgAnimFunctions['ink']=animInk;

function animFire(c,W,H,cb){
  var em=[];for(var i=0;i<70;i++)em.push({x:W*.5+(Math.random()-.5)*W*.7,y:H+Math.random()*50,vy:-(Math.random()*2.2+.5),vx:(Math.random()-.5)*.8,r:Math.random()*9+2,life:Math.random(),spd:Math.random()*.007+.003});
  function f(){c.clearRect(0,0,W,H);c.fillStyle='#060303';c.fillRect(0,0,W,H);var g=c.createLinearGradient(0,H,0,0);g.addColorStop(0,'rgba(120,20,0,.55)');g.addColorStop(.45,'rgba(50,0,0,.25)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);em.forEach(function(e){e.life+=e.spd;if(e.life>1){e.life=0;e.y=H+20;e.x=W*.5+(Math.random()-.5)*W*.65;}e.y+=e.vy;e.x+=e.vx;e.vx+=(Math.random()-.5)*.12;var fade=e.life<.25?e.life/.25:e.life>.7?(1-e.life)/.3:1;var hue=12-e.life*12;var gr=c.createRadialGradient(e.x,e.y,0,e.x,e.y,e.r*(1-e.life*.4));gr.addColorStop(0,'hsla('+hue+',100%,72%,'+fade*.92+')');gr.addColorStop(.5,'hsla('+hue+',100%,38%,'+fade*.5+')');gr.addColorStop(1,'transparent');c.fillStyle=gr;c.beginPath();c.arc(e.x,e.y,e.r*(1-e.life*.4),0,Math.PI*2);c.fill();});var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['fire']=animFire;

function animSmoke(c,W,H,cb){
  var sm=[];for(var i=0;i<16;i++)sm.push({x:Math.random()*W,y:H+40,vx:(Math.random()-.5)*.4,vy:-(Math.random()*.9+.2),r:Math.random()*65+20,life:0,max:280+Math.random()*220,op:Math.random()*.13+.04});
  function f(){c.clearRect(0,0,W,H);c.fillStyle='#080808';c.fillRect(0,0,W,H);var g=c.createRadialGradient(W*.5,H*.65,0,W*.5,H*.65,W*.65);g.addColorStop(0,'rgba(60,0,0,.15)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);sm.forEach(function(p){p.life++;if(p.life>p.max){p.life=0;p.y=H+40;p.x=Math.random()*W;}p.x+=p.vx;p.y+=p.vy;p.vx+=(Math.random()-.5)*.06;var prog=p.life/p.max,fade=prog<.2?prog/.2:prog>.65?(1-prog)/.35:1;var gr=c.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*(1+prog*.8));gr.addColorStop(0,'rgba(170,150,145,'+p.op*fade+')');gr.addColorStop(1,'transparent');c.fillStyle=gr;c.beginPath();c.arc(p.x,p.y,p.r*(1+prog*.8),0,Math.PI*2);c.fill();});var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['smoke']=animSmoke;

function animSakura(c,W,H,cb){
  var pt=[];for(var i=0;i<42;i++)pt.push({x:Math.random()*W,y:Math.random()*H-H,vy:Math.random()*1.2+.3,vx:(Math.random()-.5)*.5,r:Math.random()*5+2,rot:Math.random()*Math.PI*2,rotV:(Math.random()-.5)*.04,op:Math.random()*.65+.2});
  function f(){c.clearRect(0,0,W,H);c.fillStyle='#060408';c.fillRect(0,0,W,H);var g=c.createRadialGradient(W*.5,H*.3,0,W*.5,H*.3,W*.7);g.addColorStop(0,'rgba(80,10,30,.28)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);pt.forEach(function(p){p.y+=p.vy;p.x+=p.vx+Math.sin(p.y*.018)*.55;p.rot+=p.rotV;if(p.y>H+25){p.y=-20;p.x=Math.random()*W;}c.save();c.translate(p.x,p.y);c.rotate(p.rot);c.beginPath();c.ellipse(0,0,p.r,p.r*1.7,0,0,Math.PI*2);c.fillStyle='rgba(210,100,120,'+p.op+')';c.fill();c.restore();});var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['sakura']=animSakura;

function animGeo(c,W,H,cb){
  var gt=0,sh=[];for(var i=0;i<12;i++)sh.push({x:Math.random()*W,y:Math.random()*H,s:Math.random()*55+18,rot:Math.random()*Math.PI*2,rotV:(Math.random()-.5)*.004,sides:Math.floor(Math.random()*4)+3,op:Math.random()*.18+.05,hue:Math.random()<.6?0:30});
  function polygon(x,y,r,sides,rot){c.beginPath();for(var i=0;i<sides;i++){var a=rot+i/sides*Math.PI*2;if(i===0)c.moveTo(x+Math.cos(a)*r,y+Math.sin(a)*r);else c.lineTo(x+Math.cos(a)*r,y+Math.sin(a)*r);}c.closePath();}
  function f(){gt+=.012;c.clearRect(0,0,W,H);c.fillStyle='#070707';c.fillRect(0,0,W,H);var g=c.createRadialGradient(W*.5,H*.5,0,W*.5,H*.5,W*.7);g.addColorStop(0,'rgba(100,0,0,.1)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);c.strokeStyle='rgba(204,0,0,.04)';c.lineWidth=.5;for(var x=0;x<W;x+=44){c.beginPath();c.moveTo(x,0);c.lineTo(x,H);c.stroke();}for(var y=0;y<H;y+=44){c.beginPath();c.moveTo(0,y);c.lineTo(W,y);c.stroke();}sh.forEach(function(s){s.rot+=s.rotV;polygon(s.x,s.y,s.s+Math.sin(gt+s.x*.02)*10,s.sides,s.rot);c.strokeStyle='hsla('+s.hue+',80%,50%,'+s.op+')';c.lineWidth=.7;c.stroke();});var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['geo']=animGeo;

// NEW BACKGROUNDS
function animLightning(c,W,H,cb){
  var bolts=[],t=0;
  function newBolt(){return{x:Math.random()*W,life:0,max:8+Math.random()*12,segments:[]};}
  function genSegments(x){var segs=[],cx=x,cy=0;while(cy<H){var nx=cx+(Math.random()-.5)*W*.25,ny=cy+H*.06+Math.random()*H*.08;segs.push([cx,cy,nx,ny]);cx=nx;cy=ny;}return segs;}
  for(var i=0;i<3;i++){var b=newBolt();b.segments=genSegments(b.x);bolts.push(b);}
  function f(){t++;c.clearRect(0,0,W,H);c.fillStyle='#05050a';c.fillRect(0,0,W,H);var g=c.createRadialGradient(W*.5,0,0,W*.5,H*.5,W*.8);g.addColorStop(0,'rgba(30,0,60,.4)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);
    bolts.forEach(function(b){b.life++;if(b.life>b.max){b.x=Math.random()*W;b.life=0;b.max=8+Math.random()*15;b.segments=genSegments(b.x);}
    var alpha=b.life<3?b.life/3:b.life>b.max*.7?(b.max-b.life)/(b.max*.3):1;
    b.segments.forEach(function(s){c.beginPath();c.moveTo(s[0],s[1]);c.lineTo(s[2],s[3]);c.strokeStyle='rgba(160,120,255,'+alpha*.8+')';c.lineWidth=1+Math.random();c.shadowColor='rgba(120,80,255,.9)';c.shadowBlur=8;c.stroke();c.shadowBlur=0;
    c.beginPath();c.moveTo(s[0],s[1]);c.lineTo(s[2],s[3]);c.strokeStyle='rgba(220,200,255,'+alpha*.5+')';c.lineWidth=.3;c.stroke();});});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['lightning']=animLightning;

function animMatrix(c,W,H,cb){
  var cols=Math.floor(W/14),drops=[];for(var i=0;i<cols;i++)drops.push(Math.random()*H/14|0);
  function f(){c.fillStyle='rgba(0,0,0,.88)';c.fillRect(0,0,W,H);c.fillStyle='#CC0000';c.font=Math.round(W*.05)+'px "Space Mono",monospace';
    for(var i=0;i<drops.length;i++){var ch=String.fromCharCode(0x30A0+Math.random()*96|0);c.fillStyle=i%7===0?'rgba(255,100,100,.9)':'rgba(180,0,0,'+(0.3+Math.random()*.5)+')';c.fillText(ch,i*14,drops[i]*14);if(drops[i]*14>H&&Math.random()>.97)drops[i]=0;drops[i]++;}
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  c.fillStyle='#000';c.fillRect(0,0,W,H);f();
}
bgAnimFunctions['matrix']=animMatrix;

function animBlood(c,W,H,cb){
  var drops=[];for(var i=0;i<20;i++)drops.push({x:Math.random()*W,y:-Math.random()*H,vy:Math.random()*1.5+.5,r:Math.random()*4+2,op:Math.random()*.7+.3});
  var splats=[];
  function f(){c.clearRect(0,0,W,H);c.fillStyle='#030101';c.fillRect(0,0,W,H);var g=c.createRadialGradient(W*.5,H,0,W*.5,H*.5,H);g.addColorStop(0,'rgba(80,0,0,.5)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);
    splats.forEach(function(s){c.fillStyle='rgba(140,0,0,'+s.op+')';c.beginPath();c.arc(s.x,s.y,s.r,0,Math.PI*2);c.fill();});
    drops.forEach(function(d){d.y+=d.vy;c.fillStyle='rgba(180,0,0,'+d.op+')';c.beginPath();c.ellipse(d.x,d.y,d.r*.6,d.r*1.8,0,0,Math.PI*2);c.fill();if(d.y>H){splats.push({x:d.x,y:H,r:d.r*2+Math.random()*4,op:d.op*.6});if(splats.length>40)splats.shift();d.y=-Math.random()*50;d.x=Math.random()*W;}});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['blood']=animBlood;

function animNeon(c,W,H,cb){
  var t=0,lines=[];for(var i=0;i<8;i++)lines.push({y:Math.random()*H,vy:(Math.random()-.5)*.4,hue:Math.random()*360,len:W*.3+Math.random()*W*.5,x:Math.random()*W,vx:(Math.random()-.5)*.3});
  function f(){t+=.02;c.fillStyle='rgba(0,0,0,.08)';c.fillRect(0,0,W,H);
    lines.forEach(function(l){l.y+=l.vy;l.x+=l.vx;if(l.y<0||l.y>H)l.vy*=-1;if(l.x<0||l.x>W)l.vx*=-1;
    c.shadowColor='hsl('+l.hue+',100%,60%)';c.shadowBlur=12;c.strokeStyle='hsla('+l.hue+',100%,65%,.8)';c.lineWidth=1.5;c.beginPath();c.moveTo(l.x,l.y);c.lineTo(l.x+Math.cos(t+l.hue)*(l.len*.5),l.y+Math.sin(t*.7+l.hue)*(H*.1));c.stroke();c.shadowBlur=0;});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  c.fillStyle='#000';c.fillRect(0,0,W,H);f();
}
bgAnimFunctions['neon']=animNeon;

function animStars(c,W,H,cb){
  var stars=[];for(var i=0;i<120;i++)stars.push({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.5+.3,op:Math.random(),phase:Math.random()*Math.PI*2,speed:Math.random()*.02+.005});
  var t=0;
  function f(){t+=.016;c.clearRect(0,0,W,H);c.fillStyle='#04050c';c.fillRect(0,0,W,H);var g=c.createRadialGradient(W*.5,H*.3,0,W*.5,H*.5,W*.8);g.addColorStop(0,'rgba(20,0,40,.5)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);
    stars.forEach(function(s){var alpha=s.op*(0.5+0.5*Math.sin(t*s.speed*60+s.phase));c.fillStyle='rgba(255,220,180,'+alpha+')';c.beginPath();c.arc(s.x,s.y,s.r,0,Math.PI*2);c.fill();if(s.r>1.2){c.strokeStyle='rgba(255,200,150,'+(alpha*.4)+')';c.lineWidth=.5;c.beginPath();c.moveTo(s.x-s.r*3,s.y);c.lineTo(s.x+s.r*3,s.y);c.moveTo(s.x,s.y-s.r*3);c.lineTo(s.x,s.y+s.r*3);c.stroke();}});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['stars']=animStars;

function animWaves(c,W,H,cb){
  var t=0;
  function f(){t+=.015;c.clearRect(0,0,W,H);c.fillStyle='#020510';c.fillRect(0,0,W,H);
    for(var i=0;i<8;i++){var y=H*.3+i*H*.08+Math.sin(t+i*.5)*H*.04;c.beginPath();c.moveTo(0,y);for(var x=0;x<W;x+=4){c.lineTo(x,y+Math.sin(x/W*Math.PI*3+t*2+i)*(H*.025)+Math.cos(x/W*Math.PI*2+t+i*.3)*(H*.015));}c.strokeStyle='rgba('+(150+i*10)+','+(i*8)+','+(180-i*15)+','+(0.08+i*.025)+')';c.lineWidth=1.5;c.stroke();}
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['waves']=animWaves;

function animLava(c,W,H,cb){
  var blobs=[];for(var i=0;i<14;i++)blobs.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.2,r:W*.06+Math.random()*W*.08,phase:Math.random()*Math.PI*2});
  var t=0;
  function f(){t+=.008;c.clearRect(0,0,W,H);c.fillStyle='#0a0200';c.fillRect(0,0,W,H);
    blobs.forEach(function(b){b.x+=b.vx;b.y+=b.vy;if(b.x<-b.r||b.x>W+b.r)b.vx*=-1;if(b.y<-b.r||b.y>H+b.r)b.vy*=-1;var r2=b.r*(1+.2*Math.sin(t*3+b.phase));var gr=c.createRadialGradient(b.x,b.y,0,b.x,b.y,r2);gr.addColorStop(0,'rgba(255,120,0,.7)');gr.addColorStop(.5,'rgba(180,30,0,.4)');gr.addColorStop(1,'transparent');c.fillStyle=gr;c.beginPath();c.arc(b.x,b.y,r2,0,Math.PI*2);c.fill();});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['lava']=animLava;

function animCircuit(c,W,H,cb){
  var nodes=[],pulses=[],t=0;
  var gridX=6,gridY=10;
  for(var i=0;i<gridX;i++)for(var j=0;j<gridY;j++)nodes.push({x:(i+.5)/gridX*W,y:(j+.5)/gridY*H});
  var edges=[];for(var i=0;i<nodes.length;i++){var neighbors=[];for(var j=0;j<nodes.length;j++){if(i!==j){var dx=nodes[i].x-nodes[j].x,dy=nodes[i].y-nodes[j].y;if(Math.sqrt(dx*dx+dy*dy)<W/gridX*1.6)neighbors.push(j);}}neighbors.slice(0,2).forEach(function(j){edges.push([i,j]);});}
  for(var i=0;i<5;i++)pulses.push({edge:Math.floor(Math.random()*edges.length),t:Math.random(),speed:.005+Math.random()*.01});
  function f(){t+=.016;c.clearRect(0,0,W,H);c.fillStyle='#020508';c.fillRect(0,0,W,H);
    edges.forEach(function(e){var a=nodes[e[0]],b=nodes[e[1]];c.strokeStyle='rgba(0,200,100,.08)';c.lineWidth=.8;c.beginPath();c.moveTo(a.x,a.y);c.lineTo(b.x,b.y);c.stroke();});
    nodes.forEach(function(n){c.fillStyle='rgba(0,180,80,.2)';c.beginPath();c.arc(n.x,n.y,2,0,Math.PI*2);c.fill();});
    pulses.forEach(function(p){p.t+=p.speed;if(p.t>1){p.t=0;p.edge=Math.floor(Math.random()*edges.length);}var e=edges[p.edge];var a=nodes[e[0]],b=nodes[e[1]];var px=a.x+(b.x-a.x)*p.t,py=a.y+(b.y-a.y)*p.t;c.fillStyle='rgba(0,255,120,.9)';c.beginPath();c.arc(px,py,3,0,Math.PI*2);c.fill();c.fillStyle='rgba(0,200,80,.4)';c.beginPath();c.arc(px,py,6,0,Math.PI*2);c.fill();});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['circuit']=animCircuit;


// ── 10 NEW BACKGROUND ANIMATIONS ─────────────────────

function animAurora(c,W,H,cb){
  var t=0;
  function f(){t+=0.008;c.clearRect(0,0,W,H);c.fillStyle='#020612';c.fillRect(0,0,W,H);
    for(var i=0;i<5;i++){var y=H*(0.2+i*0.12);var amp=H*0.06+i*H*0.02;var hue=160+i*30+Math.sin(t+i)*20;var gr=c.createLinearGradient(0,y-amp,0,y+amp);gr.addColorStop(0,'transparent');gr.addColorStop(0.5,'hsla('+hue+',100%,60%,'+(0.08+i*0.02)+')');gr.addColorStop(1,'transparent');c.fillStyle=gr;c.beginPath();c.moveTo(0,y);for(var x=0;x<=W;x+=8){c.lineTo(x,y+Math.sin(x/W*Math.PI*4+t*1.5+i*0.7)*amp);}c.lineTo(W,H);c.lineTo(0,H);c.closePath();c.fill();}
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['aurora']=animAurora;

function animVortex(c,W,H,cb){
  var t=0,cx=W/2,cy=H/2;
  function f(){t+=0.018;c.clearRect(0,0,W,H);c.fillStyle='#040208';c.fillRect(0,0,W,H);
    for(var i=0;i<120;i++){var a=i/120*Math.PI*2*6+t*2;var r=i/120*(Math.min(W,H)*0.45);var x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;var hue=i%2===0?0:280;c.fillStyle='hsla('+hue+',90%,55%,'+(0.05+i/120*0.25)+')';c.beginPath();c.arc(x,y,1.5,0,Math.PI*2);c.fill();}
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['vortex']=animVortex;

function animInk2(c,W,H,cb){
  var drops=[],t=0;
  for(var i=0;i<8;i++)drops.push({x:Math.random()*W,y:Math.random()*H,r:0,maxR:W*0.15+Math.random()*W*0.12,spd:0.4+Math.random()*0.5,op:0.18+Math.random()*0.14,hue:Math.random()<0.5?0:200,born:Math.random()*180});
  function f(){t++;c.clearRect(0,0,W,H);c.fillStyle='#070708';c.fillRect(0,0,W,H);
    var g=c.createRadialGradient(W*0.5,H*0.35,0,W*0.5,H*0.35,W*0.7);g.addColorStop(0,'rgba(60,0,0,0.2)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);
    drops.forEach(function(d){if(t<d.born)return;d.r+=d.spd;if(d.r>d.maxR){d.r=0;d.x=Math.random()*W;d.y=Math.random()*H;d.born=t+Math.random()*100;}var prog=d.r/d.maxR;var fade=prog<0.2?prog/0.2:prog>0.7?(1-prog)/0.3:1;var gr=c.createRadialGradient(d.x,d.y,0,d.x,d.y,d.r);gr.addColorStop(0,'hsla('+d.hue+',80%,12%,'+(d.op*fade*1.4)+')');gr.addColorStop(0.5,'hsla('+d.hue+',90%,8%,'+(d.op*fade)+')');gr.addColorStop(1,'transparent');c.fillStyle=gr;c.beginPath();c.arc(d.x,d.y,d.r,0,Math.PI*2);c.fill();});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['ink2']=animInk2;

function animTribal(c,W,H,cb){
  var t=0;
  var shapes=[];
  for(var i=0;i<14;i++){shapes.push({x:Math.random()*W,y:Math.random()*H,s:W*0.04+Math.random()*W*0.06,rot:Math.random()*Math.PI,rotV:(Math.random()-0.5)*0.006,type:Math.floor(Math.random()*3)});}
  function drawTribal(x,y,s,rot,type){c.save();c.translate(x,y);c.rotate(rot);c.strokeStyle='rgba(204,0,0,0.12)';c.lineWidth=1;
    if(type===0){c.beginPath();c.moveTo(0,-s);c.lineTo(s*0.7,s*0.5);c.lineTo(-s*0.7,s*0.5);c.closePath();c.stroke();c.beginPath();c.moveTo(0,-s*0.5);c.lineTo(s*0.35,s*0.25);c.lineTo(-s*0.35,s*0.25);c.closePath();c.stroke();}
    else if(type===1){for(var j=0;j<4;j++){c.beginPath();c.moveTo(-s+j*s*0.6,0);c.lineTo(j*s*0.6-s*0.3,-s*0.5);c.lineTo(j*s*0.6,-s*0.15);c.stroke();}}
    else{c.beginPath();c.moveTo(-s,0);c.lineTo(0,-s);c.lineTo(s,0);c.lineTo(0,s);c.closePath();c.stroke();c.beginPath();c.moveTo(-s*0.5,0);c.lineTo(0,-s*0.5);c.lineTo(s*0.5,0);c.lineTo(0,s*0.5);c.closePath();c.stroke();}
    c.restore();}
  function f(){t+=0.01;c.clearRect(0,0,W,H);c.fillStyle='#060404';c.fillRect(0,0,W,H);
    var g=c.createRadialGradient(W*0.5,H*0.5,0,W*0.5,H*0.5,W*0.7);g.addColorStop(0,'rgba(80,10,0,0.2)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);
    shapes.forEach(function(s){s.rot+=s.rotV;drawTribal(s.x,s.y,s.s,s.rot,s.type);});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['tribal']=animTribal;

function animGalaxy(c,W,H,cb){
  var stars=[];var t=0;
  for(var i=0;i<200;i++)stars.push({a:(i/200)*Math.PI*2*5,r:Math.random()*Math.min(W,H)*0.44,hue:Math.random()<0.3?0:Math.random()<0.5?200:280,size:Math.random()*2+0.5,speed:0.0004+Math.random()*0.0003});
  function f(){t+=0.01;c.clearRect(0,0,W,H);c.fillStyle='#030208';c.fillRect(0,0,W,H);
    var g=c.createRadialGradient(W*0.5,H*0.4,0,W*0.5,H*0.4,W*0.3);g.addColorStop(0,'rgba(80,0,30,0.3)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);
    stars.forEach(function(s){s.a+=s.speed;var x=W*0.5+Math.cos(s.a)*s.r,y=H*0.4+Math.sin(s.a)*s.r*0.5;var alpha=0.3+0.6*Math.sin(t*3+s.a);c.fillStyle='hsla('+s.hue+',80%,70%,'+alpha+')';c.beginPath();c.arc(x,y,s.size,0,Math.PI*2);c.fill();});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['galaxy']=animGalaxy;

function animSandstorm(c,W,H,cb){
  var particles=[];var t=0;
  for(var i=0;i<180;i++)particles.push({x:Math.random()*W,y:Math.random()*H,vx:0.8+Math.random()*1.5,vy:(Math.random()-0.5)*0.4,size:Math.random()*2.5+0.5,op:Math.random()*0.35+0.1});
  function f(){t+=0.01;c.clearRect(0,0,W,H);c.fillStyle='#080503';c.fillRect(0,0,W,H);
    var g=c.createLinearGradient(0,0,W,H);g.addColorStop(0,'rgba(80,40,0,0.25)');g.addColorStop(1,'rgba(40,10,0,0.1)');c.fillStyle=g;c.fillRect(0,0,W,H);
    particles.forEach(function(p){p.x+=p.vx+Math.sin(t+p.y*0.02)*0.5;p.y+=p.vy+Math.cos(t*0.7+p.x*0.015)*0.2;if(p.x>W+5)p.x=-5;if(p.y<0)p.y=H;if(p.y>H)p.y=0;c.fillStyle='rgba(180,120,40,'+p.op+')';c.beginPath();c.arc(p.x,p.y,p.size,0,Math.PI*2);c.fill();});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['sandstorm']=animSandstorm;

function animGlitch(c,W,H,cb){
  var t=0;
  function f(){t++;c.clearRect(0,0,W,H);c.fillStyle='#050505';c.fillRect(0,0,W,H);
    if(t%8<3){var sliceH=Math.random()*60+10,sliceY=Math.random()*H;c.save();c.drawImage(c.canvas,Math.random()*20-10,sliceY,W,sliceH,0,sliceY,W,sliceH);c.restore();}
    if(t%12<2){c.fillStyle='rgba(204,0,0,0.15)';c.fillRect(0,Math.random()*H,W,Math.random()*30+2);}
    if(t%20<3){c.fillStyle='rgba(0,100,200,0.1)';c.fillRect(Math.random()*10-5,0,W,H);}
    for(var i=0;i<6;i++){var y=Math.random()*H;c.fillStyle='rgba('+(Math.random()<0.5?204:0)+',0,'+(Math.random()<0.3?200:0)+','+(0.03+Math.random()*0.04)+')';c.fillRect(0,y,W,1+Math.random()*2);}
    var g=c.createRadialGradient(W*0.5,H*0.4,0,W*0.5,H*0.4,W*0.6);g.addColorStop(0,'rgba(60,0,0,0.18)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['glitch']=animGlitch;

function animDragonscale(c,W,H,cb){
  var t=0;var sw=W*0.09,sh=sw*0.55;var cols=Math.ceil(W/sw)+1,rows=Math.ceil(H/sh)+1;
  function f(){t+=0.008;c.clearRect(0,0,W,H);c.fillStyle='#040506';c.fillRect(0,0,W,H);
    for(var row=0;row<rows;row++){for(var col=0;col<cols;col++){var ox=(row%2)*sw*0.5;var x=col*sw-ox,y=row*sh*0.8;var wave=Math.sin(t*2+col*0.5+row*0.4)*0.5+0.5;var hue=wave<0.5?0:200;var lightness=8+wave*12;var alpha=0.08+wave*0.12;c.beginPath();c.ellipse(x,y,sw*0.52,sh*0.52,0,0,Math.PI*2);c.strokeStyle='hsla('+hue+',70%,'+(lightness+10)+'%,'+alpha+')';c.lineWidth=1;c.stroke();c.fillStyle='hsla('+hue+',60%,'+lightness+'%,'+(alpha*0.4)+')';c.fill();}}
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['dragonscale']=animDragonscale;

function animBokeh(c,W,H,cb){
  var circles=[];var t=0;
  for(var i=0;i<30;i++)circles.push({x:Math.random()*W,y:Math.random()*H,r:W*0.03+Math.random()*W*0.07,vy:(Math.random()-0.5)*0.3,vx:(Math.random()-0.5)*0.15,phase:Math.random()*Math.PI*2,hue:Math.random()<0.6?0:Math.random()<0.5?30:320,op:0.06+Math.random()*0.08});
  function f(){t+=0.012;c.clearRect(0,0,W,H);c.fillStyle='#050507';c.fillRect(0,0,W,H);
    circles.forEach(function(b){b.x+=b.vx;b.y+=b.vy;if(b.y<-b.r)b.y=H+b.r;if(b.y>H+b.r)b.y=-b.r;if(b.x<-b.r)b.x=W+b.r;if(b.x>W+b.r)b.x=-b.r;var pulse=0.6+0.4*Math.sin(t*1.5+b.phase);var gr=c.createRadialGradient(b.x,b.y,0,b.x,b.y,b.r);gr.addColorStop(0,'transparent');gr.addColorStop(0.6,'hsla('+b.hue+',90%,60%,'+(b.op*pulse*0.5)+')');gr.addColorStop(0.88,'hsla('+b.hue+',100%,70%,'+(b.op*pulse)+')');gr.addColorStop(1,'transparent');c.fillStyle=gr;c.beginPath();c.arc(b.x,b.y,b.r,0,Math.PI*2);c.fill();});
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['bokeh']=animBokeh;

function animRedmoon(c,W,H,cb){
  var t=0;var haze=[];
  for(var i=0;i<12;i++)haze.push({x:Math.random()*W,y:Math.random()*H,r:W*0.1+Math.random()*W*0.12,op:0.04+Math.random()*0.06,vy:(Math.random()-0.5)*0.12,phase:Math.random()*Math.PI*2});
  function f(){t+=0.006;c.clearRect(0,0,W,H);c.fillStyle='#060103';c.fillRect(0,0,W,H);
    var gr=c.createRadialGradient(W*0.5,H*0.28,0,W*0.5,H*0.28,W*0.22);gr.addColorStop(0,'rgba(180,20,0,0.55)');gr.addColorStop(0.5,'rgba(100,5,0,0.25)');gr.addColorStop(1,'transparent');c.fillStyle=gr;c.fillRect(0,0,W,H);
    c.strokeStyle='rgba(200,50,0,0.18)';c.lineWidth=W*0.003;c.beginPath();c.arc(W*0.5,H*0.28,W*0.18+Math.sin(t)*W*0.005,0,Math.PI*2);c.stroke();
    c.strokeStyle='rgba(200,60,0,0.08)';c.lineWidth=1;c.beginPath();c.arc(W*0.5,H*0.28,W*0.22,0,Math.PI*2);c.stroke();
    haze.forEach(function(h){h.y+=h.vy;h.phase+=0.01;if(h.y<-h.r)h.y=H+h.r;if(h.y>H+h.r)h.y=-h.r;var fade=0.5+0.5*Math.sin(h.phase);var gr2=c.createRadialGradient(h.x,h.y,0,h.x,h.y,h.r);gr2.addColorStop(0,'rgba(120,10,0,'+(h.op*fade)+')');gr2.addColorStop(1,'transparent');c.fillStyle=gr2;c.beginPath();c.arc(h.x,h.y,h.r,0,Math.PI*2);c.fill();});
    var br=c.createLinearGradient(0,H*0.55,0,H);br.addColorStop(0,'transparent');br.addColorStop(1,'rgba(80,0,0,0.35)');c.fillStyle=br;c.fillRect(0,0,W,H);
    var id=requestAnimationFrame(f);if(cb){cb(id);cb=null;}}
  f();
}
bgAnimFunctions['redmoon']=animRedmoon;

// ── RENDER ANIMATED BG FOR EXPORT ────────────────────
function drawAnimBgFrame(c,bgType,W,H,t){
  // Always start with solid black — prevents transparency artifacts in PNG export
  c.globalAlpha=1;
  c.fillStyle='#080808';
  c.fillRect(0,0,W,H);
  var PI=Math.PI;
  // Always start with solid black — prevents transparent checkered background in exports
  c.clearRect(0,0,W,H);
  c.fillStyle='#080808';
  c.fillRect(0,0,W,H);
  if(bgType==='fire'){
    c.fillStyle='#060303';c.fillRect(0,0,W,H);var g=c.createLinearGradient(0,H,0,0);g.addColorStop(0,'rgba(120,20,0,.55)');g.addColorStop(.45,'rgba(50,0,0,.25)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);
    for(var i=0;i<25;i++){var px=W*.5+Math.cos(i*2.5+t*8)*W*.38,py=H-(((i*73+t*H*1.5)%H));var r=Math.max(2,(14-i*.4)*(1-i/25));var gr=c.createRadialGradient(px,py,0,px,py,r);gr.addColorStop(0,'hsla('+(10-t*5)+',100%,70%,.85)');gr.addColorStop(.5,'hsla(8,100%,35%,.4)');gr.addColorStop(1,'transparent');c.fillStyle=gr;c.beginPath();c.arc(px,py,r,0,PI*2);c.fill();}
  } else if(bgType==='sakura'){
    c.fillStyle='#060408';c.fillRect(0,0,W,H);var g2=c.createRadialGradient(W*.5,H*.3,0,W*.5,H*.3,W*.7);g2.addColorStop(0,'rgba(80,10,30,.3)');g2.addColorStop(1,'transparent');c.fillStyle=g2;c.fillRect(0,0,W,H);
    for(var i=0;i<32;i++){var px2=((i*139+t*W*1.8)%W),py2=((i*97+t*H*1.1)%H);c.save();c.translate(px2,py2);c.rotate(i*.7+t*2.5);c.beginPath();c.ellipse(0,0,3+i%4,5+i%5,0,0,PI*2);c.fillStyle='rgba(210,100,120,'+(0.3+i%3*.1)+')';c.fill();c.restore();}
  } else if(bgType==='lightning'){
    c.fillStyle='#05050a';c.fillRect(0,0,W,H);var g3=c.createRadialGradient(W*.5,0,0,W*.5,H*.5,W*.8);g3.addColorStop(0,'rgba(30,0,60,.4)');g3.addColorStop(1,'transparent');c.fillStyle=g3;c.fillRect(0,0,W,H);
    for(var i=0;i<3;i++){var bx=W*(i*.3+.1+Math.sin(t*3+i)*.1);var by=0,cx2=bx;c.strokeStyle='rgba(160,120,255,'+(0.4+0.4*Math.sin(t*8+i))+')';c.lineWidth=1.5;c.beginPath();c.moveTo(bx,0);while(by<H){var nx=cx2+(Math.random()-.5)*W*.2,ny=by+H*.07;c.lineTo(nx,ny);cx2=nx;by=ny;}c.stroke();}
  } else if(bgType==='matrix'){
    c.fillStyle='rgba(0,0,0,.92)';c.fillRect(0,0,W,H);var cols=Math.floor(W/28);c.font=Math.round(W*.025)+'px "Space Mono",monospace';for(var i=0;i<cols;i++){var ch=String.fromCharCode(0x30A0+(t*100+i*7)%96|0);var y2=((t*H*.8+i*H*.07)%H);c.fillStyle=i%7===0?'rgba(255,80,80,.9)':'rgba(180,0,0,.5)';c.fillText(ch,i*28,y2);}
  } else if(bgType==='blood'){
    c.fillStyle='#030101';c.fillRect(0,0,W,H);var g4=c.createRadialGradient(W*.5,H,0,W*.5,H*.5,H);g4.addColorStop(0,'rgba(80,0,0,.5)');g4.addColorStop(1,'transparent');c.fillStyle=g4;c.fillRect(0,0,W,H);
    for(var i=0;i<18;i++){var dx=W*.05+i*(W*.05),dy=((i*H*.07+t*H*.5)%H);c.fillStyle='rgba(180,0,0,'+(.4+i%3*.15)+')';c.beginPath();c.ellipse(dx,dy,W*.015,W*.03,0,0,PI*2);c.fill();}
  } else if(bgType==='neon'){
    c.fillStyle='#000';c.fillRect(0,0,W,H);
    for(var i=0;i<6;i++){var hue=i*60+t*20;c.shadowColor='hsl('+hue+',100%,60%)';c.shadowBlur=15;c.strokeStyle='hsla('+hue+',100%,65%,.7)';c.lineWidth=2;c.beginPath();c.moveTo(0,H*.2+i*H*.1+Math.sin(t+i)*H*.05);c.bezierCurveTo(W*.3,H*.1+i*H*.12+Math.cos(t*1.5)*H*.08,W*.7,H*.3+i*H*.08+Math.sin(t*.8)*H*.06,W,H*.2+i*H*.1+Math.cos(t+i)*H*.05);c.stroke();c.shadowBlur=0;}
  } else if(bgType==='stars'){
    c.fillStyle='#04050c';c.fillRect(0,0,W,H);var g5=c.createRadialGradient(W*.5,H*.3,0,W*.5,H*.5,W*.8);g5.addColorStop(0,'rgba(20,0,40,.5)');g5.addColorStop(1,'transparent');c.fillStyle=g5;c.fillRect(0,0,W,H);
    for(var i=0;i<100;i++){var sx=((i*137.5)%W)*W/W,sy=((i*97.3)%H)*H/H;var alpha=0.4+0.5*Math.sin(t*2+i);c.fillStyle='rgba(255,220,180,'+alpha+')';c.beginPath();c.arc(sx*W,sy*H,1+i%2,0,PI*2);c.fill();}
  } else if(bgType==='waves'){
    c.fillStyle='#020510';c.fillRect(0,0,W,H);c.fillRect(0,0,W,H);
    for(var i=0;i<8;i++){c.beginPath();c.moveTo(0,H*.3+i*H*.08);for(var x2=0;x2<W;x2+=8){c.lineTo(x2,H*.3+i*H*.08+Math.sin(x2/W*PI*3+t*2+i)*(H*.025));}c.strokeStyle='rgba('+(150+i*10)+','+(i*8)+','+(180-i*15)+','+(0.06+i*.025)+')';c.lineWidth=1.5;c.stroke();}
  } else if(bgType==='lava'){
    c.fillStyle='#0a0200';c.fillRect(0,0,W,H);
    for(var i=0;i<10;i++){var bx=W*(i/10)+Math.sin(t*2+i)*W*.1,by2=H*.5+Math.cos(t+i*1.3)*H*.3;var r3=W*.08+Math.sin(t*3+i)*.02*W;var gr2=c.createRadialGradient(bx,by2,0,bx,by2,r3);gr2.addColorStop(0,'rgba(255,120,0,.6)');gr2.addColorStop(.5,'rgba(180,30,0,.35)');gr2.addColorStop(1,'transparent');c.fillStyle=gr2;c.beginPath();c.arc(bx,by2,r3,0,PI*2);c.fill();}
  } else if(bgType==='circuit'){
    c.fillStyle='#020508';c.fillRect(0,0,W,H);
    c.globalAlpha=1;c.strokeStyle='rgba(0,200,100,.07)';c.lineWidth=.8;
    for(var i=0;i<7;i++){for(var j=0;j<11;j++){var cx3=i/6*W,cy3=j/10*H;if(i<6){c.beginPath();c.moveTo(cx3,cy3);c.lineTo((i+1)/6*W,cy3);c.stroke();}if(j<10){c.beginPath();c.moveTo(cx3,cy3);c.lineTo(cx3,(j+1)/10*H);c.stroke();}var puls=(t*5+i*.7+j*.5)%1;c.fillStyle='rgba(0,255,120,'+(0.7-puls*.6)+')';c.beginPath();c.arc(cx3,cy3,3*(1-puls),0,PI*2);c.fill();}}
  } else if(bgType==='aurora'){
    c.fillStyle='#020612';c.fillRect(0,0,W,H);
    for(var i=0;i<5;i++){var ay=H*(0.2+i*0.12),amp=H*0.06+i*H*0.02,ahue=160+i*30+Math.sin(t*6+i)*20;var gr=c.createLinearGradient(0,ay-amp,0,ay+amp);gr.addColorStop(0,'transparent');gr.addColorStop(0.5,'hsla('+ahue+',100%,60%,'+(0.07+i*0.018)+')');gr.addColorStop(1,'transparent');c.fillStyle=gr;c.beginPath();c.moveTo(0,ay);for(var x=0;x<=W;x+=12){c.lineTo(x,ay+Math.sin(x/W*PI*4+t*9+i*0.7)*amp);}c.lineTo(W,H);c.lineTo(0,H);c.closePath();c.fill();}
  } else if(bgType==='vortex'){
    c.fillStyle='#040208';c.fillRect(0,0,W,H);
    for(var i=0;i<120;i++){var va=i/120*PI*12+t*12,vr=i/120*(Math.min(W,H)*0.45);var vx=W*0.5+Math.cos(va)*vr,vy=H*0.5+Math.sin(va)*vr;var vh=i%2===0?0:280;c.fillStyle='hsla('+vh+',90%,55%,'+(0.04+i/120*0.22)+')';c.beginPath();c.arc(vx,vy,1.5,0,PI*2);c.fill();}
  } else if(bgType==='ink2'){
    c.fillStyle='#070708';c.fillRect(0,0,W,H);var ig=c.createRadialGradient(W*0.5,H*0.35,0,W*0.5,H*0.35,W*0.7);ig.addColorStop(0,'rgba(60,0,0,0.2)');ig.addColorStop(1,'transparent');c.fillStyle=ig;c.fillRect(0,0,W,H);
    for(var i=0;i<8;i++){var ix=((i*137+t*W*0.8)%W)*W/W*W/W,iy=((i*97+t*H*0.6)%H)*H/H*H/H;var ir=W*0.12+i*W*0.02;var igr=c.createRadialGradient(i*(W/8)+W/16,H*0.2+i*H*0.08,0,i*(W/8)+W/16,H*0.2+i*H*0.08,ir*(1+0.3*Math.sin(t*3+i)));igr.addColorStop(0,'hsla('+(i%2===0?0:200)+',80%,10%,'+(0.15+i*0.01)+')');igr.addColorStop(1,'transparent');c.fillStyle=igr;c.beginPath();c.arc(i*(W/8)+W/16,H*0.2+i*H*0.08,ir,0,PI*2);c.fill();}
  } else if(bgType==='tribal'){
    c.fillStyle='#060404';c.fillRect(0,0,W,H);var tg=c.createRadialGradient(W*0.5,H*0.5,0,W*0.5,H*0.5,W*0.7);tg.addColorStop(0,'rgba(80,10,0,0.2)');tg.addColorStop(1,'transparent');c.fillStyle=tg;c.fillRect(0,0,W,H);
    c.strokeStyle='rgba(204,0,0,0.1)';c.lineWidth=1;
    for(var i=0;i<10;i++){var tx=i*(W/10)+W/20,ty=H*0.5;var ts=W*0.05+i%3*W*0.02;c.save();c.translate(tx,ty);c.rotate(t*0.5+i*0.6);c.beginPath();c.moveTo(0,-ts);c.lineTo(ts*0.7,ts*0.5);c.lineTo(-ts*0.7,ts*0.5);c.closePath();c.stroke();c.beginPath();c.moveTo(0,-ts*0.5);c.lineTo(ts*0.35,ts*0.25);c.lineTo(-ts*0.35,ts*0.25);c.closePath();c.stroke();c.restore();}
  } else if(bgType==='galaxy'){
    c.fillStyle='#030208';c.fillRect(0,0,W,H);var gg=c.createRadialGradient(W*0.5,H*0.4,0,W*0.5,H*0.4,W*0.3);gg.addColorStop(0,'rgba(80,0,30,0.3)');gg.addColorStop(1,'transparent');c.fillStyle=gg;c.fillRect(0,0,W,H);
    for(var i=0;i<150;i++){var ga=(i/150*PI*10+t*0.5),gr=Math.random?i/150*Math.min(W,H)*0.44:i/150*Math.min(W,H)*0.44;ga=i/150*PI*10+t*0.5;gr=i/150*Math.min(W,H)*0.44;var gx=W*0.5+Math.cos(ga)*gr,gy=H*0.4+Math.sin(ga)*gr*0.55;var gh=i%3===0?0:i%3===1?200:280;var galpha=0.2+0.5*Math.sin(t*4+i);c.fillStyle='hsla('+gh+',80%,70%,'+galpha+')';c.beginPath();c.arc(gx,gy,i%5===0?1.8:0.8,0,PI*2);c.fill();}
  } else if(bgType==='sandstorm'){
    c.fillStyle='#080503';c.fillRect(0,0,W,H);var sg=c.createLinearGradient(0,0,W,H);sg.addColorStop(0,'rgba(80,40,0,0.25)');sg.addColorStop(1,'rgba(40,10,0,0.1)');c.fillStyle=sg;c.fillRect(0,0,W,H);
    for(var i=0;i<120;i++){var sx=((i*53+t*W*1.8)%W),sy=((i*79+t*H*0.4)%H);c.fillStyle='rgba(180,120,40,'+(0.08+i%4*0.04)+')';c.beginPath();c.arc(sx*W/W,sy*H/H,1+i%3,0,PI*2);c.fill();}
    for(var i=0;i<25;i++){var ly=((i*41+t*H*0.3)%H);c.fillStyle='rgba(150,90,20,'+(0.04+i%3*0.02)+')';c.fillRect(0,ly*H/H,W,1+i%2);}
  } else if(bgType==='glitch'){
    c.fillStyle='#050505';c.fillRect(0,0,W,H);
    var glt=Math.floor(t*20)%30;
    if(glt<3){c.fillStyle='rgba(204,0,0,0.12)';c.fillRect(0,Math.sin(t*17)*H,W,H*0.04+Math.cos(t*11)*H*0.02);}
    if(glt<5&&glt>2){c.fillStyle='rgba(0,80,200,0.08)';c.fillRect(Math.cos(t*13)*W*0.03,0,W,H);}
    for(var i=0;i<8;i++){c.fillStyle='rgba('+(i%2===0?180:0)+',0,'+(i%3===0?150:0)+','+(0.02+i*0.01)+')';c.fillRect(0,((i*H/8+t*H*0.5)%H),W,1+i%2);}
    var gg2=c.createRadialGradient(W*0.5,H*0.4,0,W*0.5,H*0.4,W*0.6);gg2.addColorStop(0,'rgba(60,0,0,0.18)');gg2.addColorStop(1,'transparent');c.fillStyle=gg2;c.fillRect(0,0,W,H);
  } else if(bgType==='dragonscale'){
    c.fillStyle='#040506';c.fillRect(0,0,W,H);
    var dsw=W*0.09,dsh=dsw*0.55,dcols=Math.ceil(W/dsw)+2,drows=Math.ceil(H/(dsh*0.8))+2;
    for(var row=0;row<drows;row++){for(var col=0;col<dcols;col++){var dox=(row%2)*dsw*0.5;var dx=col*dsw-dox,dy=row*dsh*0.8;var dwave=0.5+0.5*Math.sin(t*6+col*0.5+row*0.4);var dhue=dwave<0.5?0:200;var dl=8+dwave*12;c.beginPath();c.ellipse(dx,dy,dsw*0.52,dsh*0.52,0,0,PI*2);c.strokeStyle='hsla('+dhue+',70%,'+(dl+10)+'%,'+(0.07+dwave*0.1)+')';c.lineWidth=1;c.stroke();c.fillStyle='hsla('+dhue+',60%,'+dl+'%,'+(0.03+dwave*0.05)+')';c.fill();}}
  } else if(bgType==='bokeh'){
    c.fillStyle='#050507';c.fillRect(0,0,W,H);
    for(var i=0;i<25;i++){var bkx=((i*137.5)%(W+100))-50,bky=((i*97.3+t*H*0.15)%(H+100))-50;var bkr=W*0.04+i%5*W*0.03;var bkh=i%3===0?0:i%3===1?30:320;var bkpulse=0.5+0.5*Math.sin(t*4+i);var bkgr=c.createRadialGradient(bkx,bky,0,bkx,bky,bkr);bkgr.addColorStop(0,'transparent');bkgr.addColorStop(0.6,'hsla('+bkh+',90%,60%,'+(0.04+i%3*0.02)*bkpulse+')');bkgr.addColorStop(0.9,'hsla('+bkh+',100%,70%,'+(0.07+i%4*0.02)*bkpulse+')');bkgr.addColorStop(1,'transparent');c.fillStyle=bkgr;c.beginPath();c.arc(bkx,bky,bkr,0,PI*2);c.fill();}
  } else if(bgType==='redmoon'){
    c.fillStyle='#060103';c.fillRect(0,0,W,H);
    var rmg=c.createRadialGradient(W*0.5,H*0.28,0,W*0.5,H*0.28,W*0.22+Math.sin(t*6)*W*0.01);rmg.addColorStop(0,'rgba(180,20,0,0.55)');rmg.addColorStop(0.5,'rgba(100,5,0,0.25)');rmg.addColorStop(1,'transparent');c.fillStyle=rmg;c.fillRect(0,0,W,H);
    c.strokeStyle='rgba(200,50,0,0.16)';c.lineWidth=W*0.003;c.beginPath();c.arc(W*0.5,H*0.28,W*0.18,0,PI*2);c.stroke();
    for(var i=0;i<8;i++){var rhx=((i*139+t*W*0.3)%(W+100))-50,rhy=((i*97+t*H*0.12)%H);var rhr=W*0.12+i%3*W*0.04;var rhg=c.createRadialGradient(rhx,rhy,0,rhx,rhy,rhr);rhg.addColorStop(0,'rgba(120,10,0,'+(0.04+i%3*0.015)+')');rhg.addColorStop(1,'transparent');c.fillStyle=rhg;c.beginPath();c.arc(rhx,rhy,rhr,0,PI*2);c.fill();}
    var rbb=c.createLinearGradient(0,H*0.55,0,H);rbb.addColorStop(0,'transparent');rbb.addColorStop(1,'rgba(80,0,0,0.3)');c.fillStyle=rbb;c.fillRect(0,0,W,H);
  } else if(bgType==='geo'){
    c.fillStyle='#070707';;c.fillRect(0,0,W,H);var g6=c.createRadialGradient(W*.5,H*.5,0,W*.5,H*.5,W*.7);g6.addColorStop(0,'rgba(100,0,0,.1)');g6.addColorStop(1,'transparent');c.fillStyle=g6;c.fillRect(0,0,W,H);
    for(var i=0;i<7;i++){var sides=3+i%4,r4=W*.07+i*W*.05,rot3=t*PI*2*(i%2===0?1:-1)+i;c.beginPath();for(var j=0;j<sides;j++){var a=rot3+j/sides*PI*2;if(j===0)c.moveTo(W*.5+Math.cos(a)*r4,H*.5+Math.sin(a)*r4);else c.lineTo(W*.5+Math.cos(a)*r4,H*.5+Math.sin(a)*r4);}c.closePath();c.strokeStyle='hsla('+(i%2===0?0:30)+',80%,50%,'+(0.06+i*.012)+')';c.lineWidth=.7;c.stroke();}
  } else {
    // default ink
    c.fillStyle='#080808';c.fillRect(0,0,W,H);var g7=c.createRadialGradient(W*.5,H*.3,0,W*.5,H*.3,W*.8);g7.addColorStop(0,'rgba(100,0,0,.2)');g7.addColorStop(1,'transparent');c.fillStyle=g7;c.fillRect(0,0,W,H);
    for(var i=0;i<10;i++){var px3=W*.5+Math.cos(i*1.9+t*3)*W*.28,py3=H*.45+Math.sin(i*2.3+t*2.5)*H*.28;var gr3=c.createRadialGradient(px3,py3,0,px3,py3,W*.1);gr3.addColorStop(0,'hsla(0,90%,14%,'+(0.1+i*.01)+')');gr3.addColorStop(1,'transparent');c.fillStyle=gr3;c.beginPath();c.arc(px3,py3,W*.1,0,PI*2);c.fill();}
  }
}

// ── RENDER A STORY FRAME ─────────────────────────────
function renderFrame(c,story,handle,bgImg,bgType,W,H,t){
  // Always start with solid black canvas — prevents checkered transparency in exports
  c.globalAlpha=1;
  c.fillStyle='#080808';
  c.fillRect(0,0,W,H);
  if(bgImg){drawPhoto(c,bgImg,W,H);}
  else{drawAnimBgFrame(c,bgType,W,H,t);}
  drawAsianBorderCanvas(c,W,H);
  var pad=W*.052;
  var logoAreaH=H*.115,tagAreaH=H*.042,divH=H*.006;
  if(logoImg&&logoImg.complete&&logoImg.naturalWidth>0){var lh=logoAreaH*.88,lw=lh*(logoImg.naturalWidth/logoImg.naturalHeight);if(lw>W*.52){lw=W*.52;lh=lw*(logoImg.naturalHeight/logoImg.naturalWidth);}c.imageSmoothingEnabled=true;c.imageSmoothingQuality='high';c.drawImage(logoImg,W/2-lw/2,(logoAreaH-lh)/2+H*.025,lw,lh);}
  var tagY=logoAreaH+tagAreaH*.68;c.fillStyle='#CC0000';c.beginPath();c.arc(W/2-W*.23,tagY,W*.013,0,Math.PI*2);c.fill();c.fillStyle='#CC0000';c.font='bold '+Math.round(W*.038)+'px "Space Mono",monospace';c.textAlign='center';c.fillText((story.eyebrow||'').toUpperCase(),W/2+W*.03,tagY+W*.014);c.textAlign='left';
  var td=logoAreaH+tagAreaH+divH;var grd=c.createLinearGradient(pad,0,W-pad,0);grd.addColorStop(0,'transparent');grd.addColorStop(.5,'#CC0000');grd.addColorStop(1,'transparent');c.fillStyle=grd;c.fillRect(pad,td,W-pad*2,H*.003);
  var maxTitleW=W-pad*2,titleFS=Math.round(W*.19);
  c.font='900 '+titleFS+'px "Noto Serif JP",serif';
  var t1=story.title1||'',t2=story.title2||'';
  while(titleFS>24&&(c.measureText(t1).width>maxTitleW||c.measureText(t2).width>maxTitleW)){titleFS=Math.round(titleFS*.93);c.font='900 '+titleFS+'px "Noto Serif JP",serif';}
  var titleLineH=titleFS*1.06,acc=(story.accent||'').toLowerCase().trim();
  function drawTitleLine(text,y){var words=text.split(' '),x=pad;words.forEach(function(w){var isAcc=acc&&w.toLowerCase().replace(/[^\wáéíóúüñ]/gi,'').indexOf(acc.replace(/[^\wáéíóúüñ]/gi,''))>-1;c.fillStyle=isAcc?'#CC0000':'#ffffff';c.fillText(w,x,y);x+=c.measureText(w+' ').width;});}
  var titleY=td+divH*2+titleFS*.95;drawTitleLine(t1,titleY);drawTitleLine(t2,titleY+titleLineH);
  var bodyFS=Math.round(W*.05),innerPad=W*.055;
  var bodyLines=getWrappedLines(c,story.body||'',maxTitleW-innerPad*2,bodyFS);
  var bodyLineH=bodyFS*1.72,boxGap=titleLineH*.35;
  var boxY=titleY+titleLineH*2+boxGap,boxH=innerPad*.8+bodyLines.length*bodyLineH+innerPad*.8;
  c.save();c.globalAlpha=.85;c.fillStyle='#050505';c.fillRect(pad,boxY,W-pad*2,boxH);c.globalAlpha=1;c.restore();
  c.strokeStyle='rgba(204,0,0,.3)';c.lineWidth=W*.004;c.strokeRect(pad,boxY,W-pad*2,boxH);
  var bl=c.createLinearGradient(pad,0,W-pad,0);bl.addColorStop(0,'transparent');bl.addColorStop(.5,'rgba(204,0,0,.6)');bl.addColorStop(1,'transparent');c.fillStyle=bl;c.fillRect(pad,boxY,W-pad*2,H*.003);
  c.fillStyle='rgba(255,255,255,.88)';c.font='400 '+bodyFS+'px "Cinzel",serif';
  var bodyTxtY=boxY+innerPad*.8+bodyFS*.85;bodyLines.forEach(function(line,i){c.fillText(line,pad+innerPad,bodyTxtY+i*bodyLineH);});
  var bdY=H-H*.075;var grd2=c.createLinearGradient(pad,0,W-pad,0);grd2.addColorStop(0,'transparent');grd2.addColorStop(.5,'#CC0000');grd2.addColorStop(1,'transparent');c.fillStyle=grd2;c.fillRect(pad,bdY,W-pad*2,H*.003);
  c.fillStyle='rgba(255,255,255,.44)';c.font=Math.round(W*.038)+'px "Space Mono",monospace';c.textAlign='center';c.fillText(handle||'@victortip',W/2,H-H*.025);c.textAlign='left';
}

function drawAsianBorderCanvas(c,W,H){
  var m=W*.033,inn=W*.019,col='rgba(204,0,0,0.55)',sw=W*.004;
  c.strokeStyle=col;c.lineWidth=sw;c.strokeRect(m,m,W-m*2,H-m*2);
  c.save();c.setLineDash([sw*3,sw*4]);c.globalAlpha=.5;c.lineWidth=sw*.6;c.strokeRect(m+inn,m+inn,W-m*2-inn*2,H-m*2-inn*2);c.restore();
  var sq=W*.011;[[m,m],[W-m,m],[m,H-m],[W-m,H-m]].forEach(function(p){c.fillStyle=col;c.globalAlpha=.8;c.fillRect(p[0]-sq/2,p[1]-sq/2,sq,sq);c.globalAlpha=1;});
  var bl=W*.067;c.lineWidth=sw*1.5;[[m,m,1,0],[m,m,0,1],[W-m,m,-1,0],[W-m,m,0,1],[m,H-m,1,0],[m,H-m,0,-1],[W-m,H-m,-1,0],[W-m,H-m,0,-1]].forEach(function(d){c.beginPath();c.moveTo(d[0],d[1]);c.lineTo(d[0]+d[2]*bl,d[1]+d[3]*bl);c.stroke();});
  c.lineWidth=sw;[H*.32,H*.68].forEach(function(by){c.beginPath();c.moveTo(m,by-W*.022);c.lineTo(m-W*.018,by);c.lineTo(m,by+W*.022);c.stroke();c.beginPath();c.moveTo(W-m,by-W*.022);c.lineTo(W-m+W*.018,by);c.lineTo(W-m,by+W*.022);c.stroke();});
  var cx=W/2,da=W*.018;c.fillStyle=col;c.globalAlpha=.7;c.beginPath();c.moveTo(cx,m-da);c.lineTo(cx+da,m);c.lineTo(cx,m+da);c.lineTo(cx-da,m);c.closePath();c.fill();c.beginPath();c.moveTo(cx,H-m-da);c.lineTo(cx+da,H-m);c.lineTo(cx,H-m+da);c.lineTo(cx-da,H-m);c.closePath();c.fill();c.globalAlpha=1;
  function petal(px,py,r){c.fillStyle=col;c.globalAlpha=.28;for(var i=0;i<5;i++){var a=i/5*Math.PI*2;var ex=(px+Math.cos(a)*r*.7+px+Math.cos(a)*r)/2,ey=(py+Math.sin(a)*r*.7+py+Math.sin(a)*r)/2;c.save();c.translate(ex,ey);c.rotate(a+Math.PI/2);c.beginPath();c.ellipse(0,0,r*.22,r*.13,0,0,Math.PI*2);c.fill();c.restore();}c.globalAlpha=1;}
  var pr=W*.033;petal(m+W*.1,m+W*.096,pr);petal(W-m-W*.1,m+W*.096,pr);petal(m+W*.1,H-m-W*.096,pr);petal(W-m-W*.1,H-m-W*.096,pr);
  c.strokeStyle=col;c.lineWidth=sw*.5;c.globalAlpha=.4;c.beginPath();c.moveTo(m+W*.048,m+W*.048);c.quadraticCurveTo(m+W*.14,m+W*.067,m+W*.178,m+W*.148);c.stroke();c.beginPath();c.moveTo(W-m-W*.048,m+W*.048);c.quadraticCurveTo(W-m-W*.14,m+W*.067,W-m-W*.178,m+W*.148);c.stroke();c.globalAlpha=1;
  var lx=W-m-W*.111,ly=m+W*.133,lw=W*.037,lh=W*.048;c.strokeStyle=col;c.lineWidth=sw*.7;c.globalAlpha=.45;try{c.roundRect(lx-lw/2,ly,lw,lh,lw*.3);c.stroke();}catch(e){c.strokeRect(lx-lw/2,ly,lw,lh);}c.beginPath();c.moveTo(lx,ly-sw*2);c.lineTo(lx,ly);c.stroke();c.beginPath();c.moveTo(lx,ly+lh);c.lineTo(lx,ly+lh+sw*4);c.stroke();c.globalAlpha=1;
}

function getWrappedLines(c,text,maxW,fontSize){c.font='400 '+fontSize+'px "Cinzel",serif';var words=text.split(' '),line='',lines=[];for(var i=0;i<words.length;i++){var test=line+words[i]+' ';if(c.measureText(test).width>maxW&&i>0){lines.push(line.trim());line=words[i]+' ';}else{line=test;}}if(line.trim())lines.push(line.trim());return lines;}

// ── GENERATE ─────────────────────────────────────────
document.getElementById('btn-gen').addEventListener('click',genStory);
document.getElementById('btn-regen').addEventListener('click',genStory);
function genStory(){
  var key=getKey();if(!key){setSt('st-gen','Ingresa API Key primero','err');return;}
  var handle=document.getElementById('handle').value||'@victortip',ctxTxt=document.getElementById('ctx').value;
  document.getElementById('btn-gen').disabled=true;setSt('st-gen','Generando...','ld');document.getElementById('sloader').style.display='flex';
  resetFeedbackBar();
  // Resolve actual type used (handles "random" without changing the pill UI)
  var actualType=selType;
  if(actualType==='random'){
    var realTypes=Object.keys(typeMap).filter(function(k){return k!=='random';});
    var recentTypes=(feedbackMem.recentBodies||[]).slice(-6).map(function(b){return b.type;});
    var fresh=realTypes.filter(function(t){return recentTypes.indexOf(t)===-1;});
    var pool=fresh.length>0?fresh:realTypes;
    actualType=pool[Math.floor(Math.random()*pool.length)];
  }
  callAI(key,buildPrompt(actualType,handle,ctxTxt)).then(function(raw){
    var c=JSON.parse(raw.replace(/```json/g,'').replace(/```/g,'').trim());
    currentStory=c;renderStoryDOM(c,handle);
    if(!feedbackMem.recentBodies)feedbackMem.recentBodies=[];
    feedbackMem.recentBodies.push({type:actualType,body:c.body||''});
    if(feedbackMem.recentBodies.length>40)feedbackMem.recentBodies=feedbackMem.recentBodies.slice(-40);
    // Save the actualType in the bank entry so future feedback maps correctly
    bank.unshift({id:Date.now(),type:actualType,content:c,date:new Date().toLocaleDateString('es-MX'),handle:handle,bg:selBg});
    if(bank.length>200)bank=bank.slice(0,200);save();renderBank();
    setSt('st-gen','✓ Lista — dale 👍 o 👎 abajo','ok');
    document.getElementById('btn-regen').style.display='block';document.getElementById('dl-btn-area').style.display='flex';
    // Track the actual type used so feedback works correctly
    window._lastUsedType=actualType;
    if(selBg==='photo'&&photos.length){pidx=Math.floor(Math.random()*photos.length);startBg('photo');}
  }).catch(function(e){setSt('st-gen','Error: '+(e.message||'Intenta'),'err');}).finally(function(){document.getElementById('sloader').style.display='none';document.getElementById('btn-gen').disabled=false;});
}
function buildPrompt(type,handle,ctxTxt){
  // ── RANDOM: si el usuario eligió "random", escoge un tipo real al azar
  // que NO haya sido usado recientemente para garantizar variedad real
  if(type==='random'){
    var realTypes=Object.keys(typeMap).filter(function(k){return k!=='random';});
    var recentTypes=(feedbackMem.recentBodies||[]).slice(-6).map(function(b){return b.type;});
    var fresh=realTypes.filter(function(t){return recentTypes.indexOf(t)===-1;});
    var pool=fresh.length>0?fresh:realTypes;
    type=pool[Math.floor(Math.random()*pool.length)];
  }

  var antiRepeat='REGLA ABSOLUTA DE VARIEDAD: Esta historia debe ser RADICALMENTE DIFERENTE a cualquier historia anterior. Cambia el ángulo, la cultura, el dato, el siglo, la geografía, el personaje y el enfoque emocional. Si la historia anterior habló de Japón, ahora habla de México o Egipto o Rusia. Si habló de muerte, ahora habla de amor o de dinero o de ciencia. NUNCA repitas el mismo símbolo, nombre, fecha, dato, cultura o ángulo. Si percibes que estás por escribir algo similar — DETENTE y elige el ángulo MÁS DIFERENTE POSIBLE.';
  var clientFocus='ENFOQUE: Contenido para personas interesadas en tatuajes como clientes/aficionados. No hables del tatuador ni de su técnica. Habla de lo que le interesa, emociona o educa al cliente.';
  var rules='REGLAS DE ESCRITURA:\n- Texto directo, claro y apasionante\n- Nada de frases mamonas, ni autoexaltación, ni lugares comunes\n- Primera oración: gancho que detenga el scroll\n- Segunda oración: el dato, historia o idea con ESPECIFICIDAD (nombres, fechas, lugares, cifras)\n- Sin mencionar al tatuador\n- Body máximo 160 caracteres\n- Título corto e impactante (máx 5 palabras entre las dos líneas)\n- PROHIBIDO el cliché: "el tatuaje es arte", "el dolor vale la pena", "tu piel cuenta una historia". SIEMPRE datos concretos.';

  // ── APRENDIZAJE POR FEEDBACK ──────────────────────────────────────────────
  var learnBlock='';
  var globalRecent=(feedbackMem.recentBodies||[]).slice(-10).map(function(b){return b.body;});
  if(globalRecent.length){
    learnBlock+='\n\nÚLTIMAS HISTORIAS GENERADAS (PROHIBIDO repetir ángulo, dato, cultura, símbolo, personaje, fecha o enfoque emocional similar):\n';
    globalRecent.forEach(function(b){learnBlock+='- '+b+'\n';});
  }
  var dislikedB=(feedbackMem.dislikedBodies||{})[type]||[];
  if(dislikedB.length){
    learnBlock+='\n\nESTOS ÁNGULOS FUERON MARCADOS COMO REPETITIVOS (PROHIBIDO usarlos, elige algo radicalmente diferente):\n';
    dislikedB.slice(-8).forEach(function(b){learnBlock+='- '+b+'\n';});
  }
  var likedB=(feedbackMem.likedBodies||{})[type]||[];
  if(likedB.length){
    learnBlock+='\n\nESTOS ÁNGULOS GUSTARON MUCHO (inspírate SOLO en el ESTILO y profundidad — el contenido debe ser COMPLETAMENTE diferente):\n';
    likedB.slice(-4).forEach(function(b){learnBlock+='- '+b+'\n';});
  }

  var _tema=window._inkbotTema||'';
  var temaInstruccion='';
  if(_tema){
    temaInstruccion='\n\nTEMA DE LA HISTORIA: '+_tema+'\n'
    +'REGLA TEMÁTICA ABSOLUTA: La historia COMPLETA debe ser sobre '+_tema+' y tatuajes. '
    +'Busca hechos REALES e históricos que conecten directamente '+_tema+' con la cultura del tatuaje — no adaptes datos genéricos. '
    +'Si el tema es Halloween: habla de tatuajes en rituales celtas de Samhain, o calaveras en marineros del s.XVIII. '
    +'Si es Navidad: marineros nórdicos tatuados en invierno, etc. El dato debe ser 100% sobre '+_tema+'.';
  }
  var prompt='Eres un experto en cultura del tatuaje, antropología, historia y comunicación para redes sociales. Creas contenido cautivador para Instagram Stories que sorprende, educa y se siente fresco siempre.\n\n'+antiRepeat+'\n\n'+clientFocus+'\n\nTema base del tatuaje: '+typeMap[type]+temaInstruccion+'\n\n'+rules+learnBlock+'\n\nResponde SOLO con JSON válido sin markdown:\n{"eyebrow":"etiqueta 2-3 palabras MAYÚSCULAS (ej: ¿SABÍAS QUE? / MITO ROTO / DATO CURIOSO / TU TURNO)","title1":"primera línea 2-3 palabras impactante","title2":"segunda línea 2-3 palabras que completen el gancho","accent":"UNA palabra exacta del título para resaltar en rojo","body":"2 oraciones directas y apasionantes con datos concretos. Primera: gancho. Segunda: el dato o idea con nombres/fechas/lugares específicos. Máximo 160 caracteres total.","cta":"llamada a acción corta con emoji, orientada al cliente"}';
  return prompt;
}
function renderStoryDOM(c,handle){
  var t1=c.title1||'',t2=c.title2||'';
  if(c.accent){var esc=c.accent.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');var re=new RegExp('('+esc+')','gi');t1=t1.replace(re,'<span class="acc">$1</span>');t2=t2.replace(re,'<span class="acc">$1</span>');}
  document.getElementById('s-ey').textContent=c.eyebrow||'';
  var te=document.getElementById('s-ttl');te.innerHTML=t1+'<br>'+t2;te.style.color='#fff';
  document.getElementById('s-bod').textContent=c.body||'';document.getElementById('s-bod').style.color='rgba(255,255,255,.88)';
  document.getElementById('s-hdl').textContent=handle;
}

// ── LIKE / DISLIKE FEEDBACK ───────────────────────────
function resetFeedbackBar(){
  var lb=document.getElementById('btn-like'),db=document.getElementById('btn-dislike'),msg=document.getElementById('feedback-msg');
  if(!lb||!db||!msg)return;
  lb.style.background='transparent';lb.style.color='#4ade80';lb.style.borderColor='#2a5c2a';lb.disabled=false;
  db.style.background='transparent';db.style.color='#f87171';db.style.borderColor='#5c2a2a';db.disabled=false;
  msg.style.display='none';msg.textContent='';
}
document.getElementById('btn-like').addEventListener('click',function(){
  if(!currentStory)return;
  var t=window._lastUsedType||selType;
  var body=currentStory.body||'';
  if(!feedbackMem.likedBodies)feedbackMem.likedBodies={};
  if(!feedbackMem.likedBodies[t])feedbackMem.likedBodies[t]=[];
  if(feedbackMem.likedBodies[t].indexOf(body)===-1){
    feedbackMem.likedBodies[t].push(body);
    if(feedbackMem.likedBodies[t].length>12)feedbackMem.likedBodies[t]=feedbackMem.likedBodies[t].slice(-12);
  }
  for(var i=0;i<bank.length;i++){if(bank[i].content&&bank[i].content.body===body){bank[i].likes=(bank[i].likes||0)+1;break;}}
  save();
  this.style.background='#14532d';this.style.color='#4ade80';this.style.borderColor='#4ade80';
  this.disabled=true;document.getElementById('btn-dislike').disabled=true;
  var msg=document.getElementById('feedback-msg');
  msg.style.display='block';msg.style.color='#4ade80';
  msg.textContent='✓ Aprendido — generaré más con este estilo';
  setSt('st-gen','👍 Guardado — próximas serán más así','ok');
});
document.getElementById('btn-dislike').addEventListener('click',function(){
  if(!currentStory)return;
  var t=window._lastUsedType||selType;
  var body=currentStory.body||'';
  if(!feedbackMem.dislikedBodies)feedbackMem.dislikedBodies={};
  if(!feedbackMem.dislikedBodies[t])feedbackMem.dislikedBodies[t]=[];
  if(feedbackMem.dislikedBodies[t].indexOf(body)===-1){
    feedbackMem.dislikedBodies[t].push(body);
    if(feedbackMem.dislikedBodies[t].length>20)feedbackMem.dislikedBodies[t]=feedbackMem.dislikedBodies[t].slice(-20);
  }
  save();
  this.style.background='#450a0a';this.style.color='#f87171';this.style.borderColor='#f87171';
  this.disabled=true;document.getElementById('btn-like').disabled=true;
  var msg=document.getElementById('feedback-msg');
  msg.style.display='block';msg.style.color='#f87171';
  msg.textContent='👎 Registrada — generando una nueva...';
  setSt('st-gen','Generando otra distinta...','ld');
  // Auto-regenerate after short delay
  setTimeout(function(){ genStory(); }, 700);
});
// Note: Chrome records as WebM but we name it .mp4 — Instagram accepts both
// For true MP4 we use the webm file renamed; most platforms accept it

// ── GOOGLE DRIVE EXPORT ───────────────────────────────────────────────────
document.getElementById('btn-drive-png').addEventListener('click',function(){
  if(!currentStory){setSt('st-gen','Genera primero','err');return;}
  var btn=this;
  // Step 1: Export PNG as blob
  var handle=document.getElementById('handle').value||'@victortip';
  var bgSrc=selBg==='photo'&&photos.length?photos[pidx]:null;
  btn.disabled=true;
  setSt('st-gen','Preparando para Drive...','ld');
  loadFonts().then(function(){
    var oc=document.createElement('canvas');oc.width=EW;oc.height=EH;var c2=oc.getContext('2d');
    function go(bgImg){
      renderFrame(c2,currentStory,handle,bgImg,selBg,EW,EH,0);
      oc.toBlob(function(blob){
        uploadToDrive(blob, 'inkbot-'+selType+'-'+Date.now()+'.png', btn);
      },'image/png');
    }
    if(bgSrc){var img=new Image();img.onload=function(){go(img);};img.onerror=function(){go(null);};img.src=bgSrc;}
    else{go(null);}
  });
});

function uploadToDrive(blob, filename, btn){
  // Use Google Drive Picker — needs user to auth with Google
  // Check if we have a stored token
  var token = sessionStorage.getItem('gd_token');
  if(!token){
    // Open Google auth
    setSt('st-gen','Abriendo Google...','ld');
    var clientId = document.getElementById('gd-client-id').value.trim();
    if(!clientId){
      // Show client ID input
      document.getElementById('gd-setup').style.display='block';
      setSt('st-gen','Configura Google Drive primero','err');
      btn.disabled=false;
      return;
    }
    var authUrl='https://accounts.google.com/o/oauth2/v2/auth?client_id='+encodeURIComponent(clientId)+'&redirect_uri='+encodeURIComponent(location.origin+location.pathname)+'&response_type=token&scope='+encodeURIComponent('https://www.googleapis.com/auth/drive.file');
    var popup=window.open(authUrl,'gdrive_auth','width=500,height=600');
    // Listen for token in URL hash when popup redirects back
    var checkInterval=setInterval(function(){
      try{
        if(popup.closed){clearInterval(checkInterval);setSt('st-gen','Auth cancelada','err');btn.disabled=false;return;}
        var hash=popup.location.hash;
        if(hash&&hash.includes('access_token')){
          clearInterval(checkInterval);popup.close();
          var params=new URLSearchParams(hash.slice(1));
          token=params.get('access_token');
          sessionStorage.setItem('gd_token',token);
          doUpload(blob,filename,token,btn);
        }
      }catch(e){}
    },500);
    return;
  }
  doUpload(blob,filename,token,btn);
}

function doUpload(blob,filename,token,btn){
  setSt('st-gen','Subiendo a Drive...','ld');
  var metadata={name:filename,mimeType:'image/png',parents:['root']};
  var form=new FormData();
  form.append('metadata',new Blob([JSON.stringify(metadata)],{type:'application/json'}));
  form.append('file',blob);
  fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart',{
    method:'POST',
    headers:{Authorization:'Bearer '+token},
    body:form
  }).then(function(r){
    if(r.status===401){sessionStorage.removeItem('gd_token');setSt('st-gen','Token expirado, intenta de nuevo','err');btn.disabled=false;return;}
    return r.json();
  }).then(function(d){
    if(d&&d.id){
      setSt('st-gen','✓ Guardado en Google Drive','ok');
      btn.disabled=false;
    }
  }).catch(function(){setSt('st-gen','Error al subir a Drive','err');btn.disabled=false;});
}

// ── VIDEO INDIVIDUAL — MP4 H.264 Baseline, 30fps, 15s exactos ────────────
document.getElementById('btn-dl-mp4').addEventListener('click',function(){
  if(!currentStory){setSt('st-gen','Genera primero','err');return;}
  var btn=this;btn.disabled=true;
  var handle=document.getElementById('handle').value||'@victortip';
  var bgSrc=selBg==='photo'&&photos.length?photos[pidx]:null;
  var VW=1080,VH=1920;
  showProgress(0,'Preparando...');
  function startRec(bgImg){
    loadFonts().then(function(){
      var oc=document.createElement('canvas');oc.width=VW;oc.height=VH;
      var c2=oc.getContext('2d');
      recordAndExport(oc,function(t){
        renderFrame(c2,currentStory,handle,bgImg,selBg,VW,VH,t*4);
      },15000,function(pct,msg){
        showProgress(pct,msg);
      }).then(function(mp4){
        var ext = (mp4.type && mp4.type.includes('webm')) ? '.webm' : '.mp4';
        var a=document.createElement('a');
        a.download='inkbot-'+selType+'-'+Date.now()+ext;
        a.href=URL.createObjectURL(mp4);a.click();
        hideProgress();
        setSt('st-gen','✓ Video 15s listo — compatible con Instagram','ok');
        btn.disabled=false;
      }).catch(function(err){
        hideProgress();
        setSt('st-gen','Error: '+(err.message||'Intenta de nuevo'),'err');
        btn.disabled=false;
      });
    });
  }
  if(bgSrc){var img=new Image();img.onload=function(){startRec(img);};img.onerror=function(){startRec(null);};img.src=bgSrc;}
  else{startRec(null);}
});

function showProgress(pct,label){
  document.getElementById('prog-overlay').style.display='flex';
  document.getElementById('prog-bar').style.width=pct+'%';
  document.getElementById('prog-label').textContent=label||'';
}
function hideProgress(){document.getElementById('prog-overlay').style.display='none';}

// ── BANK ─────────────────────────────────────────────
function renderBank(q,tf){var g=document.getElementById('bgrid');var items=bank;if(q)items=items.filter(function(i){return(i.content.title1+' '+i.content.title2+' '+(i.content.body||'')).toLowerCase().indexOf(q.toLowerCase())>-1;});if(tf)items=items.filter(function(i){return i.type===tf;});
// Sort: liked items first, then by date
items=items.slice().sort(function(a,b){var la=a.likes||0,lb=b.likes||0;return lb-la||0;});
document.getElementById('bcount').textContent=items.length+' historia'+(items.length!==1?'s':'');if(!items.length){g.innerHTML='<div class="bempty">'+(bank.length?'Sin resultados.':'Aún no tienes historias.<br>Genera una y aparecerá aquí.')+'</div>';return;}g.innerHTML='';items.forEach(function(item){var ri=bank.indexOf(item);var likes=item.likes||0;var liked=likes>0;var d=document.createElement('div');d.className='bc';d.innerHTML='<div class="bctype">'+item.type.toUpperCase()+'</div><div class="bctitle">'+(item.content.title1||'')+' '+(item.content.title2||'')+'</div><div class="bcbody">'+((item.content.body||'').slice(0,90))+'...</div><div class="bcdate" style="display:flex;justify-content:space-between;align-items:center"><span>'+item.date+'</span><button class="like-btn" style="background:none;border:none;cursor:pointer;font-size:14px;padding:2px 4px;opacity:'+(liked?'1':'.35')+';transition:all .2s;color:'+(liked?'#ff4466':'#888')+'" title="Like para aprender">'+(liked?'❤️':'🤍')+' '+(likes>0?likes:'')+'</button></div><div class="bcdel">✕</div>';
var likeBtn=d.querySelector('.like-btn');
(function(bankItem,btn){
  btn.addEventListener('click',function(e){
    e.stopPropagation();
    bankItem.likes=(bankItem.likes||0)+1;
    btn.style.opacity='1';
    btn.style.color='#ff4466';
    btn.textContent='❤️ '+bankItem.likes;
    btn.style.transform='scale(1.3)';
    setTimeout(function(){btn.style.transform='scale(1)';},200);
    save();
    // Show feedback
    setSt('bcount','✓ ¡Aprendido!','ok');
    setTimeout(function(){renderBank(document.getElementById('bq').value,document.getElementById('bfilter').value);},800);
  });
})(item,likeBtn);
d.querySelector('.bcdel').addEventListener('click',function(e){e.stopPropagation();bank.splice(ri,1);save();renderBank();});d.addEventListener('click',function(){currentStory=item.content;renderStoryDOM(item.content,item.handle||document.getElementById('handle').value);goTab('story');document.getElementById('dl-btn-area').style.display='flex';});g.appendChild(d);});}
document.getElementById('bq').addEventListener('input',function(){renderBank(this.value,document.getElementById('bfilter').value);});
document.getElementById('bfilter').addEventListener('change',function(){renderBank(document.getElementById('bq').value,this.value);});

// ── WEEK ─────────────────────────────────────────────
function buildWeek(){var g=document.getElementById('wgrid');g.innerHTML='';DAYS.forEach(function(day,di){var row=document.createElement('div');row.className='drow';row.innerHTML='<div class="dcol">'+day.slice(0,3).toUpperCase()+'</div><div class="dslots" id="ds-'+di+'"></div>';g.appendChild(row);var ds=document.getElementById('ds-'+di);TIMES.forEach(function(time,ti){var s=document.createElement('div');s.className='dslot';s.id='sl-'+di+'-'+ti;s.innerHTML='<div class="dst">'+time+'</div><div class="dempty">Sin generar</div>';ds.appendChild(s);});});}

document.getElementById('btn-gen-week').addEventListener('click',function(){
  var key=getKey();if(!key){setSt('st-week','Ingresa API Key primero','err');return;}
  var handle=document.getElementById('handle').value,ctxTxt=document.getElementById('ctx').value;
  var btn=this;btn.disabled=true;weekData=[];
  // Build 21 types — weight by likes from bank
  var typeLikes={};TYPES.forEach(function(t){typeLikes[t]=0;});
  bank.forEach(function(item){if(item.likes&&item.likes>0)typeLikes[item.type]=(typeLikes[item.type]||0)+item.likes;});
  var allTypes=[];TYPES.forEach(function(t){var weight=1+Math.min((typeLikes[t]||0),4);for(var w=0;w<weight;w++)allTypes.push(t);});
  // Shuffle
  for(var i=allTypes.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var tmp=allTypes[i];allTypes[i]=allTypes[j];allTypes[j]=tmp;}
  // Build 21 slots — deduplicate adjacent
  var wt=[],last='';
  while(wt.length<21){var pick=allTypes[wt.length%allTypes.length];if(pick===last){pick=allTypes[(wt.length+1)%allTypes.length]||pick;}wt.push(pick);last=pick;}
  var wb=bgList.filter(function(b){return b!=='photo';});for(var i=wb.length-1;i>0;i--){var j3=Math.floor(Math.random()*(i+1));var tb=wb[i];wb[i]=wb[j3];wb[j3]=tb;}
  var weekBgs=[];for(var i=0;i<21;i++)weekBgs.push(photos.length&&i%3===0?'photo':wb[i%wb.length]);
  var chain=Promise.resolve(),idx=0;
  DAYS.forEach(function(day,di){TIMES.forEach(function(time,ti){(function(di2,ti2,type,bg){chain=chain.then(function(){var slot=document.getElementById('sl-'+di2+'-'+ti2);slot.innerHTML='<div class="dst">'+TIMES[ti2]+'</div><div class="dempty" style="color:var(--gold)">Generando...</div>';setSt('st-week','Día '+(di2+1)+'/7 · '+(ti2+1)+'/3...','ld');return callAI(key,buildPrompt(type,handle,ctxTxt)).then(function(raw){var c=JSON.parse(raw.replace(/```json/g,'').replace(/```/g,'').trim());weekData.push({day:di2,time:ti2,type:type,bg:bg,content:c});slot.className='dslot filled';slot.innerHTML='<div class="dst">'+TIMES[ti2]+'</div><div class="dtype">'+type.toUpperCase()+' · '+bg+'</div><div class="dtxt">'+(c.title1||'')+' '+(c.title2||'')+'</div><div class="dtxt" style="opacity:.55;margin-top:2px">'+((c.body||'').slice(0,55))+'...</div>';}).catch(function(){slot.innerHTML='<div class="dst">'+TIMES[ti2]+'</div><div class="dempty" style="color:var(--red)">Error</div>';}).then(function(){return new Promise(function(r){setTimeout(r,300);});});});})(di,ti,wt[idx%wt.length],weekBgs[idx]);idx++;});});
  chain.then(function(){setSt('st-week','✓ '+weekData.length+' historias listas','ok');document.getElementById('btn-export-week').disabled=false;document.getElementById('btn-export-week-mp4').disabled=false;var dw=document.getElementById('btn-drive-week');dw.disabled=false;dw.style.opacity='1';btn.disabled=false;});
});

document.getElementById('btn-export-week').addEventListener('click',function(){
  if(!weekData.length)return;var btn=this;btn.disabled=true;setSt('st-week','Exportando...','ld');
  var zip=new JSZip();var folder=zip.folder('inkbot-semana');var handle=document.getElementById('handle').value||'@victortip';
  loadFonts().then(function(){
    var chain=Promise.resolve();
    weekData.forEach(function(item,i){chain=chain.then(function(){setSt('st-week','Exportando '+(i+1)+'/'+weekData.length+'...','ld');var bgSrc=item.bg==='photo'&&photos.length?photos[i%photos.length]:null;var oc=document.createElement('canvas');oc.width=EW;oc.height=EH;var c2=oc.getContext('2d');return new Promise(function(res){function go(bgImg){renderFrame(c2,item.content,handle,bgImg,item.bg,EW,EH,0);oc.toBlob(function(blob){var fn=DAYS[item.day]+'-'+TIMES[item.time].replace(':','h').replace(' ','')+'-'+item.type+'.png';folder.file(fn,blob);res();});}if(bgSrc){var img=new Image();img.onload=function(){go(img);};img.onerror=function(){go(null);};img.src=bgSrc;}else{go(null);}});});});
    return chain;
  }).then(function(){return zip.generateAsync({type:'blob'});}).then(function(content){var a=document.createElement('a');a.download='inkbot-semana-'+new Date().toLocaleDateString('es-MX').replace(/\//g,'-')+'.zip';a.href=URL.createObjectURL(content);a.click();setSt('st-week','✓ ZIP descargado','ok');btn.disabled=false;});
});

// ── DRIVE WEEK ZIP ──────────────────────────────────
document.getElementById('btn-drive-week').addEventListener('click',function(){
  if(!weekData.length)return;
  var btn=this;btn.disabled=true;setSt('st-week','Exportando PNGs para Drive...','ld');
  var zip=new JSZip();var folder=zip.folder('inkbot-semana');var handle=document.getElementById('handle').value||'@victortip';
  loadFonts().then(function(){
    var chain=Promise.resolve();
    weekData.forEach(function(item,i){chain=chain.then(function(){setSt('st-week','Preparando '+(i+1)+'/'+weekData.length+'...','ld');var bgSrc=item.bg==='photo'&&photos.length?photos[i%photos.length]:null;var oc=document.createElement('canvas');oc.width=EW;oc.height=EH;var c2=oc.getContext('2d');return new Promise(function(res){function go(bgImg){renderFrame(c2,item.content,handle,bgImg,item.bg,EW,EH,0);oc.toBlob(function(blob){var fn=DAYS[item.day]+'-'+TIMES[item.time].replace(':','h').replace(' ','')+'-'+item.type+'.png';folder.file(fn,blob);res();});}if(bgSrc){var img=new Image();img.onload=function(){go(img);};img.onerror=function(){go(null);};img.src=bgSrc;}else{go(null);}});});});
    return chain;
  }).then(function(){return zip.generateAsync({type:'blob'});}).then(function(blob){
    uploadToDrive(blob,'inkbot-semana-'+new Date().toLocaleDateString('es-MX').replace(/\//g,'-')+'.zip',btn);
    setSt('st-week','Subiendo ZIP a Drive...','ld');
  });
});

// ── CAPTION ─────────────────────────────────────────
document.getElementById('btn-export-week-mp4').addEventListener('click',function(){
  if(!weekData.length)return;
  var btn=this;btn.disabled=true;setSt('st-week','Iniciando exportación...','ld');
  var handle=document.getElementById('handle').value||'@victortip';
  var VW=1080,VH=1920;
  var zip=new JSZip();var folder=zip.folder('inkbot-semana-mp4');
  loadFonts().then(function(){
    var chain=Promise.resolve();
    weekData.forEach(function(item,i){
      chain=chain.then(function(){
        var bgSrc=item.bg==='photo'&&photos.length?photos[i%photos.length]:null;
        return new Promise(function(resolve){
          function startRec(bgImg){
            var oc=document.createElement('canvas');oc.width=VW;oc.height=VH;
            var c2=oc.getContext('2d');
            recordAndExport(oc,function(t){
              renderFrame(c2,item.content,handle,bgImg,item.bg,VW,VH,t*4);
            },15000,function(pct,msg){
              setSt('st-week','Video '+(i+1)+'/'+weekData.length+': '+msg,'ld');
            }).then(function(mp4){
              var fn=DAYS[item.day]+'-'+TIMES[item.time].replace(':','h').replace(' ','')+'-'+item.type+'.mp4';
              folder.file(fn,mp4);resolve();
            }).catch(function(){resolve();});
          }
          if(bgSrc){var img=new Image();img.onload=function(){startRec(img);};img.onerror=function(){startRec(null);};img.src=bgSrc;}
          else{startRec(null);}
        });
      });
    });
    return chain;
  }).then(function(){
    setSt('st-week','Comprimiendo ZIP...','ld');
    return zip.generateAsync({type:'blob',compression:'STORE'});
  }).then(function(content){
    var a=document.createElement('a');
    a.download='inkbot-semana-mp4-'+new Date().toLocaleDateString('es-MX').replace(/\//g,'-')+'.zip';
    a.href=URL.createObjectURL(content);a.click();
    setSt('st-week','✓ ZIP con '+weekData.length+' MP4s descargado','ok');
    btn.disabled=false;
  }).catch(function(err){
    setSt('st-week','Error: '+(err.message||'Intenta'),'err');
    btn.disabled=false;
  });
});

document.getElementById('btn-gen-cap').addEventListener('click',function(){var key=getKey();if(!key){setSt('st-cap','Ingresa API Key','err');return;}var desc=document.getElementById('tat-desc').value.trim();if(!desc){setSt('st-cap','Describe el tatuaje primero','err');return;}var handle=document.getElementById('handle').value,ctxTxt=document.getElementById('ctx').value;var btn=this;btn.disabled=true;setSt('st-cap','Generando...','ld');var prompt='Eres experto en marketing de Instagram para tatuadores.\n\nDescripción: '+desc+'\nArtista: '+handle+'\nEstilo: '+ctxTxt+'\nTono: '+toneMap[selTone]+'\n\nResponde SOLO con JSON válido sin markdown:\n{"caption":"Caption 180-300 palabras. Primeras 2 líneas = gancho. Habla del diseño, significado o proceso. Emojis. CTA al final. Incluye '+handle+'.","hashtags":"30 hashtags por espacios. Mix: 5 populares, 10 medianos, 10 nicho, 5 locales. Español e inglés."}';var prov=document.getElementById('api-provider').value;var call=prov==='gemini'&&capB64?callGemini(key,prompt,capB64,capMime,null):callAI(key,prompt);call.then(function(raw){var c=JSON.parse(raw.replace(/```json/g,'').replace(/```/g,'').trim());document.getElementById('cap-out').textContent=c.caption;document.getElementById('hash-out').textContent=c.hashtags;var cr=document.getElementById('cap-result');cr.style.display='flex';cr.style.flexDirection='column';setSt('st-cap','✓ Listo','ok');}).catch(function(e){setSt('st-cap','Error: '+(e.message||'Intenta'),'err');}).finally(function(){btn.disabled=false;});});
['cap','hash'].forEach(function(id){document.getElementById('copy-'+id).addEventListener('click',function(){var src=id==='cap'?'cap-out':'hash-out';navigator.clipboard.writeText(document.getElementById(src).textContent);var b=this;b.textContent='✓ Copiado';b.classList.add('ok');setTimeout(function(){b.textContent='Copiar';b.classList.remove('ok');},2000);});});

// ── SCHEDULE ─────────────────────────────────────────
function buildSchedule(){var days=['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];var data=[[[7,45,'Antes del trabajo'],[12,62,'Descanso'],[19,95,'ÓPTIMO post-trabajo'],[21,78,'Noche']],[[8,50,'Mañana laboral'],[13,65,'Comer'],[19,90,'ÓPTIMO'],[22,68,'Noche']],[[8,48,'Mañana'],[12,60,'Mediodía'],[18,85,'Noche'],[21,72,'']],[[9,52,'Mañana'],[13,68,'Activo'],[19,88,'ÓPTIMO'],[21,70,'']],[[8,55,'Mañana'],[12,70,'Mediodía'],[17,93,'ÓPTIMO pre-finde'],[20,85,'Noche']],[[10,75,'Mañana'],[14,88,'ÓPTIMO tarde'],[18,96,'PICO sabatino'],[22,78,'']],[[11,82,'Mañana'],[15,90,'ÓPTIMO'],[17,76,'Tarde'],[20,68,'']]];var g=document.getElementById('sgrid');g.innerHTML='';days.forEach(function(day,di){var col=document.createElement('div');col.className='sday';col.innerHTML='<div class="sdname">'+day+'</div>';data[di].forEach(function(row){var hr=row[0],score=row[1],tip=row[2]||'';var cls=score>=85?'best':score>=65?'good':'low',color=score>=85?'var(--red)':score>=65?'var(--gold)':'var(--b2)';var s=document.createElement('div');s.className='sslot '+cls;s.innerHTML=(score>=85?'<div class="sbadge">BEST</div>':'')+'<div class="shr">'+hr+':00</div><div class="sbar"><div class="sbarf" style="width:'+score+'%;background:'+color+'"></div></div><div class="stip">'+tip+'</div>';col.appendChild(s);});g.appendChild(col);});var ins=document.getElementById('insights');ins.innerHTML='<div style="font-family:\'Bebas Neue\',sans-serif;font-size:14px;letter-spacing:3px;margin-bottom:12px;color:var(--mut2)">Insights para tatuadores</div>';[{i:'🔴',t:'Viernes y Sábado son tus mejores días',b:'El engagement sube 40% los viernes después de las 5PM y el sábado de 2-9PM.'},{i:'⏰',t:'Las 7PM entre semana es clave',b:'Tu audiencia sale del trabajo y abre Instagram. 2x más vistas que a las 2PM.'},{i:'📅',t:'Consistencia sobre cantidad',b:'3 historias diarias a la misma hora entrenan el algoritmo de Instagram.'},{i:'🌙',t:'Evita publicar de madrugada',b:'De 12AM a 6AM el alcance inicial es mínimo. Las primeras 2 horas son clave.'}].forEach(function(item){ins.innerHTML+='<div style="display:flex;gap:11px;align-items:flex-start;margin-bottom:4px"><span style="font-size:15px;flex-shrink:0">'+item.i+'</span><div><div style="font-size:12px;font-weight:500;margin-bottom:3px">'+item.t+'</div><div style="font-size:11px;color:var(--mut2);line-height:1.5">'+item.b+'</div></div></div>';});}

// ── API ───────────────────────────────────────────────
function getKey(){return document.getElementById('api-key').value.trim();}
function callAI(key,prompt){var prov=document.getElementById('api-provider').value;if(prov==='gemini')return callGemini(key,prompt,null,null,null);return fetch(anthropicEndpoint(key),{method:'POST',headers:{'Content-Type':'application/json','x-api-key':key,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:700,messages:[{role:'user',content:prompt}]})}).then(function(r){return r.json();}).then(function(d){if(d.error)throw new Error(d.error.message);return d.content[0].text;});}
function callGemini(key,prompt,imgB64,imgMime,alt){var txt=prompt||alt;var parts=[];if(imgB64)parts.push({inlineData:{mimeType:imgMime,data:imgB64}});parts.push({text:txt});return fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key='+key,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contents:[{parts:parts}]})}).then(function(r){return r.json();}).then(function(d){if(d.error)throw new Error(d.error.message);return d.candidates[0].content.parts[0].text;});}
function setSt(id,msg,cls){var e=document.getElementById(id);if(e){e.textContent=msg;e.className='st '+cls;}}


function goTab(name){document.querySelectorAll('.tab').forEach(function(b){b.classList.remove('active');});document.querySelector('[data-tab="'+name+'"]').classList.add('active');document.querySelectorAll('.pane').forEach(function(p){p.classList.remove('active');});document.getElementById('pane-'+name).classList.add('active');}

})();
</script>

<script>
// ── MÓVIL: botón flotante y cierre de sidebar ─────────────────────────────
(function(){
  function isMobile(){return window.innerWidth<=768;}
  function initMobile(){
    var btn=document.getElementById('mob-toggle');
    btn.style.display=isMobile()?'flex':'none';
  }
  initMobile();
  window.addEventListener('resize',initMobile);
  document.querySelectorAll('.tab').forEach(function(t){
    t.addEventListener('click',function(){
      if(isMobile()){
        document.querySelector('.sidebar').classList.remove('mob-open');
        document.getElementById('mob-toggle').textContent='⚙️';
      }
    });
  });
  document.querySelector('.main').addEventListener('click',function(){
    if(isMobile()&&document.querySelector('.sidebar').classList.contains('mob-open')){
      document.querySelector('.sidebar').classList.remove('mob-open');
      document.getElementById('mob-toggle').textContent='⚙️';
    }
  });
  // ── DICCIONARIO VISUAL: toggle móvil
  function initDictMobile(){
    var dBtn=document.getElementById('d-mob-toggle');
    if(dBtn) dBtn.style.display=isMobile()?'flex':'none';
  }
  initDictMobile();
  window.addEventListener('resize',initDictMobile);
  var dMain=document.querySelector('#dict-app .d-main');
  if(dMain){
    dMain.addEventListener('click',function(){
      var ds=document.querySelector('.d-sidebar');
      var dBtn=document.getElementById('d-mob-toggle');
      if(isMobile()&&ds&&ds.classList.contains('d-mob-open')){
        ds.classList.remove('d-mob-open');
        if(dBtn) dBtn.textContent='⚙️';
      }
    });
  }
})();
</script>

</div><!-- /#inkbot-app -->

<script>
(function(){
'use strict';

/* ── Navegación ── */
var splash=document.getElementById('splash');
var inkbotApp=document.getElementById('inkbot-app');
var dictApp=document.getElementById('dict-app');
var btnBack=document.getElementById('btn-back');
var spKey=document.getElementById('sp-key');
var spProv=document.getElementById('sp-provider');
var inkKey=document.getElementById('api-key');
var inkProv=document.getElementById('api-provider');

// Cargar key guardada
(function(){
  try{var s=JSON.parse(localStorage.getItem('inkbot_pro')||'{}');if(s.key){spKey.value=s.key;inkKey.value=s.key;}if(s.prov){spProv.value=s.prov;inkProv.value=s.prov;}}catch(e){}
})();
function syncKey(){inkKey.value=spKey.value;try{var s=JSON.parse(localStorage.getItem('inkbot_pro')||'{}');s.key=spKey.value;s.prov=spProv.value;localStorage.setItem('inkbot_pro',JSON.stringify(s));}catch(e){}}
spKey.addEventListener('input',syncKey);
spProv.addEventListener('change',function(){inkProv.value=this.value;syncKey();});

function requireKey(){if(!spKey.value.trim()){spKey.style.borderColor='#CC0000';spKey.focus();setTimeout(function(){spKey.style.borderColor='';},1500);return false;}return true;}

function goSplash(){splash.classList.remove('hide');inkbotApp.style.display='none';dictApp.classList.remove('show');btnBack.classList.remove('show');document.getElementById('d-mob-toggle').style.display='none';var ds=document.querySelector('.d-sidebar');if(ds)ds.classList.remove('d-mob-open');}
function goInkbot(){if(!requireKey())return;splash.classList.add('hide');inkbotApp.style.display='block';dictApp.classList.remove('show');btnBack.classList.add('show');document.getElementById('d-mob-toggle').style.display='none';}
function goDict(){if(!requireKey())return;splash.classList.add('hide');inkbotApp.style.display='none';dictApp.classList.add('show');btnBack.classList.add('show');startDictBg();buildDictSVG();if(window.innerWidth<=768)document.getElementById('d-mob-toggle').style.display='flex';}

document.getElementById('sp-inkbot').addEventListener('click',goInkbot);
document.getElementById('sp-dict').addEventListener('click',goDict);
btnBack.addEventListener('click',goSplash);

/* ── Tema Inkbot ── */
var inkTema=document.getElementById('inkbot-tema');
var inkTemaLabel=document.getElementById('inkbot-tema-label');
function updateInkTema(){var t=inkTema.value.trim();window._inkbotTema=t;if(t){inkTemaLabel.textContent='🎨 Activo: '+t;inkTemaLabel.style.display='block';}else{inkTemaLabel.style.display='none';}}
inkTema.addEventListener('input',updateInkTema);
document.getElementById('inkbot-tema-sugs').addEventListener('click',function(e){var b=e.target.closest('[data-tema]');if(!b)return;inkTema.value=b.getAttribute('data-tema');updateInkTema();});

/* ── Diccionario: datos ── */
var dictTypeMap={
  random:'símbolo icónico del mundo del tatuaje (elige el más interesante)',
  koi:'la carpa Koi',oni:'el demonio Oni japonés',hannya:'la máscara Hannya',
  dragon:'el dragón',sakura:'la flor de sakura',peonia:'la peonía',tigre:'el tigre',
  calavera:'la calavera',serpiente:'la serpiente',aguila:'el águila',lobo:'el lobo',
  rosa:'la rosa',ancla:'el ancla náutica',reloj:'el reloj sin manecillas',
  luna:'la luna',sol:'el sol',ojo:'el ojo que todo lo ve',phoenix:'el fénix',
  mariposa:'la mariposa',catrina:'La Catrina',quetzal:'el quetzal prehispánico',
  mandala:'el mandala',espada:'la espada',flecha:'la flecha'
};
var dSelType='random',dCurrentCard=null,dPhotoB64=null,dCardPhotoB64=null;
var dFB={liked:{},disliked:{},recent:[]};
(function(){try{var s=JSON.parse(localStorage.getItem('inkbot_dict_fb')||'{}');if(s.liked)dFB.liked=s.liked;if(s.disliked)dFB.disliked=s.disliked;if(s.recent)dFB.recent=s.recent;}catch(e){}})();
function saveDFB(){try{localStorage.setItem('inkbot_dict_fb',JSON.stringify(dFB));}catch(e){}}

/* ── Tema dict ── */
var dTemaInp=document.getElementById('d-tema');
var dTemaActive=document.getElementById('d-tema-active');
function updateDTema(){var t=dTemaInp.value.trim();if(t){dTemaActive.textContent='🎨 Activo: '+t;dTemaActive.style.display='block';}else{dTemaActive.style.display='none';}}
dTemaInp.addEventListener('input',updateDTema);
document.getElementById('d-tema-sugs').addEventListener('click',function(e){var b=e.target.closest('[data-tema]');if(!b)return;dTemaInp.value=b.getAttribute('data-tema');updateDTema();});

/* ── Pills símbolo ── */
document.getElementById('d-type-pills').addEventListener('click',function(e){
  var p=e.target.closest('.d-pill');if(!p)return;
  document.querySelectorAll('#d-type-pills .d-pill').forEach(function(x){x.classList.remove('on');});
  p.classList.add('on');dSelType=p.getAttribute('data-val');
});

/* ── Foto sidebar ── */
document.getElementById('d-photo-input').addEventListener('change',function(){
  var f=this.files[0];if(!f)return;
  var r=new FileReader();r.onload=function(ev){dPhotoB64=ev.target.result;var p=document.getElementById('d-photo-prev');p.src=dPhotoB64;p.style.display='block';document.getElementById('d-photo-txt').textContent='✓ Lista';setCardPhoto(dPhotoB64);};r.readAsDataURL(f);
});

/* ── Foto en la card ── */
document.getElementById('d-card-photo-input').addEventListener('change',function(){
  var f=this.files[0];if(!f)return;
  var r=new FileReader();r.onload=function(ev){dCardPhotoB64=ev.target.result;setCardPhoto(dCardPhotoB64);};r.readAsDataURL(f);
});
function setCardPhoto(b64){var img=document.getElementById('d-card-photo-img');var ph=document.getElementById('d-photo-placeholder');img.src=b64;img.style.display='block';ph.style.display='none';}

/* ── Handle ── */
document.getElementById('d-handle').addEventListener('input',function(){document.getElementById('d-handle-display').textContent=this.value||'@V.SOBRONTT';});

/* ── Fondo animado del diccionario — Pétalos de cerezo japonés ── */
var dBgStarted=false;
function startDictBg(){
  if(dBgStarted)return;dBgStarted=true;
  var cv=document.getElementById('d-cv');var ctx=cv.getContext('2d');cv.width=270;cv.height=480;
  var W=270,H=480;
  var sakuraCols=['rgba(255,182,193,','rgba(255,218,224,','rgba(255,240,245,','rgba(252,200,210,','rgba(230,150,170,'];
  var petals=[];
  for(var i=0;i<55;i++){
    petals.push({x:Math.random()*W,y:Math.random()*H,w:Math.random()*7+3,h:Math.random()*4+2,rot:Math.random()*Math.PI*2,rotV:(Math.random()-.5)*.04,vx:(Math.random()-.5)*.4,vy:Math.random()*.55+.18,swing:Math.random()*Math.PI*2,swingSpeed:Math.random()*.03+.01,swingAmp:Math.random()*1.2+.4,col:sakuraCols[Math.floor(Math.random()*sakuraCols.length)],alpha:Math.random()*.45+.15});
  }
  var branches=[{sx:0,sy:80,cp1x:60,cp1y:30,cp2x:110,cp2y:140,ex:180,ey:60},{sx:270,sy:150,cp1x:200,cp1y:100,cp2x:150,cp2y:230,ex:70,ey:180},{sx:30,sy:450,cp1x:90,cp1y:380,cp2x:160,cp2y:430,ex:240,ey:350}];
  function drawPetal(p){
    ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot);
    ctx.globalAlpha=p.alpha;ctx.fillStyle=p.col+'1)';
    ctx.beginPath();ctx.ellipse(0,0,p.w,p.h,0,0,Math.PI*2);ctx.fill();
    var gl=ctx.createRadialGradient(-p.w*.2,-p.h*.2,0,0,0,p.w);
    gl.addColorStop(0,'rgba(255,255,255,0.35)');gl.addColorStop(1,'rgba(255,255,255,0)');
    ctx.fillStyle=gl;ctx.beginPath();ctx.ellipse(0,0,p.w,p.h,0,0,Math.PI*2);ctx.fill();
    ctx.restore();
  }
  function draw(){
    ctx.clearRect(0,0,W,H);
    var bg=ctx.createLinearGradient(0,0,0,H);
    bg.addColorStop(0,'#0a070f');bg.addColorStop(0.4,'#080510');bg.addColorStop(1,'#04030a');
    ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
    var moon=ctx.createRadialGradient(135,220,0,135,220,160);
    moon.addColorStop(0,'rgba(255,160,180,0.045)');moon.addColorStop(0.5,'rgba(200,120,150,0.02)');moon.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=moon;ctx.fillRect(0,0,W,H);
    ctx.save();ctx.globalAlpha=0.18;ctx.strokeStyle='#3a1a28';ctx.lineWidth=1.2;
    branches.forEach(function(b){ctx.beginPath();ctx.moveTo(b.sx,b.sy);ctx.bezierCurveTo(b.cp1x,b.cp1y,b.cp2x,b.cp2y,b.ex,b.ey);ctx.stroke();});
    ctx.lineWidth=0.5;ctx.globalAlpha=0.1;
    ctx.beginPath();ctx.moveTo(110,60);ctx.lineTo(150,30);ctx.stroke();
    ctx.beginPath();ctx.moveTo(110,60);ctx.lineTo(90,25);ctx.stroke();
    ctx.beginPath();ctx.moveTo(200,110);ctx.lineTo(240,80);ctx.stroke();
    ctx.restore();
    petals.forEach(function(p){
      p.swing+=p.swingSpeed;p.x+=p.vx+Math.sin(p.swing)*p.swingAmp;p.y+=p.vy;p.rot+=p.rotV;
      if(p.y>H+10){p.y=-10;p.x=Math.random()*W;}
      if(p.x<-10)p.x=W+10;if(p.x>W+10)p.x=-10;
      drawPetal(p);
    });
    ctx.save();ctx.globalAlpha=0.04;ctx.strokeStyle='#ffb6c1';ctx.lineWidth=0.4;
    for(var r=0;r<3;r++){ctx.beginPath();ctx.arc(135,240,80+r*35,0,Math.PI*2);ctx.stroke();}
    ctx.restore();
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
}

/* ── SVG decorativo dorado ── */
function buildDictSVG(){
  var el=document.getElementById('d-svg');el.innerHTML='';
  var W=270,H=480,c='rgba(200,134,10,0.55)',c2='rgba(200,134,10,0.2)',m=8,cl=16;
  function mk(tag,a){var e=document.createElementNS('http://www.w3.org/2000/svg',tag);Object.keys(a).forEach(function(k){e.setAttribute(k,a[k]);});el.appendChild(e);return e;}
  mk('rect',{x:m,y:m,width:W-m*2,height:H-m*2,fill:'none',stroke:c,'stroke-width':'1'});
  mk('rect',{x:m+5,y:m+5,width:W-m*2-10,height:H-m*2-10,fill:'none',stroke:c2,'stroke-width':'.5','stroke-dasharray':'4 5'});
  [[m,m,1,0],[m,m,0,1],[W-m,m,-1,0],[W-m,m,0,1],[m,H-m,1,0],[m,H-m,0,-1],[W-m,H-m,-1,0],[W-m,H-m,0,-1]].forEach(function(d){mk('line',{x1:d[0],y1:d[1],x2:d[0]+d[2]*cl,y2:d[1]+d[3]*cl,stroke:c,'stroke-width':'1.8'});});
  [[m,m],[W-m,m],[m,H-m],[W-m,H-m]].forEach(function(p){mk('rect',{x:p[0]-2.5,y:p[1]-2.5,width:5,height:5,fill:c,'fill-opacity':'.8'});});
  var cx=W/2;
  mk('polygon',{points:cx+','+(m-5)+' '+(cx+5)+','+m+' '+cx+','+(m+5)+' '+(cx-5)+','+m,fill:c,'fill-opacity':'.8'});
  mk('polygon',{points:cx+','+(H-m-5)+' '+(cx+5)+','+(H-m)+' '+cx+','+(H-m+5)+' '+(cx-5)+','+(H-m),fill:c,'fill-opacity':'.8'});
}

/* ── Prompt del diccionario ── */
function buildDictPrompt(type){
  if(type==='random'){
    var all=Object.keys(dictTypeMap).filter(function(k){return k!=='random';});
    var rec=(dFB.recent||[]).slice(-5);
    var fresh=all.filter(function(t){return rec.indexOf(t)===-1;});
    var pool=fresh.length?fresh:all;
    type=pool[Math.floor(Math.random()*pool.length)];
  }
  window._dLastType=type;
  var tema=dTemaInp.value.trim();
  var temaBloque='';
  if(tema){
    temaBloque='\n\nTEMA DE LA CARD: '+tema+'\n'
      +'REGLA TEMÁTICA ABSOLUTA: El dato histórico y el significado deben ser 100% sobre '+tema+' y '+dictTypeMap[type]+'. '
      +'Busca hechos REALES que conecten directamente '+tema+' con este símbolo. '
      +'Ejemplos de cómo pensar: si es "Navidad + Koi" → peces en el folklore nórdico de invierno; si es "Halloween + Calavera" → el origen real del sugar skull en Samhain celta. '
      +'NO adaptes datos genéricos del símbolo añadiendo el tema al final. El tema debe ser el NÚCLEO del dato, no un adorno.';
  }
  var anti='';
  var rec=(dFB.recent||[]).slice(-8);
  if(rec.length){anti+='\n\nÚLTIMAS GENERADAS (no repetir ángulo ni dato):\n';rec.forEach(function(b){anti+='- '+b+'\n';});}
  var dis=(dFB.disliked[type]||[]).slice(-5);
  if(dis.length){anti+='\n\nMARCADOS REPETITIVOS (evitar):\n';dis.forEach(function(b){anti+='- '+b+'\n';});}
  var liked=(dFB.liked[type]||[]).slice(-3);
  if(liked.length){anti+='\n\nGUSTARON (solo el estilo, contenido diferente):\n';liked.forEach(function(b){anti+='- '+b+'\n';});}

  return 'Eres experto en simbología del tatuaje, antropología, historia del arte y comunicación para Instagram.\n\n'
    +'SÍMBOLO: '+dictTypeMap[type]+temaBloque+'\n\n'
    +'REGLAS:\n- Dato histórico real, específico y sorprendente que poca gente conozca\n- Profundiza en el SIGNIFICADO simbólico, mitológico, cultural o emocional del símbolo\n- Conecta orígenes, leyendas o significados de distintas culturas o épocas\n- PROHIBIDO mencionar estilos de tatuaje (blackwork, fineline, realismo, irezumi, etc). El significado debe ser universal para poder tatuarse en CUALQUIER estilo\n- Body de 280 a 400 caracteres: rico, narrativo e interesante, no resumido\n- Nombre del símbolo corto e impactante\n'
    +anti
    +'\n\nResponde SOLO con JSON válido sin markdown:\n'
    +'{"eyebrow":"2-3 palabras clasificadoras MAYÚSCULAS",'
    +'"name1":"primera línea del nombre 1-2 palabras",'
    +'"name2":"segunda línea 1-2 palabras (puede vacío)",'
    +'"accent":"UNA palabra del nombre para dorado",'
    +'"nameJp":"nombre japonés si aplica, si no vacío",'
    +'"body":"3 o 4 oraciones con datos reales y fascinantes. Origen + significado simbólico profundo + dato cultural o mitológico sorprendente. NUNCA menciones estilos de tatuaje. Entre 280 y 400 caracteres.",'
    +'"cta":"llamada a acción corta con emoji"}';
}

function renderDictCard(c){
  var n1=c.name1||'',n2=c.name2||'',acc=c.accent||'';
  if(acc){var re=new RegExp('('+acc.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')','gi');n1=n1.replace(re,'<span class="d-acc">$1</span>');n2=n2.replace(re,'<span class="d-acc">$1</span>');}
  document.getElementById('d-eyebrow').textContent=c.eyebrow||'DICCIONARIO VISUAL';
  document.getElementById('d-eyebrow').style.color='#E8720C';
  var ne=document.getElementById('d-name');ne.innerHTML=n1+(n2?'<br>'+n2:'');ne.style.color='#f0ebe3';
  var jp=document.getElementById('d-namejp');if(c.nameJp){jp.textContent=c.nameJp;jp.style.display='block';}else{jp.style.display='none';}
  document.getElementById('d-body').textContent=(c.body||'')+(c.cta?'\n\n'+c.cta:'');
  document.getElementById('d-body').style.color='rgba(240,235,227,.82)';
  if(c.nameJp&&c.nameJp[0])document.getElementById('d-kanji-ph').textContent=c.nameJp[0];
  document.getElementById('d-handle-display').textContent=document.getElementById('d-handle').value||'V.SOBRONTT ❘ INKBOT';
}

function setDSt(msg,cls){var e=document.getElementById('d-st');e.textContent=msg;e.className='d-st-d '+(cls||'');}
function resetDFB(){
  var l=document.getElementById('d-btn-like'),d=document.getElementById('d-btn-dislike'),m=document.getElementById('d-fb-msg');
  l.style.cssText='';d.style.cssText='';l.disabled=false;d.disabled=false;m.style.display='none';
}

function callDictAPI(prompt){
  var key=spKey.value.trim();
  if(!key)return Promise.reject(new Error('Sin API Key'));
  if(spProv.value==='gemini'){
    return fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key='+key,{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({contents:[{parts:[{text:prompt}]}]})
    }).then(function(r){return r.json();}).then(function(d){if(d.error)throw new Error(d.error.message);return d.candidates[0].content.parts[0].text;});
  }
  return fetch(anthropicEndpoint(key),{
    method:'POST',
    headers:{'Content-Type':'application/json','x-api-key':key,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
    body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:600,messages:[{role:'user',content:prompt}]})
  }).then(function(r){return r.json();}).then(function(d){if(d.error)throw new Error(d.error.message);return d.content[0].text;});
}

function genDict(){
  document.getElementById('d-loader').classList.add('show');
  document.getElementById('d-dl-area').classList.remove('show');
  document.getElementById('d-btn-regen').style.display='none';
  setDSt('Generando...','ld');
  callDictAPI(buildDictPrompt(dSelType)).then(function(raw){
    var c=JSON.parse(raw.replace(/```json/g,'').replace(/```/g,'').trim());
    dCurrentCard=c;
    if(!dFB.recent)dFB.recent=[];
    dFB.recent.push(c.body||'');
    if(dFB.recent.length>15)dFB.recent=dFB.recent.slice(-15);
    saveDFB();
    renderDictCard(c);
    document.getElementById('d-loader').classList.remove('show');
    document.getElementById('d-dl-area').classList.add('show');
    document.getElementById('d-btn-regen').style.display='block';
    resetDFB();
    setDSt('✓ Lista','ok');
  }).catch(function(e){
    document.getElementById('d-loader').classList.remove('show');
    setDSt('Error: '+(e.message||'Intenta'),'err');
  });
}

document.getElementById('d-btn-gen').addEventListener('click',genDict);
document.getElementById('d-btn-regen').addEventListener('click',genDict);

/* ── Like / Dislike ── */
document.getElementById('d-btn-like').addEventListener('click',function(){
  if(!dCurrentCard)return;
  var t=window._dLastType||dSelType,b=dCurrentCard.body||'';
  if(!dFB.liked[t])dFB.liked[t]=[];
  if(dFB.liked[t].indexOf(b)===-1){dFB.liked[t].push(b);if(dFB.liked[t].length>12)dFB.liked[t]=dFB.liked[t].slice(-12);}
  saveDFB();
  this.style.background='#14532d';this.style.borderColor='#4ade80';this.disabled=true;
  document.getElementById('d-btn-dislike').disabled=true;
  var m=document.getElementById('d-fb-msg');m.style.display='block';m.style.color='#4ade80';m.textContent='✓ Aprendido';
  setDSt('👍 Guardado','ok');
});
document.getElementById('d-btn-dislike').addEventListener('click',function(){
  if(!dCurrentCard)return;
  var t=window._dLastType||dSelType,b=dCurrentCard.body||'';
  if(!dFB.disliked[t])dFB.disliked[t]=[];
  if(dFB.disliked[t].indexOf(b)===-1){dFB.disliked[t].push(b);if(dFB.disliked[t].length>20)dFB.disliked[t]=dFB.disliked[t].slice(-20);}
  saveDFB();
  this.style.background='#450a0a';this.style.borderColor='#f87171';this.disabled=true;
  document.getElementById('d-btn-like').disabled=true;
  var m=document.getElementById('d-fb-msg');m.style.display='block';m.style.color='#f87171';m.textContent='👎 Registrada — regenerando...';
  setDSt('Generando otra...','ld');
  setTimeout(genDict,800);
});

/* ── Exportar PNG ── */
function exportDictPNG(scale){
  scale=scale||1;var W=270*scale,H=480*scale;
  var out=document.createElement('canvas');out.width=W;out.height=H;
  var ctx=out.getContext('2d');
  /* Fondo sakura japonés (estático, t=0.5 para posición media de animación) */
  var bgGrad=ctx.createLinearGradient(0,0,0,H);
  bgGrad.addColorStop(0,'#0a070f');bgGrad.addColorStop(0.4,'#080510');bgGrad.addColorStop(1,'#04030a');
  ctx.fillStyle=bgGrad;ctx.fillRect(0,0,W,H);
  var moon=ctx.createRadialGradient(W*.5,H*.46,0,W*.5,H*.46,W*.7);
  moon.addColorStop(0,'rgba(255,160,180,0.05)');moon.addColorStop(0.5,'rgba(200,120,150,0.02)');moon.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=moon;ctx.fillRect(0,0,W,H);
  /* Ramas sumi-e */
  ctx.save();ctx.globalAlpha=0.18;ctx.strokeStyle='#3a1a28';ctx.lineWidth=W*.004;
  var brs=[{sx:0,sy:H*.17,cp1x:W*.22,cp1y:H*.06,cp2x:W*.41,cp2y:H*.29,ex:W*.67,ey:H*.13},{sx:W,sy:H*.31,cp1x:W*.74,cp1y:H*.21,cp2x:W*.56,cp2y:H*.48,ex:W*.26,ey:H*.38},{sx:W*.11,sy:H*.94,cp1x:W*.33,cp1y:H*.79,cp2x:W*.59,cp2y:H*.9,ex:W*.89,ey:H*.73}];
  brs.forEach(function(b){ctx.beginPath();ctx.moveTo(b.sx,b.sy);ctx.bezierCurveTo(b.cp1x,b.cp1y,b.cp2x,b.cp2y,b.ex,b.ey);ctx.stroke();});
  ctx.lineWidth=W*.002;ctx.globalAlpha=0.1;
  ctx.beginPath();ctx.moveTo(W*.41,H*.13);ctx.lineTo(W*.56,H*.06);ctx.stroke();
  ctx.beginPath();ctx.moveTo(W*.41,H*.13);ctx.lineTo(W*.33,H*.05);ctx.stroke();
  ctx.restore();
  /* Pétalos estáticos (t=0.5 = punto medio de animación) */
  var sakuraCols=['rgba(255,182,193,','rgba(255,218,224,','rgba(255,240,245,','rgba(252,200,210,','rgba(230,150,170,'];
  var tPng=0.5;
  ctx.save();
  for(var i=0;i<55;i++){
    var seed1=(i*137.508+13)*0.001;var seed2=(i*251.7+37)*0.001;
    var seed3=(i*89.3+7)*0.001;var seed4=(i*173.1+53)*0.001;
    var seed5=(i*311.9+19)*0.001;var seed6=(i*67.4+41)*0.001;
    var bx=(seed1%1)*W;var by=(seed2%1)*H;
    var vx=((seed3%1)-.5)*.4*(W/270);var vy=((seed4%1)*.55+.18)*(H/480);
    var swingAmp=((seed5%1)*1.2+.4)*(W/270);var swingPhase=(i*2.39996)*Math.PI;
    var elapsed=tPng*15;
    var rawX=bx+vx*elapsed*60+Math.sin(swingPhase+elapsed*.01*60)*swingAmp;
    var rawY=by+vy*elapsed*60;
    rawY=((rawY%(H+20))+(H+20))%(H+20)-10;
    rawX=((rawX%(W+20))+(W+20))%(W+20)-10;
    var pw=((seed3%1)*7+3)*(W/270);var ph=((seed4%1)*4+2)*(W/270);
    var rot=(seed5%1)*Math.PI*2+((seed6%1)-.5)*.04*elapsed*60;
    var alpha=(seed1%1)*.45+.15;
    var col=sakuraCols[i%sakuraCols.length];
    ctx.save();ctx.translate(rawX,rawY);ctx.rotate(rot);
    ctx.globalAlpha=alpha;ctx.fillStyle=col+'1)';
    ctx.beginPath();ctx.ellipse(0,0,pw,ph,0,0,Math.PI*2);ctx.fill();
    var gl=ctx.createRadialGradient(-pw*.2,-ph*.2,0,0,0,pw);
    gl.addColorStop(0,'rgba(255,255,255,0.35)');gl.addColorStop(1,'rgba(255,255,255,0)');
    ctx.fillStyle=gl;ctx.beginPath();ctx.ellipse(0,0,pw,ph,0,0,Math.PI*2);ctx.fill();
    ctx.restore();
  }
  ctx.globalAlpha=0.04;ctx.strokeStyle='#ffb6c1';ctx.lineWidth=W*.002;
  for(var r=0;r<3;r++){ctx.beginPath();ctx.arc(W*.5,H*.5,W*.3+r*W*.13,0,Math.PI*2);ctx.stroke();}
  ctx.restore();
  var src=dCardPhotoB64||dPhotoB64;var c=dCurrentCard;if(!c)return;
  function draw(){
    var sepY=H*.38;
    if(src){var img=new Image();img.onload=function(){ctx.drawImage(img,0,0,W,sepY);drawText();};img.src=src;}
    else{ctx.font='bold '+(110*scale)+'px "Noto Serif JP"';ctx.fillStyle='rgba(200,134,10,.07)';ctx.textAlign='center';ctx.fillText(c.nameJp?c.nameJp[0]:'彫',W/2,sepY*.7);drawText();}
  }
  function drawText(){
    var px=12*scale,sy=H*.38+10*scale;
    ctx.font=(8*scale)+'px "Space Mono"';ctx.fillStyle='#E8720C';ctx.textAlign='left';
    ctx.fillText((c.eyebrow||'').toUpperCase(),px+8*scale,sy+14*scale);
    ctx.strokeStyle='rgba(200,134,10,.4)';ctx.lineWidth=.5*scale;ctx.beginPath();ctx.moveTo(px,sy+20*scale);ctx.lineTo(W-px,sy+20*scale);ctx.stroke();
    ctx.font='bold '+(22*scale)+'px "Bebas Neue"';ctx.fillStyle='#f0ebe3';ctx.textAlign='left';
    ctx.fillText(((c.name1||'')+(c.name2?' '+c.name2:'')).toUpperCase(),px,sy+44*scale);
    if(c.nameJp){ctx.font=(10*scale)+'px "Noto Serif JP"';ctx.fillStyle='rgba(200,134,10,.6)';ctx.fillText(c.nameJp,px,sy+60*scale);}
    var bY=sy+68*scale,bH=H*.32;ctx.fillStyle='rgba(200,134,10,.06)';ctx.fillRect(px,bY,W-px*2,bH);
    ctx.strokeStyle='rgba(200,134,10,.5)';ctx.lineWidth=2*scale;ctx.beginPath();ctx.moveTo(px,bY);ctx.lineTo(px,bY+bH);ctx.stroke();
    ctx.font=(10*scale)+'px "DM Sans"';ctx.fillStyle='rgba(240,235,227,.85)';ctx.textAlign='left';
    var words=(c.body||'').split(' '),line='',ly=bY+13*scale,mW=W-px*2-12*scale;
    words.forEach(function(w){var test=line+w+' ';if(ctx.measureText(test).width>mW&&line){ctx.fillText(line.trim(),px+7*scale,ly);ly+=13*scale*1.55;line=w+' ';}else{line=test;}});
    if(line)ctx.fillText(line.trim(),px+7*scale,ly);
    ctx.font=(8*scale)+'px "Space Mono"';ctx.fillStyle='rgba(200,134,10,.7)';
    ctx.textAlign='left';ctx.fillText(document.getElementById('d-handle').value||'V.SOBRONTT',px,H-13*scale);
    ctx.textAlign='right';ctx.fillText('彫物辞典',W-px,H-13*scale);
    var m2=8*scale,cl=15*scale;ctx.strokeStyle='rgba(200,134,10,.5)';ctx.lineWidth=scale;ctx.strokeRect(m2,m2,W-m2*2,H-m2*2);
    [[m2,m2,1,0],[m2,m2,0,1],[W-m2,m2,-1,0],[W-m2,m2,0,1],[m2,H-m2,1,0],[m2,H-m2,0,-1],[W-m2,H-m2,-1,0],[W-m2,H-m2,0,-1]].forEach(function(d){ctx.beginPath();ctx.moveTo(d[0],d[1]);ctx.lineTo(d[0]+d[2]*cl,d[1]+d[3]*cl);ctx.lineWidth=1.8*scale;ctx.stroke();});
    var a=document.createElement('a');a.download='simbolo_'+(c.name1||'card').replace(/\s/g,'_')+(scale>1?'_HD':'')+'.png';a.href=out.toDataURL('image/png');a.click();
  }
  draw();
}
document.getElementById('d-btn-dl-png').addEventListener('click',function(){exportDictPNG(1);});
document.getElementById('d-btn-dl-gold').addEventListener('click',function(){exportDictPNG(4);});

/* ── Exportar VIDEO 15s (igual que Inkbot) ── */
function showDProgress(pct,label){
  document.getElementById('d-prog-overlay').style.display='flex';
  document.getElementById('d-prog-bar').style.width=pct+'%';
  document.getElementById('d-prog-label').textContent=label||'';
}
function hideDProgress(){document.getElementById('d-prog-overlay').style.display='none';}

function renderDictFrame(ctx,c,photoSrc,W,H,t){
  /* ── Fondo sakura japonés animado ── */
  ctx.globalAlpha=1;
  /* Fondo negro japonés con tinte índigo */
  var bgGrad=ctx.createLinearGradient(0,0,0,H);
  bgGrad.addColorStop(0,'#0a070f');bgGrad.addColorStop(0.4,'#080510');bgGrad.addColorStop(1,'#04030a');
  ctx.fillStyle=bgGrad;ctx.fillRect(0,0,W,H);

  /* Aureola rosada central (luna japonesa) */
  var moon=ctx.createRadialGradient(W*.5,H*.46,0,W*.5,H*.46,W*.7);
  moon.addColorStop(0,'rgba(255,160,180,0.05)');moon.addColorStop(0.5,'rgba(200,120,150,0.02)');moon.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=moon;ctx.fillRect(0,0,W,H);

  /* Ramas decorativas sumi-e */
  ctx.save();ctx.globalAlpha=0.18;ctx.strokeStyle='#3a1a28';ctx.lineWidth=W*.004;
  var brs=[{sx:0,sy:H*.17,cp1x:W*.22,cp1y:H*.06,cp2x:W*.41,cp2y:H*.29,ex:W*.67,ey:H*.13},{sx:W,sy:H*.31,cp1x:W*.74,cp1y:H*.21,cp2x:W*.56,cp2y:H*.48,ex:W*.26,ey:H*.38},{sx:W*.11,sy:H*.94,cp1x:W*.33,cp1y:H*.79,cp2x:W*.59,cp2y:H*.9,ex:W*.89,ey:H*.73}];
  brs.forEach(function(b){ctx.beginPath();ctx.moveTo(b.sx,b.sy);ctx.bezierCurveTo(b.cp1x,b.cp1y,b.cp2x,b.cp2y,b.ex,b.ey);ctx.stroke();});
  ctx.lineWidth=W*.002;ctx.globalAlpha=0.1;
  ctx.beginPath();ctx.moveTo(W*.41,H*.13);ctx.lineTo(W*.56,H*.06);ctx.stroke();
  ctx.beginPath();ctx.moveTo(W*.41,H*.13);ctx.lineTo(W*.33,H*.05);ctx.stroke();
  ctx.beginPath();ctx.moveTo(W*.74,H*.23);ctx.lineTo(W*.89,H*.17);ctx.stroke();
  ctx.restore();

  /* Pétalos de cerezo — 55 pétalos, posición determinista según semilla+t */
  var sakuraCols=['rgba(255,182,193,','rgba(255,218,224,','rgba(255,240,245,','rgba(252,200,210,','rgba(230,150,170,'];
  ctx.save();
  for(var i=0;i<55;i++){
    /* semillas pseudoaleatorias fijas por índice */
    var seed1=(i*137.508+13)*0.001;
    var seed2=(i*251.7+37)*0.001;
    var seed3=(i*89.3+7)*0.001;
    var seed4=(i*173.1+53)*0.001;
    var seed5=(i*311.9+19)*0.001;
    var seed6=(i*67.4+41)*0.001;
    /* base de posición */
    var bx=(seed1%1)*W;
    var by=(seed2%1)*H;
    /* velocidades */
    var vx=((seed3%1)-.5)*.4*(W/270);
    var vy=((seed4%1)*.55+.18)*(H/480);
    var swingAmp=((seed5%1)*1.2+.4)*(W/270);
    var swingSpeed=(seed6%1)*.03+.01;
    var swingPhase=(i*2.39996)*Math.PI;
    /* posición actual según t (t va de 0 a 1 en 15s) */
    var elapsed=t*15; /* segundos transcurridos */
    var rawX=bx+vx*elapsed*60+Math.sin(swingPhase+elapsed*swingSpeed*60)*swingAmp;
    var rawY=by+vy*elapsed*60;
    /* wrap vertical */
    rawY=((rawY%(H+20))+(H+20))%(H+20)-10;
    /* wrap horizontal */
    rawX=((rawX%(W+20))+(W+20))%(W+20)-10;
    /* tamaño */
    var pw=((seed3%1)*7+3)*(W/270);
    var ph=((seed4%1)*4+2)*(W/270);
    /* rotación */
    var rotInit=(seed5%1)*Math.PI*2;
    var rotV=((seed6%1)-.5)*.04;
    var rot=rotInit+rotV*elapsed*60;
    /* alpha */
    var alpha=(seed1%1)*.45+.15;
    var col=sakuraCols[i%sakuraCols.length];
    /* dibujar pétalo elipse rotada */
    ctx.save();ctx.translate(rawX,rawY);ctx.rotate(rot);
    ctx.globalAlpha=alpha;ctx.fillStyle=col+'1)';
    ctx.beginPath();ctx.ellipse(0,0,pw,ph,0,0,Math.PI*2);ctx.fill();
    /* brillo nacarado */
    var gl=ctx.createRadialGradient(-pw*.2,-ph*.2,0,0,0,pw);
    gl.addColorStop(0,'rgba(255,255,255,0.35)');gl.addColorStop(1,'rgba(255,255,255,0)');
    ctx.fillStyle=gl;ctx.beginPath();ctx.ellipse(0,0,pw,ph,0,0,Math.PI*2);ctx.fill();
    ctx.restore();
  }
  /* Círculos kamon sutiles */
  ctx.globalAlpha=0.04;ctx.strokeStyle='#ffb6c1';ctx.lineWidth=W*.002;
  for(var r=0;r<3;r++){ctx.beginPath();ctx.arc(W*.5,H*.5,W*.3+r*W*.13,0,Math.PI*2);ctx.stroke();}
  ctx.restore();

  /* borde frame gold */
  var m=W*.033,sw=W*.004;
  ctx.strokeStyle='rgba(200,134,10,0.55)';ctx.lineWidth=sw;
  ctx.strokeRect(m,m,W-m*2,H-m*2);
  var inn=W*.019;
  ctx.save();ctx.setLineDash([sw*3,sw*4]);ctx.globalAlpha=.4;ctx.lineWidth=sw*.6;
  ctx.strokeRect(m+inn,m+inn,W-m*2-inn*2,H-m*2-inn*2);ctx.restore();
  var sq=W*.011;
  [[m,m],[W-m,m],[m,H-m],[W-m,H-m]].forEach(function(p){
    ctx.fillStyle='rgba(200,134,10,0.8)';ctx.globalAlpha=.8;
    ctx.fillRect(p[0]-sq/2,p[1]-sq/2,sq,sq);ctx.globalAlpha=1;
  });
  var bl=W*.067;ctx.lineWidth=sw*1.5;ctx.strokeStyle='rgba(200,134,10,0.55)';
  [[m,m,1,0],[m,m,0,1],[W-m,m,-1,0],[W-m,m,0,1],[m,H-m,1,0],[m,H-m,0,-1],[W-m,H-m,-1,0],[W-m,H-m,0,-1]].forEach(function(d){
    ctx.beginPath();ctx.moveTo(d[0],d[1]);ctx.lineTo(d[0]+d[2]*bl,d[1]+d[3]*bl);ctx.stroke();
  });

  /* zona foto (38% superior) */
  var sepY=H*.38;
  if(photoSrc&&photoSrc.naturalWidth){
    var sc=Math.max(W/photoSrc.naturalWidth,(sepY)/photoSrc.naturalHeight);
    ctx.save();ctx.beginPath();ctx.rect(0,0,W,sepY);ctx.clip();
    ctx.drawImage(photoSrc,(W-photoSrc.naturalWidth*sc)/2,(sepY-photoSrc.naturalHeight*sc)/2,photoSrc.naturalWidth*sc,photoSrc.naturalHeight*sc);
    var ov=ctx.createLinearGradient(0,sepY*.6,0,sepY);ov.addColorStop(0,'transparent');ov.addColorStop(1,'rgba(6,4,2,.9)');
    ctx.fillStyle=ov;ctx.fillRect(0,0,W,sepY);
    ctx.restore();
  } else {
    /* kanji placeholder */
    ctx.font='bold '+(H*.12)+'px "Noto Serif JP",serif';
    ctx.fillStyle='rgba(200,134,10,.07)';ctx.textAlign='center';
    ctx.fillText(c.nameJp?c.nameJp[0]:'彫',W/2,sepY*.72);
  }

  /* línea divisoria */
  ctx.strokeStyle='rgba(200,134,10,.4)';ctx.lineWidth=sw*.5;
  ctx.beginPath();ctx.moveTo(W*.05,sepY);ctx.lineTo(W*.95,sepY);ctx.stroke();

  /* contenido textual */
  var px=W*.045,sy=sepY+H*.022;
  /* eyebrow */
  ctx.font=Math.round(W*.025)+'px "Space Mono",monospace';ctx.fillStyle='#E8720C';ctx.textAlign='left';
  ctx.fillText((c.eyebrow||'DICCIONARIO VISUAL').toUpperCase(),px+W*.02,sy+H*.028);
  /* div */
  var dl=ctx.createLinearGradient(px,0,W-px,0);dl.addColorStop(0,'rgba(200,134,10,.6)');dl.addColorStop(1,'transparent');
  ctx.fillStyle=dl;ctx.fillRect(px,sy+H*.034,W-px*2,H*.003);
  /* nombre símbolo */
  var nameFS=Math.round(W*.09);
  ctx.font='bold '+nameFS+'px "Bebas Neue",sans-serif';
  var nameStr=((c.name1||'')+(c.name2?' '+c.name2:'')).toUpperCase();
  while(nameFS>20&&ctx.measureText(nameStr).width>W-px*2){nameFS=Math.round(nameFS*.93);ctx.font='bold '+nameFS+'px "Bebas Neue",sans-serif';}
  ctx.fillStyle='#f0ebe3';ctx.textAlign='left';
  ctx.fillText(nameStr,px,sy+H*.034+nameFS*.88);
  if(c.nameJp){
    ctx.font=Math.round(W*.028)+'px "Noto Serif JP",serif';
    ctx.fillStyle='rgba(200,134,10,.55)';
    ctx.fillText(c.nameJp,px,sy+H*.034+nameFS*.88+H*.03);
  }
  /* caja body */
  var bodyFS=Math.round(W*.038);
  var boxY=sy+H*.034+nameFS*.88+(c.nameJp?H*.055:H*.025);
  var bodyStr=(c.body||'')+(c.cta?'\n'+c.cta:'');
  ctx.font=Math.round(bodyFS)+'px "DM Sans",sans-serif';
  var words=bodyStr.split(' '),line='',bodyLines=[],mW=W-px*2-W*.05;
  words.forEach(function(w){var test=line+w+' ';if(ctx.measureText(test).width>mW&&line){bodyLines.push(line.trim());line=w+' ';}else{line=test;}});
  if(line.trim())bodyLines.push(line.trim());
  var boxH=W*.03+bodyLines.length*bodyFS*1.55+W*.03;
  ctx.fillStyle='rgba(200,134,10,.06)';ctx.fillRect(px,boxY,W-px*2,boxH);
  ctx.strokeStyle='rgba(200,134,10,.5)';ctx.lineWidth=W*.005;
  ctx.beginPath();ctx.moveTo(px,boxY);ctx.lineTo(px,boxY+boxH);ctx.stroke();
  ctx.lineWidth=sw*.5;
  ctx.beginPath();ctx.moveTo(px,boxY);ctx.lineTo(W-px,boxY);ctx.stroke();
  ctx.fillStyle='rgba(240,235,227,.85)';
  bodyLines.forEach(function(ln,i){ctx.fillText(ln,px+W*.02,boxY+W*.025+bodyFS*.85+i*bodyFS*1.55);});
  /* footer */
  var fY=H-H*.04;
  ctx.strokeStyle='rgba(200,134,10,.3)';ctx.lineWidth=sw*.5;
  ctx.beginPath();ctx.moveTo(px,fY-H*.018);ctx.lineTo(W-px,fY-H*.018);ctx.stroke();
  ctx.font=Math.round(W*.022)+'px "Space Mono",monospace';
  ctx.fillStyle='rgba(200,134,10,.7)';ctx.textAlign='left';
  ctx.fillText(document.getElementById('d-handle').value||'V.SOBRONTT',px,fY);
  ctx.textAlign='right';ctx.fillStyle='rgba(200,134,10,.4)';
  ctx.fillText('彫物辞典',W-px,fY);
  ctx.textAlign='left';
}

document.getElementById('d-btn-dl-mp4').addEventListener('click',function(){
  if(!dCurrentCard){setDSt('Genera primero','err');return;}
  var btn=this;btn.disabled=true;
  var VW=1080,VH=1920;
  var photoEl=null;
  var photoSrc=dCardPhotoB64||dPhotoB64;
  function doRecord(img){
    showDProgress(0,'Preparando...');
    var oc=document.createElement('canvas');oc.width=VW;oc.height=VH;
    var c2=oc.getContext('2d');
    var c=dCurrentCard;
    recordAndExport(oc,function(t){
      renderDictFrame(c2,c,img,VW,VH,t);
    },15000,function(pct,msg){showDProgress(pct,msg);}).then(function(mp4){
      var ext=(mp4.type&&mp4.type.includes('webm'))?'.webm':'.mp4';
      var a=document.createElement('a');
      a.download='dict-'+(c.name1||'simbolo').replace(/\s/g,'_')+'-'+Date.now()+ext;
      a.href=URL.createObjectURL(mp4);a.click();
      hideDProgress();
      setDSt('✓ Video 15s listo — compatible con Instagram','ok');
      btn.disabled=false;
    }).catch(function(err){
      hideDProgress();
      setDSt('Error: '+(err.message||'Intenta de nuevo'),'err');
      btn.disabled=false;
    });
  }
  if(photoSrc){
    var img=new Image();
    img.onload=function(){doRecord(img);};
    img.onerror=function(){doRecord(null);};
    img.src=photoSrc;
  } else {
    doRecord(null);
  }
});

})();
</script>

</body>
</html>
